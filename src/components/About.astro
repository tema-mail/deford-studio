<style is:global>
/* ===== слой 1 из Тильды ===== */
/* =========================================================
   DEFORD — ABOUT / FOUNDER
   ВНЕШНЯЯ СЕТКА СОХРАНЕНА:
   max-width: 1440px
   desktop side padding: 60px
   mobile side padding: 16–28px
   ========================================================= */

#deford-about-v1,
#deford-about-v1 * {
    box-sizing: border-box;
}

#deford-about-v1 {
    --black: #19191b;
    --card: #2e2e30;
    --white: #ffffff;
    --grey: #d7d7d7;
    --muted: #99999d;

    width: 100%;
    overflow: hidden;
    padding-bottom: clamp(48px, 6vw, 88px);

    background: #ffffff;
    font-family: var(--t-headline-font), Inter, Arial, sans-serif;
}

/* =========================================================
   OUTER GRID — НЕ МЕНЯЕМ
   ========================================================= */

#deford-about-v1 .dfa-container {
    width: 100%;
    max-width: 1440px;

    margin: 0 auto;

    padding-left: min(60px, 4.1667vw);
    padding-right: min(60px, 4.1667vw);
}

/* =========================================================
   MAIN CARD
   ========================================================= */

#deford-about-v1 .dfa-card {
    position: relative;

    width: 100%;
    height: min(700px, 48.6111vw);

    overflow: hidden;

    border-radius: min(40px, 2.7778vw);

    background: var(--black);
}

/* =========================================================
   TEXT
   ========================================================= */

#deford-about-v1 .dfa-copy {
    position: relative;
    z-index: 5;

    width: min(625px, 43.4028vw);

    padding:
        min(58px, 4.0278vw)
        0
        0
        min(40px, 2.7778vw);
}

#deford-about-v1 .dfa-title {
    width: min(560px, 38.8889vw);

    margin: 0;

    font-family: Arial, Helvetica, sans-serif;
    font-size: min(54px, 3.75vw);
    font-weight: 700;

    line-height: .95;
    letter-spacing: -0.055em;

    color: var(--white);
}

#deford-about-v1 .dfa-title-mobile {
    display: none;
}

#deford-about-v1 .dfa-text {
    width: min(540px, 37.5vw);

    margin: min(25px, 1.7361vw) 0 0;

    font-size: min(15px, 1.0417vw);
    font-weight: 100;

    line-height: 1.18;

    color: var(--grey);
}

#deford-about-v1 .dfa-text p {
    margin: 0;
}

#deford-about-v1 .dfa-text p + p {
    margin-top: min(17px, 1.1806vw);
}

/* =========================================================
   PHOTO
   ========================================================= */

#deford-about-v1 .dfa-photo-wrap {
    position: absolute;
    z-index: 2;

    top: 0;
    right: 0;

    width: min(710px, 49.3056vw);
    height: 100%;

    overflow: hidden;
}

#deford-about-v1 .dfa-photo {
    position: absolute;

    left: 50%;
    bottom: 0;

    display: block;

    width: 100%;
    height: 100%;

    max-width: none;

    object-fit: contain;
    object-position: center bottom;

    transform: translateX(-50%);
}

/* =========================================================
   CONTACT BADGE
   ========================================================= */

#deford-about-v1 .dfa-contact {
    position: absolute;
    z-index: 8;

    right: min(46px, 3.1944vw);
    top: min(325px, 22.5694vw);

    display: flex;
    align-items: center;

    min-width: min(306px, 21.25vw);
    min-height: min(88px, 6.1111vw);

    padding:
        min(10px, .6944vw)
        min(18px, 1.25vw)
        min(10px, .6944vw)
        min(10px, .6944vw);

    border-radius: min(18px, 1.25vw);

    background: #ffffff;

    box-shadow: 0 8px 30px rgba(0,0,0,.17);
}

#deford-about-v1 .dfa-contact-icons {
    display: flex;
    align-items: center;

    gap: min(6px, .4167vw);

    flex: 0 0 auto;
}

#deford-about-v1 .dfa-contact-icon {
    display: block;

    width: min(50px, 3.4722vw);
    height: min(50px, 3.4722vw);

    flex: 0 0 auto;

    text-decoration: none;
    cursor: pointer;

    transition: transform .2s ease;
}

@media (hover:hover) {
    #deford-about-v1 .dfa-contact-icon:hover {
        transform: translateY(-2px);
    }
}

#deford-about-v1 .dfa-contact-icon svg {
    display: block;

    width: 100%;
    height: 100%;
}

#deford-about-v1 .dfa-contact-copy {
    min-width: 0;

    margin-left: min(14px, .9722vw);
}

#deford-about-v1 .dfa-contact-name {
    display: block;

    font-size: min(19px, 1.3194vw);
    font-weight: 700;

    line-height: 1.05;

    color: #303033;

    white-space: nowrap;
}

#deford-about-v1 .dfa-role {
    display: block;

    margin-top: min(4px, .2778vw);

    font-size: min(12px, .8333vw);
    font-weight: 400;

    line-height: 1.15;

    color: #99999d;
}

/* =========================================================
   STATS
   ========================================================= */

#deford-about-v1 .dfa-stats {
    position: absolute;
    z-index: 10;

    left: min(40px, 2.7778vw);
    right: min(40px, 2.7778vw);
    bottom: min(30px, 2.0833vw);

    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: min(10px, .6944vw);
}

#deford-about-v1 .dfa-stat {
    min-width: 0;
    height: min(104px, 7.2222vw);

    padding:
        min(20px, 1.3889vw)
        min(20px, 1.3889vw);

    border-radius: min(12px, .8333vw);

    background: rgba(46,46,48,.96);
}

#deford-about-v1 .dfa-stat-number {
    margin: 0;

    font-family: Arial, Helvetica, sans-serif;

    font-size: min(34px, 2.3611vw);
    font-weight: 700;

    line-height: .92;
    letter-spacing: -0.05em;

    color: var(--white);
}

#deford-about-v1 .dfa-stat-label {
    margin: min(9px, .625vw) 0 0;

    font-size: min(12px, .8333vw);
    font-weight: 400;

    line-height: 1.05;

    color: #b5b5b8;
}

/* =========================================================
   MOBILE 300–640
   ========================================================= */

@media screen and (max-width: 640px) {

    #deford-about-v1 {
        padding-bottom: 48px;
        overflow: clip;
    }

    #deford-about-v1 .dfa-container {
        padding-left: clamp(16px, 5vw, 28px);
        padding-right: clamp(16px, 5vw, 28px);
    }

    #deford-about-v1 .dfa-card {
        display: flex;
        flex-direction: column;

        width: 100%;
        height: auto;

        border-radius: clamp(24px, 7vw, 36px);
    }

    /* COPY */

    #deford-about-v1 .dfa-copy {
        order: 1;

        width: 100%;

        padding:
            clamp(28px, 7vw, 36px)
            clamp(28px, 6.5vw, 34px)
            0;
    }

    #deford-about-v1 .dfa-title {
        width: 100%;

        font-size: clamp(30px, 8vw, 38px);

        line-height: .96;
        letter-spacing: -0.055em;
    }

    #deford-about-v1 .dfa-title-desktop {
        display: none;
    }

    #deford-about-v1 .dfa-title-mobile {
        display: inline;
    }

    #deford-about-v1 .dfa-text {
        width: 100%;
        max-width: 520px;

        margin-top: 18px;

        font-size: clamp(13px, 3.3vw, 15px);

        line-height: 1.3;
    }

    #deford-about-v1 .dfa-text p + p {
        margin-top: 17px;
    }

    /* PHOTO */

    #deford-about-v1 .dfa-photo-wrap {
        position: relative;

        order: 2;

        top: auto;
        right: auto;

        width: 100%;
        height: clamp(430px, 98vw, 500px);

        margin-top: 10px;

        overflow: hidden;
    }

    #deford-about-v1 .dfa-photo {
        left: 50%;
        bottom: 0;

        width: 112%;
        height: 100%;

        object-fit: contain;
        object-position: center bottom;

        transform: translateX(-50%);
    }

    /* BADGE */

    #deford-about-v1 .dfa-contact {
        top: auto;
        right: clamp(28px, 7vw, 38px);
        bottom: clamp(18px, 4.5vw, 24px);
        left: clamp(28px, 7vw, 38px);

        width: auto;
        min-width: 0;
        min-height: clamp(80px, 18vw, 92px);

        padding:
            10px
            12px;

        border-radius: 18px;
    }

    #deford-about-v1 .dfa-contact-icons {
        gap: 5px;
    }

    #deford-about-v1 .dfa-contact-icon {
        width: clamp(44px, 11vw, 52px);
        height: clamp(44px, 11vw, 52px);
    }

    #deford-about-v1 .dfa-contact-copy {
        margin-left: 12px;
    }

    #deford-about-v1 .dfa-contact-name {
        font-size: clamp(17px, 4.4vw, 21px);
    }

    #deford-about-v1 .dfa-role {
        margin-top: 5px;

        font-size: clamp(10px, 2.8vw, 13px);

        line-height: 1.15;
    }

    /* STATS */

    #deford-about-v1 .dfa-stats {
        position: relative;

        order: 3;

        left: auto;
        right: auto;
        bottom: auto;

        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));

        gap: 8px;

        width: 100%;

        margin: 0;

        padding:
            0
            clamp(28px, 6.5vw, 34px)
            clamp(28px, 6.5vw, 34px);
    }

    #deford-about-v1 .dfa-stat {
        height: auto;
        min-height: clamp(96px, 23vw, 112px);

        padding:
            clamp(15px, 4vw, 18px)
            clamp(15px, 4vw, 18px);

        border-radius: 14px;
    }

    #deford-about-v1 .dfa-stat-number {
        font-size: clamp(30px, 7.5vw, 38px);
    }

    #deford-about-v1 .dfa-stat-label {
        margin-top: 9px;

        font-size: clamp(11px, 3vw, 14px);

        line-height: 1.12;
    }
}

/* =========================================================
   VERY SMALL MOBILE
   ========================================================= */

@media screen and (max-width: 360px) {

    #deford-about-v1 .dfa-copy {
        padding-left: 22px;
        padding-right: 22px;
    }

    #deford-about-v1 .dfa-title {
        font-size: 28px;
    }

    #deford-about-v1 .dfa-text {
