---
/** «8 причин доверить продвижение нам» – по макету Figma (кадр 3, секция
    1440 × 810): слева метка «О нас», заголовок, текст о бесплатной встрече
    и кнопка «Консультация»; справа стопка карточек 684 px – фото на всю
    карточку и стеклянная панель справа со звездой, заголовком и текстом.
    В макете стопка уходит за нижний край секции; здесь все восемь карточек
    идут подряд, а левая колонка закреплена, пока стопка прокручивается.
    Фото 1–3 – из макета, 4–8 сгенерированы в том же стиле. Тексты причин –
    с оригинала (у «Персонального подхода» в макете стоит текст-заглушка). */

const reasons = [
  { img: 'reason-1', title: 'Погружаемся в ваш бизнес', text: 'Перед запуском анализируем нишу, ЦА и конкурентов. Мы не запускаем рекламу вслепую, а выстраиваем систему, которая реально работает под ваш продукт.' },
  { img: 'reason-2', title: 'Запуск за 1 день + поддержка 24/7', text: 'Всегда на связи – даже в выходные. Ежедневные и еженедельные отчёты + регулярная обратная связь в чате.' },
  { img: 'reason-3', title: 'Персональный подход', text: 'Никакой шаблонной работы. Каждому проекту – своя стратегия. Офферы, креативы, воронка подбираются персонально.' },
  { img: 'reason-4', title: 'Команда профессионалов', text: 'Все специалисты в нашей команде с богатым опытом, постоянно проходят обязательное обучение и повышение квалификации.' },
  { img: 'reason-5', title: 'Считаем деньги, а не лайки', text: 'Отчётность по важным метрикам: стоимость клиента, ДРР, окупаемость и другие важные показатели. Работаем в вашем кабинете – у вас полный доступ и контроль.' },
  { img: 'reason-6', title: 'Дизайн группы – бесплатно', text: 'Оформление от дизайнера и настройка разделов. То, за что другие берут 5–15 тыс – мы делаем в подарок.' },
  { img: 'reason-7', title: 'Настройка чат-бота + автоворонка', text: 'Быстрая коммуникация, автоответы, сбор заявок, рассылки и прогрев – поможем всё внедрить.' },
  { img: 'reason-8', title: 'Работаем по договору', text: 'Даже с физлицами. Оплата – на расчётный счёт или СБП. С ИП и ООО – ЭДО. Юридическая чистота на каждом этапе.' },
];
---

<section class="tf-section tfreasons">
  <div class="tf-panel tf-panel--light tfreasons__panel">
    <div class="tfreasons__aside">
      <div class="tfreasons__intro" data-reveal>
        <div class="tf-tag tfreasons__tag">О нас</div>
        <h2 class="tf-h2 tfreasons__title">8 причин доверить продвижение нам</h2>
        <p class="tfreasons__lead">
          Покажем вживую на 30-минутной онлайн-встрече. Откроем реальные рекламные кабинеты,
          покажем цифры и расскажем, что делать в вашем случае.
        </p>
        <p class="tfreasons__lead">
          Это бесплатно и ни к чему не обязывает. Даже если не станете клиентом – уйдёте
          с пониманием, что делать.
        </p>
        <a class="tf-btn tf-btn--red tfreasons__btn" href="#zeropopup">
          <span>Консультация</span>
          <span class="tf-btn__arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8"></path></svg></span>
        </a>
      </div>
    </div>

    <div class="tfreasons__stack">
      {
        reasons.map((r) => (
          <article class="tfreasons__card" data-reveal>
            <img class="tfreasons__photo" src={`/img/tf/fig/${r.img}.webp`} alt="" width="1500" height="750" loading="lazy" decoding="async" />
            <div class="tfreasons__glass">
              <img class="tfreasons__star" src="/img/tf/fig/star.svg" alt="" width="40" height="40" />
              <h3 class="tfreasons__name">{r.title}</h3>
              <p class="tfreasons__text">{r.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .tfreasons__panel {
    --f: calc(100cqw / 1440);
    display: grid;
    grid-template-columns: calc(650 * var(--f)) calc(684 * var(--f));
    justify-content: space-between;
    padding: calc(60 * var(--f)) calc(36 * var(--f)) calc(60 * var(--f)) calc(70 * var(--f));
    overflow: visible;
    border-radius: calc(90 * var(--f));
  }

  /* левая колонка держится на месте, пока справа идут карточки */
  /* в начале секции текст на месте макета (метка – 207 от верха секции),
     дальше держится под шапкой */
  .tfreasons__aside { position: relative; padding-top: calc(147 * var(--f)); }

  .tfreasons__intro { position: sticky; top: calc(130 * var(--f)); }

  .tfreasons .tfreasons__tag {
    padding: calc(8.4 * var(--f)) calc(12 * var(--f));
    border-width: 1.2px;
    font-size: calc(13.2 * var(--f));
    line-height: calc(15.6 * var(--f));
  }

  .tfreasons .tfreasons__title {
    width: calc(370 * var(--f));
    margin-top: calc(18 * var(--f));
    font-size: calc(39.6 * var(--f));
    line-height: 1;
    letter-spacing: calc(-1.2 * var(--f));
  }

  .tfreasons__lead {
    width: calc(434.4 * var(--f));
    margin-top: calc(17 * var(--f));
    color: var(--tf-muted-light);
    font-size: calc(16.8 * var(--f));
    line-height: calc(21 * var(--f));
    font-weight: 500;
  }

  .tfreasons__lead + .tfreasons__lead { margin-top: calc(21 * var(--f)); }

  .tfreasons .tfreasons__btn {
    gap: calc(16.16 * var(--f));
    min-height: calc(65.32 * var(--f));
    margin-top: calc(35 * var(--f));
    padding: calc(6 * var(--f)) calc(6 * var(--f)) calc(6 * var(--f)) calc(30 * var(--f));
    font-size: calc(17.775 * var(--f));
    line-height: calc(19.39 * var(--f));
  }

  .tfreasons .tfreasons__btn .tf-btn__arrow { width: calc(53.324 * var(--f)); height: calc(53.324 * var(--f)); }

  .tfreasons__stack { display: flex; flex-direction: column; gap: calc(15 * var(--f)); }

  .tfreasons__card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: calc(270 * var(--f));
    padding: calc(36 * var(--f)) calc(30 * var(--f));
    overflow: hidden;
    border-radius: calc(36 * var(--f));
    background: #0b0b0b;
  }

  .tfreasons__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .tfreasons__glass {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: calc(342 * var(--f));
    padding: calc(30 * var(--f));
    border-radius: calc(24 * var(--f));
    background: rgba(32, 32, 32, 0.3);
    -webkit-backdrop-filter: blur(9px);
    backdrop-filter: blur(9px);
  }

  .tfreasons__star { width: calc(39.6 * var(--f)); height: calc(39.6 * var(--f)); }

  .tfreasons__name {
    margin-top: calc(14.4 * var(--f));
    color: #fff;
    font-size: calc(26.4 * var(--f));
    line-height: calc(26.4 * var(--f));
    font-weight: 600;
    letter-spacing: calc(-0.6 * var(--f));
    text-wrap: balance;
  }

  .tfreasons__text {
    margin-top: calc(9.6 * var(--f));
    color: var(--tf-muted-light);
    font-size: calc(13.2 * var(--f));
    line-height: calc(15.6 * var(--f));
    font-weight: 500;
  }

  /* планшет и телефон: текст сверху, карточки – фото и панель под ним */
  @media (max-width: 979px) {
    .tfreasons__panel { display: block; padding: 44px 18px 18px; border-radius: 36px; }
    .tfreasons__aside { padding-top: 0; }
    .tfreasons__intro { position: static; }
    .tfreasons .tfreasons__tag { padding: 7px 11px; font-size: 12px; line-height: 14px; }
    .tfreasons .tfreasons__title { width: auto; max-width: 460px; margin-top: 14px; font-size: clamp(26px, 6vw, 36px); letter-spacing: -0.03em; }
    .tfreasons__lead { width: auto; max-width: 520px; margin-top: 12px; font-size: 15px; line-height: 20px; }
    .tfreasons__lead + .tfreasons__lead { margin-top: 12px; }
    .tfreasons .tfreasons__btn { min-height: 56px; margin-top: 22px; padding: 5px 5px 5px 24px; font-size: 15px; line-height: 17px; width: auto; }
    .tfreasons .tfreasons__btn .tf-btn__arrow { position: static; transform: none; width: 46px; height: 46px; }

    .tfreasons__stack { gap: 12px; margin-top: 28px; }
    .tfreasons__card { flex-direction: column; align-items: stretch; justify-content: flex-end; min-height: 0; padding: 0; border-radius: 26px; }
    .tfreasons__photo { position: relative; height: auto; aspect-ratio: 2 / 1; }
    .tfreasons__glass { width: auto; margin: -36px 12px 12px; padding: 18px; border-radius: 18px; background: rgba(32, 32, 32, 0.72); }
    .tfreasons__star { width: 34px; height: 34px; }
    .tfreasons__name { margin-top: 12px; font-size: 21px; line-height: 23px; letter-spacing: -0.4px; }
    .tfreasons__text { margin-top: 8px; font-size: 13.5px; line-height: 17px; }
  }

  @media (min-width: 641px) and (max-width: 979px) {
    .tfreasons__stack { display: grid; grid-template-columns: 1fr 1fr; }
  }
</style>
