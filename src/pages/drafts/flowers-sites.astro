---
/* Черновик блока «Сайты» для лендинга /flowers. В лендинг не вставлен:
   страница нужна, чтобы посмотреть блок отдельно. Попап заявки подключён,
   чтобы кнопка «Обсудить сайт» работала как в лендинге. */
import Flowers from '../../layouts/Flowers.astro';
import Sites from '../../components/flowers/Sites.astro';
import ShopCases from '../../components/flowers/ShopCases.astro';
import SitesCta from '../../components/flowers/SitesCta.astro';
import Popup from '../../components/flowers/Popup.astro';
import DocPopups from '../../components/flowers/DocPopups.astro';
---

<Flowers title="Черновик: блок «Интернет-магазин»">
  <div class="draft-note">
    Блоки «Интернет-магазин», «Интернет-магазины, которые мы создали» и «Аудит сайта» — уже в лендинге после «Этапов работы».
  </div>

  <Sites />
  <ShopCases />
  <SitesCta />

  <div style="height: 60px;"></div>

  <Popup />
  <DocPopups />
</Flowers>

<style>
  .draft-note {
    max-width: 1080px;
    margin: 16px auto;
    padding: 10px 16px;
    border: 1px dashed #b5b5b5;
    border-radius: 12px;
    color: #6b6b6b;
    font: 500 13px/1.4 Arial, sans-serif;
    text-align: center;
  }

  @media (max-width: 1112px) {
    .draft-note {
      margin: 12px 16px;
    }
  }
</style>
