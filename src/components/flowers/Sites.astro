---
/** «Интернет-магазин цветов» — новый блок для лендинга /flowers.
    Черновик: в лендинг пока не вставлен, смотрится на /drafts/flowers-sites.

    Стилистика — с соседних секций: графит #202020, лайм #cefe46,
    серая подложка #dbdbdb, пилюли-теги, заголовки 33/33, кнопка-пилюля
    с лаймовым кругом, плашки «новая заявка» как на первом экране.
    Картинки — из уже загруженных для лендинга.

    Цифры кейса — примерные, заданы Артёмом; перед публикацией
    в лендинге заменить на цифры реального кейса. */

const features = [
  {
    icon: 'catalog',
    title: 'Каталог как в магазине',
    text: 'Букеты с фото, ценой и составом, фильтры по поводу и бюджету.',
  },
  {
    icon: 'cart',
    title: 'Заказ за пару минут',
    text: 'Корзина, адрес и время доставки, открытка, онлайн-оплата.',
  },
  {
    icon: 'chat',
    title: 'Заявки в одно окно',
    text: 'Сайт, ВКонтакте и мессенджеры попадают в CRM и в Telegram.',
  },
  {
    icon: 'pay',
    title: 'Оплата по закону',
    text: 'Карта и СБП, онлайн-касса с чеками по 54-ФЗ, оферта и согласие на обработку данных.',
  },
];

const metrics = [
  { value: '500', label: 'заказов с сайта в месяц' },
  { value: '7%', label: 'конверсия в заказ' },
  { value: '1 200 ₽', label: 'средний чек' },
];
---

<section class="fmsites" data-fmsites>
  <div class="fmsites__viewport">
    <header class="fmsites__header">
      <div class="fmsites__tag">Сайты</div>
      <h2 class="fmsites__title">
        Интернет-магазин цветов, <br />который продаёт каждый день
      </h2>
      <p class="fmsites__lead">
        Делаем интернет-магазины для цветочных: каталог с ценами, корзина,
        онлайн-оплата и доставка, а заказы сразу приходят вам в мессенджер.
      </p>
    </header>

    <div class="fmsites__grid">
      <!-- ГЛАВНАЯ КАРТОЧКА -->
      <article class="fmsites__card fmsites__hero">
        <div class="fmsites__hero-copy">
          <div class="fmsites__chip">Под ключ</div>
          <h3 class="fmsites__hero-title">Сайт, который работает как продавец</h3>
          <p class="fmsites__hero-text">
            Показывает букеты, отвечает на частые вопросы и доводит до оплаты,
            пока вы собираете заказы.
          </p>
          <a class="fmsites__button" href="#popup:myform" role="button" aria-haspopup="dialog">
            <span>Обсудить сайт</span>
            <span class="fmsites__button-arrow" aria-hidden="true">
              <svg viewBox="0 0 44 44">
                <circle cx="22" cy="22" r="22" fill="#202020"></circle>
                <path
                  d="M16 28L28 16M20 16H28V24"
                  fill="none"
                  stroke="#CEFE46"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
        </div>

        <div class="fmsites__screen">
          <img
            class="fmsites__screen-img"
            src="/img/flowers/37313761-2.png"
            alt="Сайт цветочного магазина на ноутбуке и телефоне"
            decoding="async"
          />

          <div class="fmsites__note fmsites__note--a">
            <span class="fmsites__note-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M5 8h14l-1.5 9h-11z M9 8V6a3 3 0 0 1 6 0v2" /></svg>
            </span>
            <span class="fmsites__note-copy">
              <span class="fmsites__note-label">Новый заказ</span>
              <span class="fmsites__note-title">с сайта</span>
            </span>
          </div>

          <div class="fmsites__note fmsites__note--b">
            <span class="fmsites__note-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            </span>
            <span class="fmsites__note-copy">
              <span class="fmsites__note-label">Оплата</span>
              <span class="fmsites__note-title">прошла</span>
            </span>
          </div>

          <div class="fmsites__note fmsites__note--c">
            <span class="fmsites__note-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 7v5l3 2 M12 3a9 9 0 1 0 0 18a9 9 0 0 0 0-18z" /></svg>
            </span>
            <span class="fmsites__note-copy">
              <span class="fmsites__note-label">Доставка</span>
              <span class="fmsites__note-title">к 18:00</span>
            </span>
          </div>
        </div>
      </article>

      <!-- АНАЛИТИКА -->
      <article class="fmsites__card fmsites__stats">
        <img
          class="fmsites__stats-img"
          src="/img/flowers/37393031-analytics_1x1.png"
          alt=""
          decoding="async"
        />
        <!-- на телефоне вместо картинки — иконка, как у плашек ниже -->
        <span class="fmsites__icon fmsites__stats-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 19h16 M7 15.5l3.5-4l3 2.5L19 7.5 M15 7.5h4v4" /></svg>
        </span>
        <div class="fmsites__stats-copy">
          <h3 class="fmsites__card-title">Видно каждый заказ и рубль</h3>
          <p class="fmsites__card-text">
            Метрика, цели и отчёты с первого дня: сколько заказов и выручки
            принёс магазин и из какого канала.
          </p>
        </div>
      </article>

      <!-- ЧТО ВНУТРИ -->
      {
        features.map((f) => (
          <article class="fmsites__card fmsites__feature">
            <span class="fmsites__icon" aria-hidden="true">
              {f.icon === 'catalog' && (
                <svg viewBox="0 0 24 24">
                  <rect x="4" y="4" width="7" height="7" rx="1.5" />
                  <rect x="13" y="4" width="7" height="7" rx="1.5" />
                  <rect x="4" y="13" width="7" height="7" rx="1.5" />
                  <rect x="13" y="13" width="7" height="7" rx="1.5" />
                </svg>
              )}
              {f.icon === 'cart' && (
                <svg viewBox="0 0 24 24">
                  <path d="M3 4h2.5l2.2 10.5h10.6L20.5 7H7" />
                  <circle cx="9.5" cy="19" r="1.4" />
                  <circle cx="17" cy="19" r="1.4" />
                </svg>
              )}
              {f.icon === 'chat' && (
                <svg viewBox="0 0 24 24">
                  <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H10l-4 4v-4h0.5A2.5 2.5 0 0 1 4 13.5z" />
                  <path d="M8.5 9h7 M8.5 12h4.5" />
                </svg>
              )}
              {f.icon === 'pay' && (
                <svg viewBox="0 0 24 24">
                  <rect x="3" y="5.5" width="18" height="13" rx="2.5" />
                  <path d="M3 9.5h18 M7 14.5h3" />
                  <path d="M14.5 14.5l1.5 1.5l3-3" />
                </svg>
              )}
            </span>
            <h3 class="fmsites__card-title">{f.title}</h3>
            <p class="fmsites__card-text">{f.text}</p>
          </article>
        ))
      }

      <!-- КЕЙС -->
      <article class="fmsites__card fmsites__case">
        <div class="fmsites__case-copy">
          <div class="fmsites__chip">Кейс</div>
          <h3 class="fmsites__hero-title">Интернет-магазин для цветочной мастерской</h3>
          <p class="fmsites__hero-text">
            Запустили каталог, корзину и онлайн-оплату, подключили заказы
            к CRM и Telegram. Цифры — из Метрики и CRM за месяц.
          </p>
        </div>

        <div class="fmsites__case-side">
          <div class="fmsites__metrics">
            {
              metrics.map((m) => (
                <div class="fmsites__metric">
                  <div class="fmsites__metric-value">{m.value}</div>
                  <div class="fmsites__metric-label">{m.label}</div>
                </div>
              ))
            }
          </div>
          <a class="fmsites__ghost" href="#cases">Смотреть кейс</a>
        </div>
      </article>
    </div>
  </div>
</section>

<style is:global>
  .fmsites {
    --fs-dark: #202020;
    --fs-green: #cefe46;
    --fs-bg: #dbdbdb;
    position: relative;
    width: 100%;
    padding: 15px 0 0;
    background: #fff;
    color: var(--fs-dark);
    font-family: 'Inter Tight', Inter, Arial, sans-serif;
    /* единица макета: 1/1200 ширины секции, как у соседних секций */
    container-type: inline-size;
  }

  .fmsites,
  .fmsites * { box-sizing: border-box; }

  .fmsites__viewport {
    --u: calc(100cqw / 1200);
    width: 100%;
    padding: calc(88 * var(--u)) 0;
    overflow: hidden;
    background: var(--fs-bg);
    border-radius: clamp(42px, 6.25vw, 120px);
  }

  /* ШАПКА */
  .fmsites__header { width: calc(700 * var(--u)); margin: 0 auto; text-align: center; }

  .fmsites__tag {
    width: max-content;
    margin: 0 auto calc(27 * var(--u));
    padding: calc(7 * var(--u)) calc(10 * var(--u));
    background: #fff;
    border: 1px solid #ededee;
    border-radius: 100px;
    font-size: calc(11 * var(--u));
    line-height: calc(13 * var(--u));
  }

  .fmsites__title {
    margin: 0;
    font-size: calc(33 * var(--u));
    line-height: calc(33 * var(--u));
    font-weight: 600;
    letter-spacing: -1px;
  }

  .fmsites__lead {
    width: calc(520 * var(--u));
    margin: calc(18 * var(--u)) auto 0;
    color: rgba(32, 32, 32, 0.6);
    font-size: calc(13 * var(--u));
    line-height: calc(17 * var(--u));
    font-weight: 500;
  }

  /* СЕТКА: ширина кейсов (1080 из 1200), 12 колонок */
  .fmsites__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: calc(20 * var(--u));
    width: calc(1080 * var(--u));
    margin: calc(48 * var(--u)) auto 0;
  }

  .fmsites__card { position: relative; overflow: hidden; border-radius: calc(30 * var(--u)); }

  /* ГЛАВНАЯ КАРТОЧКА */
  .fmsites__hero {
    grid-column: span 8;
    display: flex;
    gap: calc(28 * var(--u));
    min-height: calc(430 * var(--u));
    padding: calc(36 * var(--u));
    background:
      radial-gradient(circle at 92% 108%, rgba(206, 254, 70, 0.22), transparent 42%),
      var(--fs-dark);
    color: #fff;
  }

  .fmsites__hero-copy {
    display: flex;
    flex: 0 0 calc(250 * var(--u));
    flex-direction: column;
    align-items: flex-start;
  }

  .fmsites__chip {
    padding: calc(6 * var(--u)) calc(10 * var(--u));
    border-radius: 100px;
    background: var(--fs-green);
    color: var(--fs-dark);
    font-size: calc(11 * var(--u));
    line-height: calc(13 * var(--u));
    font-weight: 600;
  }

  .fmsites__hero-title {
    margin: calc(18 * var(--u)) 0 0;
    font-size: calc(26 * var(--u));
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.8px;
  }

  .fmsites__hero-text {
    margin: calc(12 * var(--u)) 0 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: calc(13 * var(--u));
    line-height: calc(17 * var(--u));
    font-weight: 500;
  }

  .fmsites__button {
    display: inline-flex;
    align-items: center;
    gap: calc(13 * var(--u));
    min-height: calc(55 * var(--u));
    margin-top: auto;
    padding: calc(5 * var(--u)) calc(5 * var(--u)) calc(5 * var(--u)) calc(25 * var(--u));
    border-radius: 100px;
    background: var(--fs-green);
    color: var(--fs-dark);
    font-size: calc(14.8 * var(--u));
    line-height: calc(16 * var(--u));
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.25s ease;
  }

  .fmsites__button:hover { transform: translateY(-2px); }

  .fmsites__button-arrow { width: calc(44 * var(--u)); height: calc(44 * var(--u)); flex: 0 0 auto; }

  .fmsites__button-arrow svg { display: block; width: 100%; height: 100%; }

  /* «Экран» с сайтом и плашками сценария заказа */
  .fmsites__screen {
    position: relative;
    flex: 1 1 auto;
    border-radius: calc(20 * var(--u));
    background: #d9d9d9;
  }

  .fmsites__screen-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
    object-position: 40% 50%;
  }

  .fmsites__note {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: calc(8 * var(--u));
    padding: calc(12 * var(--u)) calc(14 * var(--u)) calc(12 * var(--u)) calc(10 * var(--u));
    border-radius: calc(10 * var(--u));
    background: rgba(255, 255, 255, 0.86);
    color: var(--fs-dark);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    animation: fmsites-float 6s ease-in-out infinite;
  }

  .fmsites__note--a { top: calc(26 * var(--u)); left: calc(-18 * var(--u)); }
  .fmsites__note--b { top: calc(150 * var(--u)); right: calc(-14 * var(--u)); background: rgba(32, 32, 32, 0.88); color: #fff; animation-delay: -2s; }
  .fmsites__note--c { bottom: calc(26 * var(--u)); left: calc(40 * var(--u)); animation-delay: -4s; }

  .fmsites__note-icon {
    display: grid;
    place-items: center;
    width: calc(32 * var(--u));
    height: calc(32 * var(--u));
    border-radius: calc(6 * var(--u));
    background: var(--fs-green);
  }

  .fmsites__note-icon svg {
    width: 62%;
    height: 62%;
    fill: none;
    stroke: var(--fs-dark);
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fmsites__note-copy { display: flex; flex-direction: column; }

  .fmsites__note-label {
    font-size: calc(10 * var(--u));
    line-height: calc(13 * var(--u));
    opacity: 0.7;
    white-space: nowrap;
  }

  .fmsites__note-title {
    font-size: calc(14 * var(--u));
    line-height: calc(15 * var(--u));
    font-weight: 700;
    white-space: nowrap;
  }

  @keyframes fmsites-float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 calc(-6 * var(--u)); }
  }

  /* АНАЛИТИКА */
  .fmsites__stats {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #ffffff 0%, #f6f6f6 100%);
  }

  .fmsites__stats-img {
    display: block;
    flex: 1 1 auto;
    width: 100%;
    min-height: 0;
    object-fit: cover;
  }

  .fmsites__stats-copy { padding: calc(4 * var(--u)) calc(26 * var(--u)) calc(28 * var(--u)); }

  .fmsites__stats .fmsites__stats-icon { display: none; }

  .fmsites__card-title {
    margin: 0;
    font-size: calc(19 * var(--u));
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.5px;
  }

  .fmsites__card-text {
    margin: calc(8 * var(--u)) 0 0;
    color: rgba(0, 0, 0, 0.5);
    font-size: calc(12 * var(--u));
    line-height: calc(16 * var(--u));
    font-weight: 500;
  }

  /* ЧТО ВНУТРИ */
  .fmsites__feature {
    grid-column: span 3;
    padding: calc(22 * var(--u));
    background: linear-gradient(180deg, #ffffff 0%, #f6f6f6 100%);
    border-radius: calc(27 * var(--u));
  }

  .fmsites__icon {
    display: grid;
    place-items: center;
    width: calc(44 * var(--u));
    height: calc(44 * var(--u));
    margin-bottom: calc(34 * var(--u));
    border-radius: 50%;
    background: var(--fs-green);
  }

  .fmsites__icon svg {
    width: 50%;
    height: 50%;
    fill: none;
    stroke: var(--fs-dark);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* КЕЙС */
  .fmsites__case {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(40 * var(--u));
    padding: calc(36 * var(--u));
    background:
      radial-gradient(circle at 6% -30%, rgba(206, 254, 70, 0.18), transparent 40%),
      var(--fs-dark);
    color: #fff;
  }

  .fmsites__case-copy {
    display: flex;
    flex: 0 1 calc(470 * var(--u));
    flex-direction: column;
    align-items: flex-start;
  }

  .fmsites__case-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: calc(22 * var(--u));
  }

  .fmsites__metrics { display: flex; gap: calc(12 * var(--u)); }

  .fmsites__metric {
    width: calc(150 * var(--u));
    padding: calc(16 * var(--u)) calc(18 * var(--u));
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: calc(18 * var(--u));
    background: rgba(255, 255, 255, 0.04);
  }

  .fmsites__metric-value {
    white-space: nowrap;
    color: var(--fs-green);
    font-size: calc(34 * var(--u));
    line-height: 1;
    font-weight: 600;
    letter-spacing: -1px;
  }

  .fmsites__metric-label {
    margin-top: calc(8 * var(--u));
    color: rgba(255, 255, 255, 0.55);
    font-size: calc(11 * var(--u));
    line-height: calc(13 * var(--u));
    font-weight: 500;
  }

  .fmsites__ghost {
    display: inline-flex;
    align-items: center;
    height: calc(48 * var(--u));
    padding: 0 calc(24 * var(--u));
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 100px;
    color: #fff;
    font-size: calc(14 * var(--u));
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .fmsites__ghost:hover { background: #fff; color: var(--fs-dark); }

  /* ПОЯВЛЕНИЕ при прокрутке — только если скрипт включил анимацию */
  .fmsites.is-anim .fmsites__card { opacity: 0; }

  .fmsites.is-anim.is-ready .fmsites__card { animation: fmsites-in 0.7s cubic-bezier(0.16, 0.82, 0.21, 1) both; }

  .fmsites.is-anim.is-ready .fmsites__card:nth-child(2) { animation-delay: 0.08s; }
  .fmsites.is-anim.is-ready .fmsites__card:nth-child(3) { animation-delay: 0.16s; }
  .fmsites.is-anim.is-ready .fmsites__card:nth-child(4) { animation-delay: 0.22s; }
  .fmsites.is-anim.is-ready .fmsites__card:nth-child(5) { animation-delay: 0.28s; }
  .fmsites.is-anim.is-ready .fmsites__card:nth-child(6) { animation-delay: 0.34s; }
  .fmsites.is-anim.is-ready .fmsites__card:nth-child(7) { animation-delay: 0.4s; }

  @keyframes fmsites-in {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }

  /* ПЛАНШЕТ: макет 800 */
  @media (max-width: 979px) {
    .fmsites__viewport { --u: calc(100cqw / 800); padding: calc(70 * var(--u)) 0; }

    .fmsites__grid { width: calc(720 * var(--u)); grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .fmsites__hero,
    .fmsites__stats,
    .fmsites__case { grid-column: 1 / -1; }

    .fmsites__feature { grid-column: span 1; }

    .fmsites__stats { flex-direction: row; align-items: center; }

    .fmsites__stats-img { flex: 0 0 46%; width: 46%; aspect-ratio: 1; }

    .fmsites__case { flex-direction: column; align-items: flex-start; }

    /* в колонке ширина-основа превращалась в высоту и давала пустоту */
    .fmsites__case-copy { flex: 0 0 auto; }

    .fmsites__case-side { align-items: flex-start; }
  }

  /* ТЕЛЕФОН */
  @media (max-width: 640px) {
    .fmsites { background: transparent; }

    .fmsites__viewport { padding: 48px 0 46px; border-radius: 36px; }

    .fmsites__header { width: 100%; padding: 0 18px; }

    .fmsites__tag {
      margin-bottom: 20px;
      padding: 7px 10px;
      font-size: 11px;
      line-height: 13px;
    }

    .fmsites__title {
      max-width: 430px;
      margin: 0 auto;
      font-size: clamp(27px, 7.7vw, 35px);
      line-height: 0.98;
      letter-spacing: -0.8px;
    }

    .fmsites__title br { display: none; }

    .fmsites__lead {
      width: 100%;
      margin-top: 14px;
      font-size: 13px;
      line-height: 17px;
    }

    .fmsites__grid {
