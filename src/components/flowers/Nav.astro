<style is:global>

/* Пункт «Смотреть разборы» – с красной точкой (прототип flowers v2) */
.fm-hot::before {
  content: '';
  display: inline-block;
  width: 7px;
  height: 7px;
  margin-right: 6px;
  vertical-align: 1px;
  border-radius: 50%;
  background: #ff3b30;
  animation: fm-hot-pulse 1.6s ease-in-out infinite;
}

@keyframes fm-hot-pulse {
  50% { opacity: 0.35; }
}

@media (prefers-reduced-motion: reduce) {
  .fm-hot::before { animation: none; }
}
/* ===== слой 1 из Тильды ===== */
/* =========================================================
   BASE
   ========================================================= */

.fm-header {

  --fmh-dark:#202020;
  --fmh-green:#ceff32;

  position:fixed;

  z-index:999999;

  left:0;
  top:0;

  width:100%;

  margin:0;
  padding:0;

  background:transparent;

  /*
   * Сам внешний fixed-контейнер
   * НЕ ловит клики по странице.
   */
  pointer-events:none;

  font-family:
    "Inter Tight",
    Inter,
    Arial,
    sans-serif;

}


.fm-header,
.fm-header * {

  box-sizing:border-box;

}



/* =========================================================
   HEADER INNER
   ========================================================= */

.fm-header__inner {

  position:relative;

  width:100%;

  min-height:92px;

  padding:
    16px
    clamp(
      18px,
      3vw,
      42px
    );

  display:grid;

  grid-template-columns:
    150px
    1fr
    260px;

  align-items:center;

  gap:24px;

  background:transparent;

  /*
   * Только реальная видимая область header
   * получает клики.
   */
  pointer-events:auto;

}



/* =========================================================
   SOCIALS
   ========================================================= */

.fm-header__socials {

  display:flex;

  align-items:center;

  gap:3px;

}


.fm-header__social {

  width:44px;
  height:44px;

  flex:
    0
    0
    44px;

  display:flex;

  align-items:center;

  justify-content:center;

  border-radius:50%;

  background:#000;

  color:#fff;

  text-decoration:none;

  transition:
    background-color .28s ease,
    color .28s ease,
    transform .28s ease;

}


.fm-header__social svg {

  display:block;

  width:20px;
  height:20px;

  pointer-events:none;

}


.fm-header__social .fm-header__max-icon {

  width:22px;
  height:22px;

}


@media
(hover:hover)
and
(pointer:fine) {

  .fm-header__social:hover {

    background:
      var(--fmh-green);

    color:#000;

    transform:
      translateY(-2px);

  }

}



/* =========================================================
   DESKTOP NAV PILL
   ========================================================= */

.fm-header__nav-wrap {

  justify-self:center;

  display:flex;

  align-items:center;

  min-height:44px;

  padding:
    0
    20px;

  border-radius:100px;

  background:
    var(--fmh-dark);

}



/* =========================================================
   NAV
   ========================================================= */

.fm-header__nav {

  display:flex;

  align-items:center;

  justify-content:center;

  gap:
    clamp(
      24px,
      2.4vw,
      38px
    );

  white-space:nowrap;

}


.fm-header__nav a {

  min-height:44px;

  display:inline-flex;

  align-items:center;

  color:#fff;

  text-decoration:none;

  font-size:14px;

  line-height:17px;

  font-weight:600;

  transition:
    color .25s ease;

}


@media
(hover:hover)
and
(pointer:fine) {

  .fm-header__nav a:hover {

    color:
      var(--fmh-green);

  }

}



/* =========================================================
   DESKTOP CTA
   ========================================================= */

.fm-header__cta {

  display:flex;

  align-items:center;

  justify-content:flex-end;

  gap:3px;

}



/* CTA ROUND */

.fm-header__cta-dot {

  width:44px;
  height:44px;

  flex:
    0
    0
    44px;

  display:flex;

  align-items:center;

  justify-content:center;

  border-radius:50%;

  background:
    var(--fmh-green);

  text-decoration:none;

  transition:
    background-color .28s ease,
    transform .28s ease;

}


.fm-header__cta-dot span {

  width:5px;
  height:5px;

  border-radius:50%;

  background:
    var(--fmh-dark);

  pointer-events:none;

}



/* CTA PILL */

.fm-header__cta-button {

  min-height:44px;

  padding:
    0
    24px;

  display:flex;

  align-items:center;

  justify-content:center;

  border-radius:100px;

  background:
    var(--fmh-green);

  color:
    var(--fmh-dark);

  text-decoration:none;

  white-space:nowrap;

  font-size:14px;

  line-height:17px;

  font-weight:700;

  transition:
    background-color .28s ease,
    color .28s ease,
    transform .28s ease;

}



/* CTA HOVER */

@media
(hover:hover)
and
(pointer:fine) {


  .fm-header__cta:hover
  .fm-header__cta-dot {

    background:
      var(--fmh-dark);

    transform:
      translateY(-2px);

  }


  .fm-header__cta:hover
  .fm-header__cta-dot span {

    background:
      var(--fmh-green);

  }


  .fm-header__cta:hover
  .fm-header__cta-button {

    background:
      var(--fmh-dark);

    color:
      var(--fmh-green);

    transform:
      translateY(-2px);

  }


}



/* =========================================================
   BURGER
   ========================================================= */

.fm-header__burger {

  position:relative;

  display:none;

  width:48px;
  height:48px;

  flex:
    0
    0
    48px;

  padding:0;

  border:0;

  border-radius:50%;

  background:
    var(--fmh-dark);

  cursor:pointer;

  pointer-events:auto;

}


.fm-header__burger span {

  position:absolute;

  left:14px;

  width:20px;
  height:2px;

  border-radius:10px;

  background:#fff;

  pointer-events:none;

  transition:
    top .3s ease,
    transform .3s ease,
    opacity .3s ease,
    background-color .3s ease;

}


.fm-header__burger span:nth-child(1) {

  top:16px;

}


.fm-header__burger span:nth-child(2) {

  top:23px;

}


.fm-header__burger span:nth-child(3) {

  top:30px;

}



/* =========================================================
   BURGER OPEN
   ========================================================= */

.fm-header.is-open
.fm-header__burger {

  background:
    var(--fmh-green);

}


.fm-header.is-open
.fm-header__burger span {

  background:
    var(--fmh-dark);

}


.fm-header.is-open
.fm-header__burger span:nth-child(1) {

  top:23px;

  transform:
    rotate(45deg);

}


.fm-header.is-open
.fm-header__burger span:nth-child(2) {

  opacity:0;

}


.fm-header.is-open
.fm-header__burger span:nth-child(3) {

  top:23px;

  transform:
    rotate(-45deg);

}



/* =========================================================
   MOBILE MENU DEFAULT
   ========================================================= */

.fm-header__mobile {

  display:none;

}



/* =========================================================
   TABLET
   ========================================================= */

@media
(max-width:1100px)
and
(min-width:641px) {


  .fm-header__inner {

    grid-template-columns:
      100px
      1fr
      210px;

    gap:12px;

    padding-left:20px;
    padding-right:20px;

  }


  .fm-header__nav-wrap {

    padding:
      0
      14px;

  }


  .fm-header__nav {

    gap:16px;

  }


  .fm-header__nav a {

    font-size:12px;

  }


  .fm-header__cta-button {

    padding:
      0
      15px;

    font-size:12px;

  }


}



/* =========================================================
   MOBILE 300–640
   ========================================================= */

@media
(max-width:640px) {


  /*
   * На мобильном сам header по-прежнему
   * НЕ является огромной кликабельной поверхностью.
   */

  .fm-header {

    pointer-events:none;

  }



  /* TOP BAR */

  .fm-header__inner {

    position:relative;

    min-height:76px;

    padding:
      14px
      16px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:15px;

    pointer-events:auto;

  }



  /* SOCIALS */

  .fm-header__socials {

    gap:3px;

  }


  .fm-header__social {

    width:46px;
    height:46px;

    flex-basis:46px;

  }



  /* DESKTOP ELEMENTS OFF */

  .fm-header__nav-wrap,
  .fm-header__cta {

    display:none;

  }



  /* BURGER */

  .fm-header__burger {

    display:block;

  }



  /* =======================================================
     MOBILE PANEL – CLOSED
     ======================================================= */

  .fm-header__mobile {

    position:absolute;

    left:12px;
    right:12px;

    top:76px;

    display:block;

    overflow:hidden;

    opacity:0;

    visibility:hidden;

    /*
     * КЛЮЧЕВО:
     * закрытое меню вообще не участвует
     * в touch/click.
     */
    pointer-events:none !important;

    transform:
      translateY(-12px);

    transition:
      opacity .25s ease,
      transform .35s
      cubic-bezier(.2,.75,.25,1),
      visibility 0s linear .35s;

  }



  /*
   * И ВСЕ дети закрытой панели
   * также отключены.
   */

  .fm-header__mobile *,
  .fm-header__mobile a,
  .fm-header__mobile button {

    pointer-events:none !important;

  }



  /* =======================================================
     MOBILE PANEL – OPEN
     ======================================================= */

  .fm-header.is-open
  .fm-header__mobile {

    opacity:1;

    visibility:visible;

    pointer-events:auto !important;

    transform:
      translateY(0);

    transition:
      opacity .25s ease,
      transform .35s
      cubic-bezier(.2,.75,.25,1),
      visibility 0s;

  }



  .fm-header.is-open
  .fm-header__mobile *,
  .fm-header.is-open
  .fm-header__mobile a,
  .fm-header.is-open
  .fm-header__mobile button {

    pointer-events:auto !important;

  }



  /* =======================================================
     PANEL INNER
     ======================================================= */

  .fm-header__mobile-inner {

    width:100%;

    padding:18px;

    border-radius:26px;

    background:
      var(--fmh-dark);

  }



  /* =======================================================
     MOBILE NAV
     ======================================================= */

  .fm-header__mobile-nav {

    display:flex;

    flex-direction:column;

  }


  .fm-header__mobile-nav a {

    min-height:48px;

    display:flex;

    align-items:center;

    border-bottom:
      1px
      solid
      rgba(
        255,
        255,
        255,
        .10
      );

    color:#fff;

    text-decoration:none;

    font-size:18px;

    line-height:1;

    font-weight:600;

  }



  /* =======================================================
     MOBILE CTA
     ======================================================= */

  .fm-header__mobile-cta {

    position:relative;

    width:100%;

    min-height:55px;

    margin-top:18px;

    padding:
      5px
      55px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:100px;

    background:
      var(--fmh-green);

    color:
      var(--fmh-dark);

    text-decoration:none;

    font-size:14px;

    line-height:16px;

    font-weight:700;

  }


  .fm-header__mobile-cta-label {

    width:100%;

    text-align:center;

    pointer-events:none !important;

  }


  .fm-header__mobile-cta-icon {

    position:absolute;

    right:5px;
    top:50%;

    width:44px;
    height:44px;

    transform:
      translateY(-50%);

    /*
     * SVG не принимает touch.
     * Вся кнопка нажимается через <a>.
     */
    pointer-events:none !important;

  }


  .fm-header__mobile-cta-icon svg {

    display:block;

    width:100%;
    height:100%;

    pointer-events:none !important;

  }


  .fm-header__mobile-cta-icon svg * {

    pointer-events:none !important;

  }



  /* =======================================================
     MOBILE SOCIAL LINKS
     ======================================================= */

  .fm-header__mobile-socials {

    margin-top:18px;

    display:flex;

    gap:20px;

  }


  .fm-header__mobile-socials a {

    min-height:44px;

    display:flex;

    align-items:center;

    color:
      rgba(
        255,
        255,
        255,
        .50
      );

    text-decoration:none;

    font-size:13px;

  }


}



/* =========================================================
   TILDA EDITOR SAFETY
   ========================================================= */

/*
 * В редакторе не держим header fixed поверх
 * панелей управления Tilda.
 *
 * На опубликованной странице он остаётся fixed.
 */

body.t-body_edit
.fm-header,

body.tilda-mode-edit
.fm-header,

html.tilda-mode-edit
.fm-header {

  position:absolute;

}



/* =========================================================
   FOCUS
   ========================================================= */

.fm-header a:focus-visible,
.fm-header button:focus-visible {

  outline:
    2px
    solid
    var(--fmh-green);

  outline-offset:3px;

}



/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media
(prefers-reduced-motion:reduce) {


  .fm-header *,
  .fm-header *::before,
  .fm-header *::after {

    transition:none !important;

  }


}
</style>

<script is:inline>
(function () {


  const headers =
    document.querySelectorAll(
      '[data-fm-header]'
    );


  headers.forEach(
    function (root) {


      /*
       * Новый ключ версии.
       * Старый JS header не блокирует
       * запуск исправленной версии.
       */

      if (
        root.dataset.fmHeaderV14Ready ===
        '1'
      ) {

        return;

      }


      root.dataset.fmHeaderV14Ready =
        '1';



      const burger =
        root.querySelector(
          '[data-header-burger]'
        );


      const mobile =
        root.querySelector(
          '[data-header-mobile]'
        );



      if (
        !burger ||
        !mobile
      ) {

        return;

      }



      /* =====================================================
         OPEN
         ===================================================== */

      function openMenu() {


        root.classList.add(
          'is-open'
        );


        burger.setAttribute(
          'aria-expanded',
          'true'
        );


        burger.setAttribute(
          'aria-label',
          'Закрыть меню'
        );


      }



      /* =====================================================
         CLOSE
         ===================================================== */

      function closeMenu() {


        root.classList.remove(
          'is-open'
        );


        burger.setAttribute(
          'aria-expanded',
          'false'
        );


        burger.setAttribute(
          'aria-label',
          'Открыть меню'
        );


      }



      /* =====================================================
         BURGER
         ===================================================== */

      burger.addEventListener(
        'click',
        function (event) {


          event.preventDefault();

          event.stopPropagation();


          if (
            root.classList.contains(
              'is-open'
            )
          ) {

            closeMenu();

          } else {

            openMenu();

          }


        }
      );



      /* =====================================================
         MOBILE LINKS
         ===================================================== */

      mobile
        .querySelectorAll(
          'a'
        )
        .forEach(
          function (link) {


            link.addEventListener(
              'click',
              function () {


                closeMenu();


              }
            );


          }
        );



      /* =====================================================
         ESC
         ===================================================== */

      document.addEventListener(
        'keydown',
        function (event) {


          if (
            event.key ===
            'Escape'
          ) {

            closeMenu();

          }


        }
      );



      /* =====================================================
         CLICK OUTSIDE
         ===================================================== */

      document.addEventListener(
        'click',
        function (event) {


          if (
            !root.classList.contains(
              'is-open'
            )
          ) {

            return;

          }


          if (
            root.contains(
              event.target
            )
          ) {

            return;

          }


          closeMenu();


        }
      );



      /* =====================================================
         DESKTOP RESIZE
         ===================================================== */

      window.addEventListener(
        'resize',
        function () {


          if (
            window.innerWidth >
            640
          ) {

            closeMenu();

          }


        },
        {
          passive:true
        }
      );


    }
  );


})();
</script>
