---
/** Тарифы «Выбирайте формат сотрудничества» – по макету Figma (кадр 3,
    белая секция 1440 × 1643): три колонки 418 px, в каждой – верхняя
    карточка (иконка-плитка с хромированным предметом, название Oswald
    капсом, подзаголовок) и нижняя (состав, «стоимость от», цена, кнопка).
    Белая колонка, красная (выделенная) и чёрная; заголовки – металлический
    градиент по тексту, списки – Montserrat. На телефоне колонки друг под
    другом, масштаб – по ширине колонки.
    Тексты, цены и состав – с оригинала (якорь service). В макете у тарифа
    «под ключ» 50 000 ₽/мес, на сайте – 60 000 ₽/мес: оставлена цена сайта.
    Кнопка «Оплатить полностью» открывает заявку со своим тарифом. */

const plans = [
  {
    tone: 'light',
    icon: 'mic',
    title: 'Консультация по рекламе ВКонтакте',
    sub: 'Идеально для микробизнеса и начинающих предпринимателей',
    price: '15 000 ₽',
    items: [
      'Аудит рекламного кабинета: аудитории, тексты, креативы',
      'Рекомендации по упаковке сообщества и контенту',
      'Подсказки по обработке заявок и воронке продаж',
      'Онлайн-сессия 1,5 – 2 часа',
      'Вы получите чёткий план действий: сможете самостоятельно запустить рекламу или контролировать работу таргетолога',
    ],
    gifts: [],
    hook: '#zeropopupconsult',
  },
  {
    tone: 'red',
    icon: 'megaphone',
    title: 'Настройка таргетированной рекламы',
    sub: 'Для предпринимателей, которые хотят получать клиентов уже в первый месяц',
    price: '30 000 ₽',
    items: [
      'Аудит сообщества + рекомендации по улучшению',
      'Разработка стратегии продвижения',
      'Сбор и анализ целевой аудитории',
      'Настройка рекламного кабинета',
      'Создание креативов и текстов',
      'Запуск и ведение рекламы – 1 месяц',
      'Оптимизация, масштабирование, ежедневная работа с результатами',
    ],
    gifts: ['Оформление и дизайн сообщества', 'Установка чат-бота', 'Рекомендации по контенту и продажам'],
    hook: '#zeropopuptarget',
  },
  {
    tone: 'dark',
    icon: 'key',
    title: 'Продвижение под ключ – «Таргет + СММ»',
    sub: 'Вы делаете продажи. Всё остальное – берём на себя.',
    price: '60 000 ₽/мес',
    items: [
      'Всё из пакета по таргету +',
      '20–30 постов в месяц',
      'Контент-план, продуманный под ЦА, боли, страхи, возражения',
      'Посты, которые не просто украшают ленту, а ведут к заявкам и продажам',
      'Подходит тем, кто хочет полностью делегировать рекламу и контент – и не тратить время на публикации и тексты.',
    ],
    gifts: [],
    hook: '#zeropopuptargetsmm',
  },
];
---

<section class="tf-section tfplans" id="service">
  <div class="tf-panel tf-panel--white tfplans__panel">
    <header class="tfplans__head" data-reveal>
      <div class="tf-tag tfplans__tag">– от консультации до полного ведения под ключ.</div>
      <h2 class="tf-h2 tfplans__title">Выбирайте формат сотрудничества, который подходит именно вам</h2>
    </header>

    <div class="tfplans__grid">
      {
        plans.map((p, i) => (
          <article class={`tfplans__col tfplans__col--${p.tone}`} data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
            <div class="tfplans__card tfplans__card--top">
              <div class="tfplans__badge" aria-hidden="true">
                <span class="tfplans__tile"></span>
                <img class={`tfplans__obj tfplans__obj--${p.icon}`} src={`/img/tf/fig/plan-${p.icon}.webp`} alt="" loading="lazy" decoding="async" />
              </div>
              <h3 class="tfplans__name tfplans__metal">{p.title}</h3>
              <p class="tfplans__sub">{p.sub}</p>
            </div>

            <div class="tfplans__card tfplans__card--body">
              <div class="tfplans__label tfplans__metal">Что получите:</div>
              <ul class="tfplans__list">
                {p.items.map((item) => <li>{item}</li>)}
              </ul>

              {p.gifts.length > 0 && (
                <div class="tfplans__gifts">
                  <div class="tfplans__gifts-title">Дарим бесплатно:</div>
                  <ul class="tfplans__list tfplans__list--gift">
                    {p.gifts.map((g) => <li>{g}</li>)}
                  </ul>
                </div>
              )}

              <div class="tfplans__from">стоимость от</div>
              <div class="tfplans__price tfplans__metal">{p.price}</div>
              <a class="tfplans__btn" href={p.hook}>
                <span>Оплатить полностью</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .tfplans__panel {
    --f: calc(100cqw / 1440);
    padding: calc(50 * var(--f)) 0 calc(63 * var(--f));
    border-radius: calc(90 * var(--f));
  }

  .tfplans__head { display: flex; flex-direction: column; align-items: center; text-align: center; }

  .tfplans .tfplans__tag {
    padding: calc(8.4 * var(--f)) calc(12 * var(--f));
    border-width: 1.2px;
    font-size: calc(13.2 * var(--f));
    line-height: calc(15.6 * var(--f));
  }

  .tfplans .tfplans__title {
    width: calc(716 * var(--f));
    margin-top: calc(18 * var(--f));
    font-size: calc(39.6 * var(--f));
    line-height: 1;
    letter-spacing: calc(-1.2 * var(--f));
  }

  .tfplans__grid {
    display: grid;
    grid-template-columns: repeat(3, calc(418.5 * var(--f)));
    justify-content: center;
    align-items: start;
    gap: calc(22.5 * var(--f));
    margin-top: calc(40 * var(--f));
  }

  .tfplans__col { display: flex; flex-direction: column; gap: calc(15 * var(--f)); }

  .tfplans__card {
    position: relative;
    border: 1.12px solid transparent;
    border-radius: calc(22.56 * var(--f));
  }

  .tfplans__card--top {
    display: grid;
    grid-template-columns: calc(112 * var(--f)) 1fr;
    column-gap: calc(0 * var(--f));
    padding: calc(33.6 * var(--f)) calc(20 * var(--f)) calc(34 * var(--f)) calc(33.6 * var(--f));
  }

  .tfplans__card--body { display: flex; flex-direction: column; padding: calc(33.6 * var(--f)) calc(33.6 * var(--f)) calc(34.7 * var(--f)); }

  /* плитка с предметом: предмет выходит за плитку, как в макете */
  .tfplans__badge { position: relative; width: calc(95.26 * var(--f)); height: calc(109.83 * var(--f)); margin-top: calc(10 * var(--f)); }
  .tfplans__tile { position: absolute; inset: 0; border: 1.12px solid #303030; border-radius: calc(5.6 * var(--f)); background: var(--tf-grad); }
  .tfplans__col--red .tfplans__tile { background: linear-gradient(97deg, #3b3b3b 0%, #000 96%); }

  .tfplans__obj { position: absolute; max-width: none; pointer-events: none; }
  .tfplans__obj--mic { left: calc(-22.4 * var(--f)); top: calc(-28 * var(--f)); width: calc(154 * var(--f)); height: calc(152.4 * var(--f)); object-fit: cover; object-position: left; clip-path: inset(0 23% 0 0); }
  .tfplans__obj--megaphone { left: calc(14 * var(--f)); top: calc(-12 * var(--f)); width: calc(123.3 * var(--f)); height: calc(107.3 * var(--f)); object-fit: contain; transform: rotate(-156.59deg) scaleY(-1); }
  .tfplans__obj--key { left: calc(-31.6 * var(--f)); top: calc(-55.9 * var(--f)); width: calc(183.8 * var(--f)); height: calc(183.8 * var(--f)); transform: rotate(21.94deg); }

  /* металлический градиент по тексту – как в макете */
  .tfplans__metal {
    background: linear-gradient(150deg, #000 0%, #6a6a6a 38.6%, #000 76.5%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tfplans__col--red .tfplans__metal,
  .tfplans__col--dark .tfplans__metal { background-image: linear-gradient(155deg, #d8d8d8 0%, #fff 38.6%, #d8d8d8 76.5%); }

  .tfplans__name {
    align-self: start;
    font-family: var(--tf-display);
    font-size: calc(33.62 * var(--f));
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: calc(-0.67 * var(--f));
    text-transform: uppercase;
  }

  .tfplans__sub {
    grid-column: 1 / -1;
    margin-top: calc(12 * var(--f));
    padding-right: calc(40 * var(--f));
    color: rgba(0, 0, 0, 0.7);
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: calc(17.93 * var(--f));
    line-height: 1.5;
  }

  .tfplans__label { font-family: var(--tf-display); font-size: calc(26.9 * var(--f)); line-height: 1.2; font-weight: 500; letter-spacing: calc(-0.54 * var(--f)); text-transform: uppercase; }

  .tfplans__list {
    margin: calc(12 * var(--f)) 0 0;
    padding: 0 0 0 calc(26.9 * var(--f));
    color: rgba(0, 0, 0, 0.7);
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: calc(17.93 * var(--f));
    line-height: 1.5;
    list-style: disc;
  }

  .tfplans__list li + li { margin-top: calc(26.9 * var(--f)); }
  .tfplans__list li::marker { font-size: 0.7em; }

  .tfplans__gifts { margin-top: calc(26.9 * var(--f)); }
  .tfplans__gifts-title { color: #fff; font-family: 'Montserrat', Arial, sans-serif; font-size: calc(17.93 * var(--f)); line-height: 1.5; font-weight: 700; }
  .tfplans__list--gift { margin-top: 0; }
  .tfplans__list--gift li + li { margin-top: 0; }

  .tfplans__from {
    margin-top: calc(78 * var(--f));
    padding-left: calc(6.7 * var(--f));
    color: rgba(0, 0, 0, 0.5);
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: calc(15.69 * var(--f));
    line-height: 1.4;
  }

  .tfplans__price { margin-top: calc(10.5 * var(--f)); font-family: var(--tf-display); font-size: calc(40.35 * var(--f)); line-height: 1.2; font-weight: 500; letter-spacing: calc(-0.81 * var(--f)); text-transform: uppercase; white-space: nowrap; }

  .tfplans__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(359.74 * var(--f));
    height: calc(101.98 * var(--f));
    margin-top: calc(39 * var(--f));
    border-radius: calc(11.2 * var(--f));
    background: linear-gradient(116deg, #ee0000 0%, #810005 96%);
    box-shadow: 0 calc(3.36 * var(--f)) 0 #760505;
    color: #fff;
    font-family: var(--tf-display);
    font-size: calc(22.41 * var(--f));
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: calc(-0.45 * var(--f));
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 0.25s ease, filter 0.25s ease;
  }

  .tfplans__btn:hover { transform: translateY(-2px); filter: brightness(1.08); }
  .tfplans__btn:active { transform: translateY(1px); }

  /* белая колонка */
  .tfplans__col--light .tfplans__card { background: #fff; }

  /* красная колонка – выделенная */
  .tfplans__col--red .tfplans__card--top { background: linear-gradient(102deg, #ee0000 0%, #810005 96%); }
  .tfplans__col--red .tfplans__card--body { background: linear-gradient(93deg, #ee0000 0%, #810005 96%); }
  .tfplans__col--red .tfplans__card--top { padding-bottom: calc(50 * var(--f)); }
  .tfplans__col--red .tfplans__sub,
  .tfplans__col--red .tfplans__list { color: #fff; }
  .tfplans__col--red .tfplans__from { color: rgba(255, 255, 255, 0.7); }
  .tfplans__col--red .tfplans__btn { background: linear-gradient(155deg, #d8d8d8 0%, #fff 38.6%, #d8d8d8 76.5%); box-shadow: 0 calc(3.36 * var(--f)) 0 #b1b1b1; }

  .tfplans__col--red .tfplans__btn span {
    background: linear-gradient(137deg, #ee0000 0%, #810005 96%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* чёрная колонка */
  .tfplans__col--dark .tfplans__card { border-color: #303030; }
  .tfplans__col--dark .tfplans__card--top { background: linear-gradient(103deg, #3b3b3b 0%, #000 96%); }
  .tfplans__col--dark .tfplans__card--body { background: linear-gradient(105deg, #3b3b3b 0%, #000 84%), #191919; }
  .tfplans__col--dark .tfplans__sub { color: #a9a9a9; font-size: calc(20.17 * var(--f)); }
  .tfplans__col--dark .tfplans__list { color: #a9a9a9; }
  .tfplans__col--dark .tfplans__list li:first-child { color: #fff; font-weight: 700; }
  .tfplans__col--dark .tfplans__from { color: rgba(255, 255, 255, 0.7); }

  /* планшет и телефон: колонки друг под другом, масштаб – по ширине колонки */
  @media (max-width: 979px) {
    .tfplans__panel { --f: min(calc((100cqw - 36px) / 418.5), 1.15px); padding: 44px 0 30px; border-radius: 36px; }
    .tfplans .tfplans__tag { padding: 7px 11px; font-size: 12px; line-height: 14px; }
    .tfplans .tfplans__title { width: auto; max-width: 560px; margin-top: 14px; padding: 0 18px; font-size: clamp(26px, 6vw, 36px); letter-spacing: -0.03em; }
    .tfplans__grid { grid-template-columns: calc(418.5 * var(--f)); gap: 28px; margin-top: 30px; }
    .tfplans__card--top { padding-right: calc(12 * var(--f)); }
    .tfplans__name { font-size: calc(30 * var(--f)); }
  }
</style>
