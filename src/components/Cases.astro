<script is:inline>
(function () {

    const gallery =
        document.getElementById(
            'defordCaseGallery'
        );

    if (!gallery) return;


    const track =
        gallery.querySelector(
            '.dfc-gallery-track'
        );


    const prev =
        gallery.querySelector(
            '.dfc-nav-prev'
        );


    const next =
        gallery.querySelector(
            '.dfc-nav-next'
        );


    const dotsWrap =
        gallery.querySelector(
            '.dfc-dots'
        );


    const currentEl =
        gallery.querySelector(
            '.dfc-current'
        );


    const totalEl =
        gallery.querySelector(
            '.dfc-total'
        );


    /* =====================================================
       FIND FILLED IMAGES
       ===================================================== */

    const allSlides =
        Array.from(
            gallery.querySelectorAll(
                '.dfc-slide'
            )
        );


    const PLACEHOLDER_FRAGMENT =
        'R0lGODlhAQABAAD';


    /*
       Удаляем из слайдера те слоты,
       куда пользователь ещё
       не загрузил фотографию.
    */

    allSlides.forEach(
        function (slide) {

            const img =
                slide.querySelector('img');

            if (!img) {

                slide.remove();

                return;

            }


            const src =
                img.getAttribute('src') || '';


            if (
                !src ||
                src.indexOf(
                    PLACEHOLDER_FRAGMENT
                ) !== -1
            ) {

                slide.remove();

            }

        }
    );


    const slides =
        Array.from(
            gallery.querySelectorAll(
                '.dfc-slide'
            )
        );


    const count =
        slides.length;


    /*
       На всякий случай,
       если вообще нет изображений.
    */

    if (!count) {

        gallery.style.display = 'none';

        return;

    }


    /* =====================================================
       STATE
       ===================================================== */

    let index = 0;

    let startX = 0;

    let currentX = 0;

    let dragging = false;


    /* =====================================================
       DOTS
       ===================================================== */

    dotsWrap.innerHTML = '';


    slides.forEach(
        function (_, dotIndex) {

            const dot =
                document.createElement(
                    'button'
                );


            dot.type = 'button';

            dot.className =
                'dfc-dot';


            dot.setAttribute(
                'aria-label',
                'Показать изображение ' +
                (dotIndex + 1)
            );


            dot.addEventListener(
                'click',
                function () {

                    index = dotIndex;

                    update();

                }
            );


            dotsWrap.appendChild(dot);

        }
    );


    const dots =
        Array.from(
            dotsWrap.querySelectorAll(
                '.dfc-dot'
            )
        );


    /* =====================================================
       UPDATE
       ===================================================== */

    function update() {

        if (index < 0) {
            index = count - 1;
        }

        if (index >= count) {
            index = 0;
        }


        track.style.transform =
            'translate3d(' +
            (-index * 100) +
            '%,0,0)';


        dots.forEach(
            function (dot, i) {

                dot.classList.toggle(
                    'is-active',
                    i === index
                );

            }
        );


        currentEl.textContent =
            String(index + 1);


        totalEl.textContent =
            String(count);

    }


    /* =====================================================
       SINGLE IMAGE
       ===================================================== */

    if (count === 1) {

        gallery.classList.add(
            'is-single'
        );

    }


    /* =====================================================
       ARROWS
       ===================================================== */

    prev.addEventListener(
        'click',
        function () {

            index--;

            update();

        }
    );


    next.addEventListener(
        'click',
        function () {

            index++;

            update();

        }
    );


    /* =====================================================
       TOUCH / POINTER SWIPE
       ===================================================== */

    const viewport =
        gallery.querySelector(
            '.dfc-gallery-viewport'
        );


    viewport.addEventListener(
        'pointerdown',
        function (event) {

            if (count <= 1) return;


            dragging = true;

            startX =
                event.clientX;

            currentX =
                startX;


            viewport.setPointerCapture(
                event.pointerId
            );

        }
    );


    viewport.addEventListener(
        'pointermove',
        function (event) {

            if (!dragging) return;


            currentX =
                event.clientX;

        }
    );


    viewport.addEventListener(
        'pointerup',
        function (event) {

            if (!dragging) return;


            dragging = false;


            const delta =
                currentX - startX;


            /*
               свайп минимум 45px
            */

            if (
                Math.abs(delta) > 45
            ) {

                if (delta < 0) {

                    index++;

                } else {

                    index--;

                }


                update();

            }


            try {

                viewport.releasePointerCapture(
                    event.pointerId
                );

            } catch (e) {}

        }
    );


    viewport.addEventListener(
        'pointercancel',
        function () {

            dragging = false;

        }
    );


    /* =====================================================
       KEYBOARD
       ===================================================== */

    gallery.setAttribute(
        'tabindex',
        '0'
    );


    gallery.addEventListener(
        'keydown',
        function (event) {

            if (count <= 1) return;


            if (
                event.key ===
                'ArrowLeft'
            ) {

                index--;

                update();

            }


            if (
                event.key ===
                'ArrowRight'
            ) {

                index++;

                update();

            }

        }
    );


    /* =====================================================
       INIT
       ===================================================== */

    update();


})();
</script>
