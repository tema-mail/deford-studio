---
/** «Три вещи, которые съедают выручку цветочного» (бывш. «Ошибки
    в маркетинге»; тексты – прототип flowers v2, 29.10.2026). На оригинале
    (rec4182829501) карточки едут по колесу, пока секция прилипает
    к экрану. Здесь: на десктопе три карточки в ряд, на планшете по две. На телефоне – одной лентой,
    которая листается свайпом вбок, без прилипания секции к экрану.

    Вид карточки, шапки и подложки взят с оригинала: фото, стеклянная
    плашка текста, радиусы, цвета, появление при прокрутке. Десктоп
    масштабируется от макета 1200 так же, как соседние секции. */

const errors = [
  {
    img: '38663061-ChatGPT_Image_17__20.png',
    title: 'Списания',
    text: 'Закупили под выходные, а заказов не хватило – цветы уходят в мусор. Запускаем рекламу и рассылку под то, что стоит в холодильнике сейчас.',
  },
  {
    img: '63383836-ChatGPT_Image_17__20.png',
    title: 'Флорист на два фронта',
    text: 'Пока он отвечает «сколько стоит» и «успеете к шести?», букет ждёт. Чат-бот сам отвечает на типовые вопросы и передаёт флористу готовый заказ.',
  },
  {
    img: '32396563-ChatGPT_Image_17__20.png',
    title: 'Праздник – завал, будни – тишина',
    text: '8 Марта и 14 февраля – пара недель в году. Готовим праздник за месяц, а между праздниками даём людям поводы заказать: дни рождения, годовщины, «просто так».',
  },
];
---

<section class="fm-errors" data-fm-errors style="padding-top: 15px;">
  <div class="fm-errors__viewport">
    <header class="fm-errors__header">
      <div class="fm-errors__tag">Боли владельца</div>
      <h2 class="fm-errors__title">
        <span class="fm-errors__title-line"><span>Три вещи, которые съедают</span></span>
        <span class="fm-errors__title-line"><span>выручку цветочного</span></span>
      </h2>
      <p class="fm-errors__lead">
        90% цветочных зарабатывают только в праздники. В остальные дни выручки едва хватает на зарплату флористам и аренду. Больше 6 лет выводим цветочные магазины на стабильный доход – и вне праздников.
      </p>
    </header>

    <div class="fm-errors__grid">
      {
        errors.map((item) => (
          <article class="fm-errors__card">
            <img
              class="fm-errors__image"
              src={`/img/flowers/${item.img}`}
              alt=""
              decoding="async"
            />
            <div class="fm-errors__glass">
              <h3 class="fm-errors__card-title">{item.title}</h3>
              <p class="fm-errors__card-text">{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .fm-errors {
    --fm-errors-bg: #dbdbdb;
    --fm-errors-dark: #202020;
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    background: #fff;
    font-family: 'Inter Tight', Inter, Arial, sans-serif;
    color: var(--fm-errors-dark);
    /* единица макета: 1/1200 ширины секции */
    container-type: inline-size;
  }

  .fm-errors,
  .fm-errors * {
    box-sizing: border-box;
  }

  .fm-errors__viewport {
    --u: calc(100cqw / 1200);
    position: relative;
    width: 100%;
    padding: calc(88 * var(--u)) 0 calc(88 * var(--u));
    overflow: hidden;
    background: var(--fm-errors-bg);
    border-radius: clamp(42px, 6.25vw, 120px);
  }

  /* ШАПКА */
  .fm-errors__header {
    width: calc(620 * var(--u));
    margin: 0 auto;
    text-align: center;
  }

  .fm-errors__tag {
    width: max-content;
    margin: 0 auto calc(27 * var(--u));
    padding: calc(7 * var(--u)) calc(10 * var(--u));
    background: #fff;
    border: 1px solid #ededee;
    border-radius: 100px;
    font-size: calc(11 * var(--u));
    line-height: calc(13 * var(--u));
    font-weight: 400;
  }

  .fm-errors__title {
    margin: 0;
    color: var(--fm-errors-dark);
    font-size: calc(33 * var(--u));
    line-height: calc(33 * var(--u));
    font-weight: 600;
    letter-spacing: -1px;
  }

  .fm-errors__lead {
    margin: calc(18 * var(--u)) auto 0;
    color: #6b6b6b;
    font-size: calc(14 * var(--u));
    line-height: 1.45;
  }

  .fm-errors__title-line {
    display: block;
    overflow: hidden;
  }

  .fm-errors__title-line > span {
    display: block;
  }

  /* СЕТКА: 3 колонки на ширине кейсов (1080 из 1200) */
  .fm-errors__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(20 * var(--u));
    width: calc(1080 * var(--u));
    margin: calc(50 * var(--u)) auto 0;
  }

  /* КАРТОЧКА – пропорции и оформление с оригинала */
  .fm-errors__card {
    position: relative;
    aspect-ratio: 324 / 421;
    overflow: hidden;
    border-radius: calc(30 * var(--u));
    background: #222;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.05);
    transition:
      transform 0.32s cubic-bezier(0.2, 0.75, 0.25, 1),
      filter 0.32s ease;
  }

  .fm-errors__card:hover {
    transform: scale(1.025);
    filter: brightness(1.03);
  }

  .fm-errors__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fm-errors__glass {
    position: absolute;
    z-index: 4;
    top: calc(25 * var(--u));
    left: calc(25 * var(--u));
    right: calc(25 * var(--u));
    padding: calc(15 * var(--u));
    border-radius: calc(10 * var(--u));
    background: rgba(32, 32, 32, 0.5);
    -webkit-backdrop-filter: blur(7.5px);
    backdrop-filter: blur(7.5px);
  }

  .fm-errors__card-title {
    margin: 0;
    color: #fff;
    font-size: calc(15 * var(--u));
    line-height: calc(17 * var(--u));
    font-weight: 500;
    letter-spacing: -0.5px;
  }

  .fm-errors__card-text {
    margin: calc(4 * var(--u)) 0 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: calc(11 * var(--u));
    line-height: calc(13 * var(--u));
    font-weight: 500;
  }

  /* ПОЯВЛЕНИЕ при прокрутке – только если скрипт включил анимацию,
     без скрипта карточки видны сразу */
  .fm-errors.is-anim .fm-errors__title-line > span {
    transform: translateY(120%);
    opacity: 0;
  }

  .fm-errors.is-anim .fm-errors__card {
    opacity: 0;
  }

  .fm-errors.is-anim.is-ready .fm-errors__title-line:nth-child(1) > span {
    animation: fm-errors-title-in 1.2s cubic-bezier(0.16, 0.82, 0.21, 1) 0.1s forwards;
  }

  .fm-errors.is-anim.is-ready .fm-errors__title-line:nth-child(2) > span {
    animation: fm-errors-title-in 1.2s cubic-bezier(0.16, 0.82, 0.21, 1) 0.25s forwards;
  }

  .fm-errors.is-anim.is-ready .fm-errors__card {
    animation: fm-errors-card-in 0.65s both;
  }

  .fm-errors.is-anim.is-ready .fm-errors__card:nth-child(1) { animation-delay: 0.2s; }
  .fm-errors.is-anim.is-ready .fm-errors__card:nth-child(2) { animation-delay: 0.25s; }
  .fm-errors.is-anim.is-ready .fm-errors__card:nth-child(3) { animation-delay: 0.3s; }
  .fm-errors.is-anim.is-ready .fm-errors__card:nth-child(4) { animation-delay: 0.35s; }
  .fm-errors.is-anim.is-ready .fm-errors__card:nth-child(5) { animation-delay: 0.4s; }
  .fm-errors.is-anim.is-ready .fm-errors__card:nth-child(6) { animation-delay: 0.45s; }

  @keyframes fm-errors-title-in {
    from { transform: translateY(120%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  @keyframes fm-errors-card-in {
    from { opacity: 0; scale: 0.92; }
    to { opacity: 1; scale: 1; }
  }

  /* ПЛАНШЕТ: две карточки в ряд, макет 800 */
  @media (max-width: 979px) {
    .fm-errors__lead {
      font-size: 15px;
    }

    .fm-errors__viewport {
      --u: calc(100cqw / 800);
      padding: calc(70 * var(--u)) 0 calc(70 * var(--u));
    }

    .fm-errors__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: calc(720 * var(--u));
      margin-top: calc(44 * var(--u));
    }
  }

  /* ТЕЛЕФОН: столбиком, размеры – с мобильной версии оригинала */
  @media (max-width: 640px) {
    .fm-errors {
      background: transparent;
    }

    .fm-errors__viewport {
      padding: 48px 0 46px;
      border-radius: 36px;
    }

    .fm-errors__header {
      width: 100%;
      padding: 0 18px;
    }

    .fm-errors__tag {
      margin-bottom: 20px;
      padding: 7px 10px;
      font-size: 11px;
      line-height: 13px;
    }

    .fm-errors__title {
      width: 100%;
      max-width: 430px;
      margin: 0 auto;
      font-size: clamp(27px, 7.7vw, 35px);
      line-height: 0.98;
      letter-spacing: -0.8px;
    }

    .fm-errors__lead {
      margin-top: 14px;
      font-size: 15px;
    }

    .fm-errors__title-line,
    .fm-errors__title-line > span {
      display: inline;
      overflow: visible;
    }

    .fm-errors__title-line:first-child > span::after {
      content: ' ';
    }

    .fm-errors.is-anim .fm-errors__title-line > span {
      transform: none;
      opacity: 1;
      animation: none !important;
    }

    /* Лента: листается свайпом, карточки встают по центру */
    .fm-errors__grid {
      display: flex;
      gap: 12px;
      width: 100%;
      margin-top: 38px;
      padding: 0 18px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .fm-errors__grid::-webkit-scrollbar {
      display: none;
    }

    .fm-errors__card {
      flex: 0 0 min(85vw, 500px);
      aspect-ratio: 500 / 360;
      border-radius: 24px;
      scroll-snap-align: center;
    }

    .fm-errors__card:hover {
      transform: none;
      filter: none;
    }

    /* на телефоне плашка снизу, как в мобильной версии оригинала */
    .fm-errors__glass {
      top: auto;
      left: 16px;
      right: 16px;
      bottom: 16px;
      padding: 14px;
      border-radius: 10px;
      background: rgba(32, 32, 32, 0.52);
    }

    .fm-errors__card-title {
      font-size: clamp(14px, 4vw, 17px);
      line-height: 1.08;
      letter-spacing: -0.4px;
    }

    .fm-errors__card-text {
      margin-top: 5px;
      font-size: clamp(10px, 2.75vw, 12px);
      line-height: 1.2;
    }
  }

  @media (max-width: 350px) {
    .fm-errors__header,
    .fm-errors__grid {
      padding-left: 12px;
      padding-right: 12px;
    }

    .fm-errors__title {
      font-size: 25px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fm-errors.is-anim .fm-errors__title-line > span,
    .fm-errors.is-anim .fm-errors__card {
      transform: none !important;
      opacity: 1 !important;
      animation: none !important;
    }

    .fm-errors__card {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-fm-errors]');
    if (!root) return;

    /* ПОЯВЛЕНИЕ: прячем до показа, только если сможем показать */
    if ('IntersectionObserver' in window) {
      root.classList.add('is-anim');
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            root.classList.add('is-ready');
            io.disconnect();
          });
        },
        { threshold: 0.15 },
      );
      io.observe(root);
    }

  })();
</script>
