/* ===== слой 1 из Тильды ===== */
/* =========================================================
   DEFORD — CONSULTATION CTA
   Desktop: auto-scale
   Tablet: scaled desktop
   Mobile: 300–640px
   ========================================================= */

#deford-consult-v1,
#deford-consult-v1 * {
    box-sizing: border-box;
}

#deford-consult-v1 {
    --blue: #0f68ff;
    --dark: #191919;
    --white: #ffffff;
    --grey: #dadada;
    --text: #2f2f2f;

    width: 100%;
    overflow: hidden;

    background: #ffffff;

    font-family: Inter, Arial, sans-serif;
}


/* =========================================================
   CONTAINER
   ========================================================= */

#deford-consult-v1 .dfc-container {
    width: 100%;
    max-width: 1440px;

    margin: 0 auto;

    padding-left: min(30px, 2.0833vw);
    padding-right: min(30px, 2.0833vw);
}


/* =========================================================
   CARD
   ========================================================= */

#deford-consult-v1 .dfc-card {
    position: relative;

    width: 100%;
    height: min(703px, 48.8194vw);

    overflow: hidden;

    border-radius: min(80px, 5.5556vw);

    background: var(--blue);

    isolation: isolate;
}


/* =========================================================
   BACKGROUND
   ========================================================= */

#deford-consult-v1 .dfc-bg {
    position: absolute;

    z-index: 1;

    width: 105.59%;
    height: 120.8%;

    left: -4.72%;
    top: -10.31%;

    pointer-events: none;
}

#deford-consult-v1 .dfc-bg path {
    fill: rgba(255,255,255,.10);
}


/* =========================================================
   TITLE
   ========================================================= */

#deford-consult-v1 .dfc-title {
    position: absolute;

    z-index: 5;

    left: min(70px, 4.8611vw);
    top: min(70px, 4.8611vw);

    width: min(1000px, 69.4444vw);

    margin: 0;

    font-family: Arial, Helvetica, sans-serif;

    font-size: min(65px, 4.5139vw);
    font-weight: 700;

    line-height: .9;
    letter-spacing: -.06em;

    color: var(--white);
}


/* =========================================================
   CONTACT AREA
   ========================================================= */

#deford-consult-v1 .dfc-contact-zone {
    position: absolute;

    z-index: 6;

    left: min(70px, 4.8611vw);
    right: min(70px, 4.8611vw);
    top: min(397px, 27.5694vw);

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: min(40px, 2.7778vw);
}


/* =========================================================
   CONTACTS
   ========================================================= */

#deford-consult-v1 .dfc-contacts {
    display: flex;
    flex-direction: column;

    min-width: 0;

    gap: min(20px, 1.3889vw);
}

#deford-consult-v1 .dfc-contact-link {
    display: block;

    width: fit-content;

    font-family: Arial, Helvetica, sans-serif;

    font-size: min(48px, 3.3333vw);
    font-weight: 400;

    line-height: .9;
    letter-spacing: -.06em;

    color: var(--white);

    text-decoration: none;

    transition: opacity .2s ease;
}

@media (hover:hover) {

    #deford-consult-v1 .dfc-contact-link:hover {
        opacity: .72;
    }

}


/* =========================================================
   PERSON
   ========================================================= */

#deford-consult-v1 .dfc-person {
    display: flex;
    align-items: center;

    flex: 0 0 auto;
}

#deford-consult-v1 .dfc-avatar {
    position: relative;
    z-index: 1;

    display: block;

    width: min(116px, 8.0556vw);
    height: min(116px, 8.0556vw);

    flex: 0 0 auto;

    border-radius: 50%;

    object-fit: cover;
    object-position: center 30%;

    border:
        min(2px, .1389vw)
        solid
        rgba(255,255,255,.8);
}

#deford-consult-v1 .dfc-person-bubble {
    position: relative;
    z-index: 2;

    display: flex;
    align-items: center;
    justify-content: center;

    width: min(116px, 8.0556vw);
    height: min(116px, 8.0556vw);

    margin-left: min(-21px, -1.4583vw);

    flex: 0 0 auto;

    border-radius: 50%;

    background: #ffffff;

    border:
        min(2px, .1389vw)
        solid
        rgba(255,255,255,.8);
}

#deford-consult-v1 .dfc-person-text {
    width: min(74px, 5.1389vw);

    font-size: min(15px, 1.0417vw);
    font-weight: 700;

    line-height: 1;

    text-align: left;

    color: var(--text);
}


/* =========================================================
   ACTIONS
   DESKTOP SPACING CORRECTED
   ========================================================= */

#deford-consult-v1 .dfc-actions {
    position: absolute;

    z-index: 6;

    left: min(70px, 4.8611vw);
    bottom: min(62px, 4.3056vw);

    display: flex;
    align-items: center;

    gap: min(14px, .9722vw);
}


/* =========================================================
   CONSULT BUTTON
   ========================================================= */

#deford-consult-v1 .dfc-button {
    position: relative;

    display: flex;
    align-items: center;

    width: min(430px, 29.8611vw);
    height: min(79px, 5.4861vw);

    padding:
        0
        min(80px, 5.5556vw)
        0
        min(36px, 2.5vw);

    border-radius: 999px;

    background: var(--dark);

    color: var(--grey);

    text-decoration: none;

    transition:
        transform .25s ease,
        background-color .25s ease;
}

#deford-consult-v1 .dfc-button-text {
    font-size: min(18px, 1.25vw);
    font-weight: 500;

    line-height: 1;

    white-space: nowrap;
}

#deford-consult-v1 .dfc-button-icon {
    position: absolute;

    top: 50%;
    right: min(9px, .625vw);

    display: flex;
    align-items: center;
    justify-content: center;

    width: min(62px, 4.3056vw);
    height: min(62px, 4.3056vw);

    border-radius: 50%;

    background: #ffffff;

    transform: translateY(-50%);

    transition: transform .3s ease;
}

#deford-consult-v1 .dfc-button-icon svg {
    width: min(13px, .9028vw);
    height: min(13px, .9028vw);

    fill: none;

    stroke: #111111;
    stroke-width: 1.5;
}

@media (hover:hover) {

    #deford-consult-v1 .dfc-button:hover {
        transform: translateY(-3px);
        background: #111111;
    }

    #deford-consult-v1 .dfc-button:hover .dfc-button-icon {
        transform:
            translateY(-50%)
            rotate(45deg);
    }

}


/* =========================================================
   SOCIALS
   ========================================================= */

#deford-consult-v1 .dfc-socials {
    display: flex;
    align-items: center;

    gap: min(12px, .8333vw);
}

#deford-consult-v1 .dfc-social {
    display: flex;
    align-items: center;
    justify-content: center;

    width: min(62px, 4.3056vw);
    height: min(62px, 4.3056vw);

    flex: 0 0 auto;

    border-radius: 50%;

    background: #ffffff;

    color: var(--blue);

    text-decoration: none;

    transition:
        transform .2s ease,
        opacity .2s ease;
}

#deford-consult-v1 .dfc-social svg {
    display: block;

    width: min(18px, 1.25vw);
    height: min(18px, 1.25vw);

    fill: currentColor;
}

#deford-consult-v1 .dfc-social--max svg {
    width: min(18px, 1.25vw);
    height: min(18px, 1.25vw);
}

#deford-consult-v1 .dfc-social--max svg path {
    fill: currentColor;
}

@media (hover:hover) {

    #deford-consult-v1 .dfc-social:hover {
        transform: translateY(-3px);
    }

}


/* =========================================================
   BOTTOM SPACE
   ========================================================= */

#deford-consult-v1 .dfc-bottom-space {
    height: min(120px, 8.3333vw);
}


