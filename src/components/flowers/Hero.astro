  .fmhero__lead-icon {
    width:
      clamp(
        27px,
        8vw,
        35px
      );

    height:
      clamp(
        27px,
        8vw,
        35px
      );

    flex-basis:
      clamp(
        27px,
        8vw,
        35px
      );
  }

  .fmhero__lead-label {
    font-size:
      clamp(
        7px,
        2vw,
        9px
      );
  }

  .fmhero__lead-title {
    font-size:
      clamp(
        10px,
        2.9vw,
        13px
      );
  }

  .fmhero__lead-count {
    width:17px;
    height:17px;

    right:-5px;
    top:-7px;
  }

  .fmhero__lead--vk {
    left:3%;
    top:10%;
  }

  .fmhero__lead--tg {
    left:0%;
    top:22%;
  }

  .fmhero__lead--ya {
    left:5%;
    top:34%;
  }

}


/* =========================
   SMALL MOBILE
   ========================= */

@media
(max-width:350px) {

  .fmhero__stage {
    padding:
      88px
      12px
      0;
  }

  .fmhero__title {
    font-size:28px;
  }

  .fmhero__visual {
    width:
      calc(
        100% +
        55px
      );

    margin:
      8px
      -28px
      -1px
      auto;
  }

  .fmhero__person {
    left:-5%;

    bottom:-130px;

    width:103%;
  }

}


/* =========================
   REDUCED MOTION
   ========================= */

@media
(prefers-reduced-motion:reduce) {

  .fmhero
  [data-anim],
  .fmhero__lead {
    opacity:1 !important;

    animation:none !important;
  }

  .fmhero__person {
    animation:none !important;

    transform:none !important;
  }

}
</style>

<script is:inline>
(function () {

  document
    .querySelectorAll(
      '.fmhero-mobile-tap-proxy'
    )
    .forEach(
      function (item) {
        item.remove();
      }
    );


  const blocks =
    document.querySelectorAll(
      '[data-fmhero]'
    );


  blocks.forEach(
    function (root) {

      if (
        root.dataset.fmHeroV22Ready ===
        '1'
      ) {
        return;
      }

      root.dataset.fmHeroV22Ready =
        '1';


      const viewport =
        root.querySelector(
          '.fmhero__viewport'
        );


      const track =
        root.querySelector(
          '[data-benefits-track]'
        );


      /* SCALE */

      function updateScale() {

        const width =
          root
            .getBoundingClientRect()
            .width;

        if (
          width <=
          640
        ) {

          root.style.removeProperty(
            '--fm-scale'
          );

          viewport.style.height =
            '';

          return;
        }

        const scale =
          width /
          1200;

        root.style.setProperty(
          '--fm-scale',
          scale
        );

        viewport.style.height =
          Math.round(
            675 *
            scale
          )
          +
          'px';

      }


      updateScale();


      if (
        'ResizeObserver'
        in window
      ) {

        new ResizeObserver(
          updateScale
        )
        .observe(
          root
        );

      } else {

        window.addEventListener(
          'resize',
          updateScale,
          {
            passive:true
          }
        );

      }


      /* BENEFITS LOOP */

      if (
        track
      ) {

        const originals =
          Array.from(
            track.querySelectorAll(
              ':scope > [data-benefit-card]'
            )
          );


        /*
         Защита от повторного клонирования
         при повторном выполнении JS.
        */

        track
          .querySelectorAll(
            '.fmhero__benefit--clone'
          )
          .forEach(
            function (clone) {
              clone.remove();
            }
          );


        const clones =
          originals.map(
            function (card) {

              const clone =
                card.cloneNode(true);

              clone.classList.add(
                'fmhero__benefit--clone'
              );

              clone.setAttribute(
                'aria-hidden',
                'true'
              );

              track.appendChild(
                clone
              );

              return clone;

            }
          );


        let offset =
          0;

        let loopWidth =
          0;

        let last =
          performance.now();

        let visible =
          true;


        const reduced =
          window.matchMedia(
            '(prefers-reduced-motion: reduce)'
          );


        function calculateLoopWidth() {

          if (
            !originals.length
            ||
            !clones.length
          ) {

            loopWidth =
              0;

            return;

          }

          const first =
            originals[0]
              .getBoundingClientRect();

          const clone =
            clones[0]
              .getBoundingClientRect();

          loopWidth =
            clone.left -
            first.left;

        }


        function animate(now) {

          const dt =
            Math.min(
              40,
              now -
              last
            );

          last =
            now;

          if (
            visible
            &&
            !reduced.matches
            &&
            loopWidth >
            0
          ) {

            const speed =
              15;

            offset -=
              speed *
              (
                dt /
                1000
              );

            if (
              -offset >=
              loopWidth
            ) {

              offset +=
                loopWidth;

            }

            track.style.transform =
              'translate3d(' +
              offset.toFixed(3) +
              'px,0,0)';

          }

          requestAnimationFrame(
            animate
          );

        }


        function recalculate() {

          track.style.transform =
            'translate3d(0,0,0)';

          requestAnimationFrame(
            function () {

              calculateLoopWidth();

              if (
                loopWidth
              ) {

                offset %=
                  loopWidth;

              }

              track.style.transform =
                'translate3d(' +
                offset +
                'px,0,0)';

            }
          );

        }


        const visibilityObserver =
          new IntersectionObserver(

            function (entries) {

              entries.forEach(
                function (entry) {

                  visible =
                    entry.isIntersecting;

                }
              );

            },

            {
              threshold:0
            }

          );


        visibilityObserver.observe(
          root
        );


        window.addEventListener(
          'resize',
          recalculate,
          {
            passive:true
          }
        );


        requestAnimationFrame(
          function () {

            calculateLoopWidth();

            last =
              performance.now();

            requestAnimationFrame(
              animate
            );

          }
        );

      }


      /* ENTRANCE */

      const reduceMotion =
        window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        );


      if (
        reduceMotion.matches
      ) {

        root.classList.add(
          'is-visible'
        );

        return;

      }


      const observer =
        new IntersectionObserver(

          function (entries) {

            entries.forEach(
              function (entry) {

                if (
                  !entry.isIntersecting
                ) {
                  return;
                }

                root.classList.add(
                  'is-visible'
                );

                observer.disconnect();

              }
            );

          },

          {
            threshold:.1
          }

        );


      observer.observe(
        root
      );

    }
  );

})();
</script>
