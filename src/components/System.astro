    width: min(357px, 24.7917vw);
}


/* =========================================================
   DARK CARD — EDITABLE IMAGE AREA

   Теперь это отдельный обычный <img>,
   который должен отображаться в Контенте Vibe.
   ========================================================= */

#deford-system-v4 .dfs-dark-image-wrap {
    position: absolute;

    z-index: 2;

    left: min(20px, 1.3889vw);
    right: min(20px, 1.3889vw);
    bottom: 0;

    height: min(178px, 12.3611vw);

    display: flex;
    align-items: flex-end;
    justify-content: center;

    overflow: hidden;
}

#deford-system-v4 .dfs-dark-image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;
    object-position: center bottom;
}


/* subtle gradient so image merges into dark card */

#deford-system-v4 .dfs-dark-image-wrap::after {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    height: 12%;

    background:
