        height: 50px;
    }


    /* CARD */

    #deford-case-v2 .dfc-card {
        width: 100%;
        height: auto;

        min-height:
            clamp(610px,155vw,760px);

        padding:
            clamp(26px,7vw,40px)
            clamp(22px,6vw,34px);

        border-radius:
            clamp(24px,7vw,36px);
    }


    /* METRICS */

    #deford-case-v2 .dfc-metrics {
        position: relative;

        top: auto;
        left: auto;
        right: auto;

        grid-template-columns:
            minmax(0,1fr)
            minmax(0,1fr);

        column-gap:
            clamp(15px,5vw,30px);

        row-gap:
            clamp(32px,8vw,50px);
    }

    #deford-case-v2 .dfc-number {
        font-size:
            clamp(32px,10vw,48px);
    }

    #deford-case-v2 .dfc-metric-text {
