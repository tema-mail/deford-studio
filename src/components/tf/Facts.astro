---
/** «Ошибки в маркетинге, которые не дают вам развиваться» – по макету Figma
    (кадр 3, секция 1440 × 873): тёмная плашка с красным свечением, метка,
    заголовок по центру, лента карточек 385 × 465 с иллюстрациями и стеклянной
    подписью внизу, ниже – белая плашка «Узнайте стоимость продвижения»
    (бывший блок QuizCta, якорь «Расчёт продвижения», кнопка открывает квиз).

    Карточек шесть – факты с оригинала; в макете нарисованы четыре, ещё две
    иллюстрации («90% клиентов», «На связи 24/7») сгенерированы в том же стиле.
    Лента прокручивается свайпом, колесом с Shift и перетаскиванием мышью. */

const facts = [
  { img: 'fact-1', title: 'Комплексный маркетинг', text: 'Закроем любые задачи в сфере диджитл' },
  { img: 'fact-2', title: 'Считаем прибыль', text: 'Считаем прибыль, а не лайки и клики' },
  { img: 'fact-3', title: 'Один день', text: 'Заявки уже в первый день после запуска' },
  { img: 'fact-5', title: '90% клиентов', text: 'Становятся постоянными и работают с нами на протяжении многих лет' },
  { img: 'fact-4', title: 'Работаем по договору', text: 'С предоставлением всех закрывающих документов' },
  { img: 'fact-6', title: 'На связи 24/7', text: 'Поддержка на всех этапах' },
];
---

<section class="tf-section tffacts">
  <div class="tf-panel tf-panel--dark tffacts__panel">
    <header class="tffacts__head" data-reveal>
      <div class="tf-tag tffacts__tag">Ошибки</div>
      <h2 class="tf-h2 tffacts__title">Ошибки в маркетинге, которые не дают вам развиваться</h2>
    </header>

    <div class="tffacts__rail" data-tffacts-rail>
      {
        facts.map((f) => (
          <article class="tffacts__card">
            <img class="tffacts__base" src="/img/tf/fig/fact-base.webp" alt="" width="689" height="1024" loading="lazy" decoding="async" />
            <img class="tffacts__img" src={`/img/tf/fig/${f.img}.webp`} alt="" width="768" height="1024" loading="lazy" decoding="async" />
            <div class="tffacts__caption">
              <h3 class="tffacts__name">{f.title}</h3>
              <p class="tffacts__text">{f.text}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="tffacts__cta" id="Calculation" data-reveal>
      <div class="tffacts__cta-copy">
        <p class="tffacts__cta-title">Узнайте стоимость продвижения именно для вашего бизнеса</p>
        <p class="tffacts__cta-text">Ответьте на 5 вопросов и наш менеджер свяжется с вами в ближайшее время</p>
      </div>
      <a class="tf-btn tf-btn--red tffacts__cta-btn" href="#sendkviz">
        <span>Получить консультацию</span>
        <span class="tf-btn__arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8"></path></svg></span>
      </a>
    </div>
  </div>
</section>

<style is:global>
  .tffacts__panel {
    --f: calc(100cqw / 1440);
    padding: calc(59 * var(--f)) 0 calc(36 * var(--f));
    border-radius: calc(90 * var(--f));
  }

  .tffacts__head { display: flex; flex-direction: column; align-items: center; text-align: center; }

  .tffacts .tffacts__tag {
    padding: calc(8.4 * var(--f)) calc(12 * var(--f));
    border-width: 1.2px;
    font-size: calc(13.2 * var(--f));
    line-height: calc(15.6 * var(--f));
  }

  .tffacts .tffacts__title {
    width: calc(560 * var(--f));
    margin-top: calc(18 * var(--f));
    font-size: calc(39.6 * var(--f));
    line-height: 1;
    letter-spacing: calc(-1.2 * var(--f));
  }

  /* лента карточек: начинается с отступа сетки, уходит за правый край */
  .tffacts__rail {
    display: flex;
    gap: calc(23 * var(--f));
    margin-top: calc(29 * var(--f));
    padding: 0 calc(70 * var(--f));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 calc(70 * var(--f));
    scrollbar-width: none;
    cursor: grab;
  }

  .tffacts__rail::-webkit-scrollbar { display: none; }
  .tffacts__rail.is-drag { cursor: grabbing; scroll-snap-type: none; }

  .tffacts__card {
    position: relative;
    display: flex;
    flex: 0 0 calc(385 * var(--f));
    align-items: flex-end;
    height: calc(465 * var(--f));
    padding: calc(30 * var(--f));
    overflow: hidden;
    border-radius: calc(36 * var(--f));
    scroll-snap-align: start;
    user-select: none;
  }

  .tffacts__base,
  .tffacts__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .tffacts__base { object-fit: cover; object-position: bottom; }
  .tffacts__img { object-fit: cover; }

  .tffacts__caption {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: calc(2.4 * var(--f));
    width: 100%;
    padding: calc(18 * var(--f));
    border-radius: calc(12 * var(--f));
    background: var(--tf-glass);
    -webkit-backdrop-filter: blur(9px);
    backdrop-filter: blur(9px);
  }

  .tffacts__name {
    color: #fff;
    font-size: calc(18 * var(--f));
    line-height: calc(20.4 * var(--f));
    font-weight: 500;
    letter-spacing: calc(-0.6 * var(--f));
  }

  .tffacts__text { color: var(--tf-muted-light); font-size: calc(13.2 * var(--f)); line-height: calc(15.6 * var(--f)); font-weight: 500; }

  /* белая плашка-призыв */
  .tffacts__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(16 * var(--f));
    width: calc(766.8 * var(--f));
    margin: calc(30 * var(--f)) auto 0;
    padding: calc(18 * var(--f));
    border-radius: calc(12 * var(--f));
    background: #fff;
  }

  .tffacts__cta-copy { display: flex; flex-direction: column; gap: calc(2.4 * var(--f)); max-width: calc(305 * var(--f)); }
  .tffacts__cta-title { color: var(--tf-ink); font-size: calc(18 * var(--f)); line-height: calc(20.4 * var(--f)); font-weight: 600; letter-spacing: calc(-0.6 * var(--f)); }
  .tffacts__cta-text { color: #a4a4a4; font-size: calc(13.2 * var(--f)); line-height: calc(15.6 * var(--f)); font-weight: 500; }

  .tffacts .tffacts__cta-btn {
    gap: calc(16.16 * var(--f));
    min-height: calc(65.32 * var(--f));
    padding: calc(6 * var(--f)) calc(6 * var(--f)) calc(6 * var(--f)) calc(30 * var(--f));
    font-size: calc(17.775 * var(--f));
    line-height: calc(19.39 * var(--f));
  }

  .tffacts .tffacts__cta-btn .tf-btn__arrow { width: calc(53.324 * var(--f)); height: calc(53.324 * var(--f)); }

  /* планшет и телефон: размеры в пикселях */
  @media (max-width: 979px) {
    .tffacts__panel { padding: 44px 0 24px; border-radius: 36px; }
    .tffacts .tffacts__tag { padding: 7px 11px; font-size: 12px; line-height: 14px; }
    .tffacts .tffacts__title { width: auto; max-width: 560px; margin-top: 14px; padding: 0 18px; font-size: clamp(26px, 6vw, 36px); letter-spacing: -0.03em; }
    .tffacts__rail { gap: 14px; margin-top: 24px; padding: 0 18px; scroll-padding: 0 18px; }
    .tffacts__card { flex-basis: 280px; height: 340px; padding: 18px; border-radius: 26px; }
    .tffacts__caption { gap: 3px; padding: 14px; border-radius: 12px; }
    .tffacts__name { font-size: 17px; line-height: 20px; letter-spacing: -0.4px; }
    .tffacts__text { font-size: 13px; line-height: 16px; }

    .tffacts__cta { flex-direction: column; align-items: stretch; width: auto; margin: 20px 18px 0; padding: 18px; gap: 16px; }
    .tffacts__cta-copy { max-width: none; gap: 4px; }
    .tffacts__cta-title { font-size: 18px; line-height: 21px; letter-spacing: -0.4px; }
    .tffacts__cta-text { font-size: 13px; line-height: 16px; }
    .tffacts .tffacts__cta-btn { min-height: 56px; padding: 5px 5px 5px 24px; font-size: 15px; line-height: 17px; justify-content: space-between; }
    .tffacts .tffacts__cta-btn .tf-btn__arrow { position: static; transform: none; width: 46px; height: 46px; }
  }
</style>

<script is:inline>
  /* перетаскивание ленты мышью (на тач-экранах – обычная прокрутка) */
  (function () {
    var rail = document.querySelector('[data-tffacts-rail]');
    if (!rail) return;
    var x0 = 0;
    var s0 = 0;
    var down = false;
    function stop() {
      if (!down) return;
      down = false;
      rail.classList.remove('is-drag');
    }
    rail.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true;
      x0 = e.clientX;
      s0 = rail.scrollLeft;
      rail.classList.add('is-drag');
    });
    window.addEventListener('pointermove', function (e) {
      if (!down) return;
      /* кнопку отпустили за окном – перетаскивание заканчивается */
      if (!(e.buttons & 1)) return stop();
      rail.scrollLeft = s0 - (e.clientX - x0);
    });
    window.addEventListener('pointerup', stop);
    window.addEventListener('pointercancel', stop);
    window.addEventListener('blur', stop);
  })();
</script>
