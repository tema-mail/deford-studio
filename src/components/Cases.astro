        left: auto;
        right: auto;
        bottom: auto;

        width: 100%;
        height: auto;

        margin-top:
            clamp(40px,11vw,65px);

        aspect-ratio: 1176 / 458;
    }

    #deford-case-v2 .dfc-gallery-viewport {
