  }


}



/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 350px) {


  .fmfaq__stage {

    padding-left:
      12px;

    padding-right:
      12px;

  }


  .fmfaq__title {

    font-size:
      25px;

  }


}



/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media
(prefers-reduced-motion: reduce) {


  .fmfaq
  [data-faq-anim] {

    opacity:
      1 !important;

    animation:
      none !important;

  }


  .fmfaq__answer,
  .fmfaq__icon-v {

    transition:
      none !important;

  }


}
</style>

<script is:inline>
(function () {


  const roots =
    document.querySelectorAll(
      '[data-fmfaq]'
    );


  roots.forEach(
    function (
      root
    ) {


      if (
        root.dataset.fmFaqReady ===
        '1'
      ) {

        return;

      }


      root.dataset.fmFaqReady =
        '1';



      const viewport =
        root.querySelector(
          '.fmfaq__viewport'
        );


      const stage =
        root.querySelector(
          '.fmfaq__stage'
        );


      const items =
        Array.from(
          root.querySelectorAll(
            '[data-faq-item]'
          )
        );



      /* =====================================================
         ACCORDION

         Одновременно открыт только один пункт.
         ===================================================== */

      items.forEach(
        function (
          item
        ) {


          const button =
            item.querySelector(
              '[data-faq-button]'
            );


          if (!button) {

            return;

          }



          button.addEventListener(
            'click',
            function () {


              const willOpen =
                !item.classList.contains(
                  'is-open'
                );



              items.forEach(
                function (
                  other
                ) {


                  other.classList.remove(
                    'is-open'
                  );


                  const otherButton =
                    other.querySelector(
                      '[data-faq-button]'
                    );


                  if (
                    otherButton
                  ) {


                    otherButton.setAttribute(
                      'aria-expanded',
                      'false'
                    );


                  }


                }
              );



              if (
                willOpen
              ) {


                item.classList.add(
                  'is-open'
                );


                button.setAttribute(
                  'aria-expanded',
                  'true'
                );


              }



              requestAnimationFrame(
                updateDesktopHeight
              );


              setTimeout(
                updateDesktopHeight,
                480
              );


            }
          );


        }
      );



      /* =====================================================
         DESKTOP SCALE + DYNAMIC HEIGHT

         В отличие от предыдущих фиксированных блоков,
         FAQ может увеличиваться при раскрытии ответа.
         ===================================================== */

      function updateDesktopHeight() {


        const width =
          root
            .getBoundingClientRect()
            .width;



        if (
          width <=
          640
        ) {


          root.style.removeProperty(
            '--ff-scale'
          );


          viewport.style.height =
            '';


          return;

        }



        const scale =
          width /
          1200;



        root.style.setProperty(
          '--ff-scale',
          scale
        );



        /*
         * Высота stage зависит от открытого ответа.
         */

        const naturalHeight =
          Math.max(
            945,
            stage.scrollHeight
          );



        viewport.style.height =
          (
            naturalHeight *
            scale
          )
          +
          'px';


      }



      updateDesktopHeight();



      window.addEventListener(
        'resize',
        updateDesktopHeight,
        {
          passive:
            true
        }
      );



      if (
        'ResizeObserver'
        in window
      ) {


        const ro =
          new ResizeObserver(
            updateDesktopHeight
          );


        ro.observe(
          stage
        );


      }



      /* =====================================================
         ENTRY
         ===================================================== */

      const reduced =
        window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        )
        .matches;



      if (
        reduced
      ) {


        root.classList.add(
          'is-visible'
        );


        return;

      }



      const observer =
        new IntersectionObserver(

          function (
            entries
          ) {


            entries.forEach(
              function (
                entry
              ) {


                if (
                  !entry.isIntersecting
                ) {

                  return;

                }


                root.classList.add(
                  'is-visible'
                );


                observer.disconnect();


              }
            );


          },

          {
            threshold:
              .08
          }

        );


      observer.observe(
        root
      );


    }
  );


})();
</script>
