    flex-basis:94vw;

    width:94vw;

    height:76vw;
  }


}



/* REDUCED MOTION */

@media
(prefers-reduced-motion:reduce) {


  .fm-errors__title-line > span {
    transform:none !important;

    opacity:1 !important;

    animation:none !important;
  }


  .fm-errors__card {
    opacity:1 !important;

    scale:1 !important;

    animation:none !important;

    transition:none !important;
  }


}
</style>

<script is:inline>
(function () {


  const sections =
    document.querySelectorAll(
      '[data-fm-errors]'
    );


  sections.forEach(
    function (root) {


      if (
        root.dataset.fmErrorsReady ===
        '1'
      ) {

        return;

      }


      root.dataset.fmErrorsReady =
        '1';



      const shell =
        root.querySelector(
          '.fm-errors__scroll-shell'
        );


      const sticky =
        root.querySelector(
          '.fm-errors__sticky'
        );


      const viewport =
        root.querySelector(
          '.fm-errors__viewport'
        );


      const wheel =
        root.querySelector(
          '[data-errors-wheel]'
        );


      const mobile =
        root.querySelector(
          '.fm-errors__mobile'
        );


      const dotsWrap =
        root.querySelector(
          '[data-errors-dots]'
        );



      const BASE_WIDTH =
        1200;


      const BASE_HEIGHT =
        675;


      const BASE_SCROLL_RANGE =
        700;


      const START_ROTATION =
        30;


      const END_ROTATION =
        -150;



      let scale =
        1;


      let targetRotation =
        START_ROTATION;


      let currentRotation =
        START_ROTATION;


      let lastDesktop =
        null;



      const reduceMotion =
        window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        );



      /* TILDA EDITOR */

      function isTildaEditor() {


        const body =
          document.body;


        const html =
          document.documentElement;


        return (

          body.classList.contains(
            't-body_edit'
          )

          ||

          body.classList.contains(
            'tilda-mode-edit'
          )

          ||

          html.classList.contains(
            'tilda-mode-edit'
          )

          ||

          !!document.querySelector(
            '.t-edit-toolbar'
          )

        );


      }



      /* MOBILE PAGINATION */

      if (
        mobile
        &&
        dotsWrap
      ) {


        const mobileCards =
          Array.from(
            mobile.querySelectorAll(
              '.fm-errors__mobile-card'
            )
          );


        const dots =
          mobileCards.map(
            function (card, index) {


              const dot =
                document.createElement(
                  'button'
                );


              dot.type =
                'button';


              dot.className =
                'fm-errors__mobile-dot';


              dot.setAttribute(
                'aria-label',
                'Показать карточку ' +
                (index + 1)
              );


              dot.addEventListener(
                'click',
                function () {


                  const maxLeft =
                    Math.max(
                      0,
                      mobile.scrollWidth -
                      mobile.clientWidth
                    );


                  const targetLeft =
                    Math.max(
                      0,
                      Math.min(
                        maxLeft,
                        card.offsetLeft -
                        (
                          mobile.clientWidth -
                          card.offsetWidth
                        ) /
                        2
                      )
                    );


                  mobile.scrollTo({
                    left:targetLeft,
                    behavior:
                      reduceMotion.matches
                      ? 'auto'
                      : 'smooth'
                  });


                }
              );


              dotsWrap.appendChild(
                dot
              );


              return dot;


            }
          );


        let dotsTicking =
          false;


        function updateMobileDots() {


          dotsTicking =
            false;


          if (
            !mobileCards.length
          ) {

            return;

          }


          const center =
            mobile.scrollLeft +
            mobile.clientWidth /
            2;


          let activeIndex =
            0;


          let minDistance =
            Infinity;


          mobileCards.forEach(
            function (card, index) {


              const cardCenter =
                card.offsetLeft +
                card.offsetWidth /
                2;


              const distance =
                Math.abs(
                  cardCenter -
                  center
                );


              if (
                distance <
                minDistance
              ) {


                minDistance =
                  distance;


                activeIndex =
                  index;


              }


            }
          );


          dots.forEach(
            function (dot, index) {


              const active =
                index ===
                activeIndex;


              dot.classList.toggle(
                'is-active',
                active
              );


              if (
                active
              ) {


                dot.setAttribute(
                  'aria-current',
                  'true'
                );


              } else {


                dot.removeAttribute(
                  'aria-current'
                );


              }


            }
          );


        }


        function requestDotsUpdate() {


          if (
            dotsTicking
          ) {

            return;

          }


          dotsTicking =
            true;


          requestAnimationFrame(
            updateMobileDots
          );


        }


        mobile.addEventListener(
          'scroll',
          requestDotsUpdate,
          {
            passive:true
          }
        );


        window.addEventListener(
          'resize',
          requestDotsUpdate,
          {
            passive:true
          }
        );


        requestAnimationFrame(
          updateMobileDots
        );


      }



      /* LAYOUT */

      function updateLayout() {


        const width =
          root
            .getBoundingClientRect()
            .width;


        const desktop =
          width >
          640;


        if (
          lastDesktop !==
          desktop
        ) {

          lastDesktop =
            desktop;

        }



        if (
          !desktop
        ) {


          scale =
            1;


          root.style.removeProperty(
            '--fm-errors-scale'
          );


          shell.style.height =
            'auto';


          sticky.style.height =
            'auto';


          viewport.style.height =
            'auto';


          wheel.style.transform =
            'rotate(' +
            START_ROTATION +
            'deg)';


          return;

        }



        scale =
          width /
          BASE_WIDTH;


        root.style.setProperty(
          '--fm-errors-scale',
          scale
        );


        const visibleHeight =
          BASE_HEIGHT *
          scale;



        if (
          isTildaEditor()
        ) {


          shell.style.height =
            visibleHeight +
            'px';


          sticky.style.height =
            visibleHeight +
            'px';


          viewport.style.height =
            visibleHeight +
            'px';


          targetRotation =
            START_ROTATION;


          currentRotation =
            START_ROTATION;


          wheel.style.transform =
            'rotate(' +
            START_ROTATION +
            'deg)';


          return;

        }



        const scrollRange =
          BASE_SCROLL_RANGE *
          scale;


        shell.style.height =
          (
            visibleHeight +
            scrollRange
          )
          +
          'px';


        sticky.style.height =
          visibleHeight +
          'px';


        viewport.style.height =
          visibleHeight +
          'px';


      }



      /* SCROLL PROGRESS */

      function updateTargetFromScroll() {


        if (
          window.innerWidth <=
          640

          ||

          isTildaEditor()

          ||

          reduceMotion.matches
        ) {


          targetRotation =
            START_ROTATION;


          return;

        }



        const shellRect =
          shell
            .getBoundingClientRect();


        const stickyHeight =
          BASE_HEIGHT *
          scale;


        const totalRange =
          Math.max(
            1,
            shell.offsetHeight -
            stickyHeight
          );


        const travelled =
          Math.max(
            0,
            -shellRect.top
          );


        const progress =
          Math.max(
            0,
            Math.min(
              1,
              travelled /
              totalRange
            )
          );


        targetRotation =
          START_ROTATION +
          (
            END_ROTATION -
            START_ROTATION
          )
          *
          progress;


      }



      /* SOFT WHEEL */

      function animateWheel() {


        requestAnimationFrame(
          animateWheel
        );


        if (
          window.innerWidth <=
          640

          ||

          isTildaEditor()
        ) {


          currentRotation =
            START_ROTATION;


          wheel.style.transform =
            'rotate(' +
            START_ROTATION +
            'deg)';


          return;

        }



        if (
          reduceMotion.matches
        ) {


          currentRotation =
            START_ROTATION;


          wheel.style.transform =
            'rotate(' +
            START_ROTATION +
            'deg)';


          return;

        }



        const follow =
          .105;


        currentRotation +=
          (
            targetRotation -
            currentRotation
          )
          *
          follow;



        if (
          Math.abs(
            targetRotation -
            currentRotation
          )
          <
          .001
        ) {


          currentRotation =
            targetRotation;


        }



        wheel.style.transform =
          'rotate(' +
          currentRotation.toFixed(4) +
          'deg)';


      }



      let scrollTicking =
        false;


      function onScroll() {


        if (
          scrollTicking
        ) {

          return;

        }


        scrollTicking =
          true;


        requestAnimationFrame(
          function () {


            updateTargetFromScroll();


            scrollTicking =
              false;


          }
        );


      }



      function onResize() {


        updateLayout();

        updateTargetFromScroll();


      }



      window.addEventListener(
        'scroll',
        onScroll,
        {
          passive:true
        }
      );


      window.addEventListener(
        'resize',
        onResize,
        {
          passive:true
        }
      );



      if (
        'ResizeObserver'
        in window
      ) {


        const ro =
          new ResizeObserver(
            function () {


              updateLayout();

              updateTargetFromScroll();


            }
          );


        ro.observe(
          root
        );


      }



      function onMotionPreference() {


        if (
          reduceMotion.matches
        ) {


          targetRotation =
            START_ROTATION;


          currentRotation =
            START_ROTATION;


          wheel.style.transform =
            'rotate(' +
            START_ROTATION +
            'deg)';


        } else {


          updateTargetFromScroll();


        }


      }



      if (
        reduceMotion.addEventListener
      ) {


        reduceMotion.addEventListener(
          'change',
          onMotionPreference
        );


      }



      updateLayout();

      updateTargetFromScroll();


      wheel.style.transform =
        'rotate(' +
        START_ROTATION +
        'deg)';


      requestAnimationFrame(
        function () {


          root.classList.add(
            'is-ready'
          );


        }
      );


      animateWheel();


    }
  );


})();
</script>
