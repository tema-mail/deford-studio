---
/**
 * Фиксированная прозрачная шапка.
 * Оригинал: блок rec4116082401 (Тильда).
 *
 * Якоря меню ведут на id секций оригинала (rec…),
 * поэтому корневые элементы секций их сохраняют.
 */
const TELEGRAM = 'https://t.me/Artem1Galimov';
const MAX =
  'https://max.ru/u/f9LHodD0cOKS6C3PPXRh8eHyRKrJiSTUcpsOsnbQDl6Cp3LSE-Xu-dNig7c';

const navLinks = [
  { href: '#top', label: 'Главная' },
  { href: '#rec4124751801', label: 'Почему мы' },
  { href: '#rec4126606901', label: 'Как мы работаем' },
  { href: '#rec4136994401', label: 'Контакты' },
];

const mobileLinks = [
  { href: '#top', label: 'Главная' },
  { href: '#about', label: 'О нас' },
  { href: '#cases', label: 'Как мы работаем' },
  { href: '#reviews', label: 'Отзывы' },
  { href: '#advantages', label: 'Наши преимущества' },
  { href: '#contacts', label: 'Контакты' },
];
---

<header class="fm-header" data-fm-header>
  <div class="fm-header__inner">
    <div class="fm-header__socials">
      <a
        class="fm-header__social"
        href={TELEGRAM}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Telegram"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M19.8 4.4L16.9 18c-.2 1-.8 1.2-1.6.7l-4.4-3.2-2.1 2c-.2.2-.4.4-.8.4l.3-4.5 8.2-7.4c.4-.3-.1-.5-.5-.2L5.9 12.2l-4.4-1.4c-1-.3-1-1 .2-1.5L18.9 2.7c.8-.3 1.5.2.9 1.7Z"
            fill="currentColor"></path>
        </svg>
      </a>

      <a
        class="fm-header__social fm-header__social--max"
        href={MAX}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="MAX"
      >
        <svg class="fm-header__max-icon" viewBox="0 0 48 48" aria-hidden="true">
          <path
            fill="currentColor"
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M24 4.5C13.2 4.5 4.5 12.7 4.5 22.9c0 4.1 1.3 7.9 3.6 11L6.6 40c-.4 1.7 1.3 3.1 2.9 2.4l6.4-2.7c2.5 1.1 5.2 1.7 8.1 1.7 10.8 0 19.5-8.2 19.5-18.5S34.8 4.5 24 4.5Zm0 9.1c5.6 0 10.1 4.1 10.1 9.3 0 5.1-4.5 9.3-10.1 9.3-2.2 0-4.3-.7-6-1.9l-3.7 1.5.9-3.8c-.9-1.5-1.3-3.2-1.3-5.1 0-5.2 4.5-9.3 10.1-9.3Z"
          ></path>
        </svg>
      </a>
    </div>

    <div class="fm-header__nav-wrap">
      <nav class="fm-header__nav" aria-label="Основная навигация">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>

    <div class="fm-header__cta">
      <a class="fm-header__cta-button" href="#zeropopup">Рассчитать стоимость</a>
    </div>

    <button
      class="fm-header__burger"
      type="button"
      aria-label="Открыть меню"
      aria-expanded="false"
      data-header-burger
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="fm-header__mobile" data-header-mobile>
    <div class="fm-header__mobile-inner">
      <nav class="fm-header__mobile-nav" aria-label="Мобильная навигация">
        {mobileLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>

      <a class="fm-header__mobile-cta" href="#zeropopup">
        <span class="fm-header__mobile-cta-label">Рассчитать стоимость</span>
        <span class="fm-header__mobile-cta-icon">
          <svg viewBox="0 0 44 44" aria-hidden="true">
            <circle cx="22" cy="22" r="22" fill="#202020"></circle>
            <path
              d="M17 27L27 17M20 17H27V24"
              fill="none"
              stroke="#0F68FF"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </a>

      <div class="fm-header__mobile-socials">
        <a href={TELEGRAM} target="_blank" rel="noopener noreferrer">Telegram</a>
        <a href={MAX} target="_blank" rel="noopener noreferrer">MAX</a>
      </div>
    </div>
  </div>
</header>

<style>
  .fm-header {
    --fmh-dark: #202020;
    --fmh-accent: #0f68ff;

    position: fixed;
    z-index: 999999;
    left: 0;
    top: 0;
    width: 100%;
    margin: 0;
    padding: 0;
    background: transparent;
    /* Внешний fixed-контейнер не перехватывает клики по странице */
    pointer-events: none;
    font-family: 'Inter Tight', Inter, Arial, sans-serif;
  }

  .fm-header__inner {
    position: relative;
    width: 100%;
    min-height: 92px;
    padding: 16px clamp(18px, 3vw, 42px);
    display: grid;
    grid-template-columns: 150px 1fr 260px;
    align-items: center;
    gap: 24px;
    background: transparent;
    /* Клики принимает только видимая область шапки */
    pointer-events: auto;
  }

  /* ===== Соцсети ===== */

  .fm-header__socials {
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .fm-header__social {
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #000;
    color: #fff;
    text-decoration: none;
    transition:
      background-color 0.28s ease,
      color 0.28s ease,
      transform 0.28s ease;
  }

  .fm-header__social svg {
    width: 20px;
    height: 20px;
    pointer-events: none;
  }

  .fm-header__social .fm-header__max-icon {
    width: 22px;
    height: 22px;
  }

  /* ===== Навигационная пилюля ===== */

  .fm-header__nav-wrap {
    justify-self: center;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 100px;
    background: var(--fmh-dark);
  }

  .fm-header__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(24px, 2.4vw, 38px);
    white-space: nowrap;
  }

  .fm-header__nav a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    line-height: 17px;
    font-weight: 600;
    transition: color 0.25s ease;
  }

  /* ===== CTA ===== */

  .fm-header__cta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
  }

  .fm-header__cta-button {
    min-height: 44px;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 100px;
    background: var(--fmh-accent);
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    font-size: 14px;
    line-height: 17px;
    font-weight: 700;
    transition: transform 0.28s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .fm-header__social:hover {
      background: var(--fmh-accent);
      color: #fff;
      transform: translateY(-2px);
    }

    .fm-header__nav a:hover {
      color: var(--fmh-accent);
    }

    .fm-header__cta:hover .fm-header__cta-button {
      transform: translateY(-2px);
    }
  }

  /* ===== Бургер ===== */

  .fm-header__burger {
    position: relative;
    display: none;
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--fmh-dark);
    cursor: pointer;
    pointer-events: auto;
  }

  .fm-header__burger span {
    position: absolute;
    left: 14px;
    width: 20px;
    height: 2px;
    border-radius: 10px;
    background: #fff;
    pointer-events: none;
    transition:
      top 0.3s ease,
      transform 0.3s ease,
      opacity 0.3s ease,
      background-color 0.3s ease;
  }

  .fm-header__burger span:nth-child(1) {
    top: 16px;
  }

  .fm-header__burger span:nth-child(2) {
    top: 23px;
  }

  .fm-header__burger span:nth-child(3) {
    top: 30px;
  }

  .fm-header.is-open .fm-header__burger {
    background: var(--fmh-accent);
  }

  .fm-header.is-open .fm-header__burger span:nth-child(1) {
    top: 23px;
    transform: rotate(45deg);
  }

  .fm-header.is-open .fm-header__burger span:nth-child(2) {
    opacity: 0;
  }

  .fm-header.is-open .fm-header__burger span:nth-child(3) {
    top: 23px;
    transform: rotate(-45deg);
  }

  /* ===== Мобильное меню ===== */

  .fm-header__mobile {
    display: none;
  }

  /* ===== Планшет ===== */

  @media (max-width: 1100px) and (min-width: 641px) {
    .fm-header__inner {
      grid-template-columns: 100px 1fr 210px;
      gap: 12px;
      padding-left: 20px;
      padding-right: 20px;
    }

    .fm-header__nav-wrap {
      padding: 0 14px;
    }

    .fm-header__nav {
      gap: 16px;
    }

    .fm-header__nav a {
      font-size: 12px;
    }

    .fm-header__cta-button {
      padding: 0 15px;
      font-size: 12px;
    }
  }

  /* ===== Мобильные 300–640 ===== */

  @media (max-width: 640px) {
    .fm-header {
      transition: background 0.2s ease;
    }

    .fm-header__inner {
      position: relative;
      min-height: 76px;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    /* За пределами первого экрана шапка становится читаемой панелью */
    .fm-header.is-scrolled .fm-header__inner {
      background: rgba(255, 255, 255, 0.94);
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.07);
      backdrop-filter: blur(12px);
    }

    .fm-header__social {
      width: 46px;
      height: 46px;
      flex-basis: 46px;
    }

    .fm-header__nav-wrap,
    .fm-header__cta {
      display: none;
    }

    .fm-header__burger {
      display: block;
    }

    /* Закрытая панель полностью выключена из click/touch */
    .fm-header__mobile {
      position: absolute;
      left: 12px;
      right: 12px;
      top: 76px;
      display: block;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-12px);
      transition:
        opacity 0.25s ease,
        transform 0.35s cubic-bezier(0.2, 0.75, 0.25, 1),
        visibility 0s linear 0.35s;
    }

    .fm-header.is-open .fm-header__mobile {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
      transition:
        opacity 0.25s ease,
        transform 0.35s cubic-bezier(0.2, 0.75, 0.25, 1),
        visibility 0s;
    }

    .fm-header__mobile-inner {
      width: 100%;
      padding: 18px;
      border-radius: 26px;
      background: var(--fmh-dark);
    }

    .fm-header__mobile-nav {
      display: flex;
      flex-direction: column;
    }

    .fm-header__mobile-nav a {
      min-height: 48px;
      display: flex;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      color: #fff;
      text-decoration: none;
      font-size: 18px;
      line-height: 1;
      font-weight: 600;
    }

    .fm-header__mobile-cta {
      position: relative;
      width: 100%;
      min-height: 55px;
      margin-top: 18px;
      padding: 5px 55px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 100px;
      background: var(--fmh-accent);
      color: #fff;
      text-decoration: none;
      font-size: 14px;
      line-height: 16px;
      font-weight: 700;
    }

    .fm-header__mobile-cta-label {
      width: 100%;
      text-align: center;
      pointer-events: none;
    }

    /* Иконку не нажимаем — клик принимает вся ссылка */
    .fm-header__mobile-cta-icon {
      position: absolute;
      right: 5px;
      top: 50%;
      width: 44px;
      height: 44px;
      transform: translateY(-50%);
      pointer-events: none;
    }

    .fm-header__mobile-cta-icon svg {
      width: 100%;
      height: 100%;
    }

    .fm-header__mobile-socials {
      margin-top: 18px;
      display: flex;
      gap: 20px;
    }

    .fm-header__mobile-socials a {
      min-height: 44px;
      display: flex;
      align-items: center;
      color: rgba(255, 255, 255, 0.5);
      text-decoration: none;
      font-size: 13px;
    }
  }

  .fm-header a:focus-visible,
  .fm-header button:focus-visible {
    outline: 2px solid var(--fmh-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .fm-header *,
    .fm-header *::before,
    .fm-header *::after {
      transition: none !important;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-fm-header]');
  const burger = root?.querySelector<HTMLButtonElement>('[data-header-burger]');
  const mobile = root?.querySelector<HTMLElement>('[data-header-mobile]');

  if (root && burger && mobile) {
    const setOpen = (open: boolean) => {
      root.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
    };

    burger.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      setOpen(!root.classList.contains('is-open'));
    });

    mobile.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (!root.classList.contains('is-open')) return;
      if (root.contains(event.target as Node)) return;
      setOpen(false);
    });

    window.addEventListener(
      'resize',
      () => {
        if (window.innerWidth > 640) setOpen(false);
      },
      { passive: true },
    );

    /* Состояние «отскроллено» для мобильной панели */
    const syncScrolled = () => {
      root.classList.toggle('is-scrolled', window.scrollY > 80);
    };

    window.addEventListener('scroll', syncScrolled, { passive: true });
    syncScrolled();
  }
</script>
