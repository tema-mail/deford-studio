</style>

<script is:inline>
(function () {


  const sections =
    document.querySelectorAll(
      '[data-fmreviews]'
    );


  sections.forEach(
    function (root) {


      if (
        root.dataset.fmReviewsReady ===
        '1'
      ) {

        return;

      }


      root.dataset.fmReviewsReady =
        '1';



      const viewport =
        root.querySelector(
          '.fmreviews__viewport'
        );


      const rail =
        root.querySelector(
          '[data-reviews-rail]'
        );



      /* =====================================================
         TILDA EDITOR
         ===================================================== */

      function isTildaEditor() {


        const body =
          document.body;


        const html =
          document.documentElement;


        return (

          body.classList.contains(
            't-body_edit'
          )

          ||

          body.classList.contains(
            'tilda-mode-edit'
          )

          ||

          html.classList.contains(
            'tilda-mode-edit'
          )

          ||

          !!document.querySelector(
            '.t-edit-toolbar'
          )

        );


      }



      /* =====================================================
         AUTOSCALE
         ===================================================== */

      function updateScale() {


        const width =
          root
            .getBoundingClientRect()
            .width;


        if (
          width <=
          640
        ) {


          root.style.removeProperty(
            '--fr-scale'
          );


          viewport.style.height =
            '';


          return;

        }



        const scale =
          width /
          1200;


        root.style.setProperty(
          '--fr-scale',
          scale
        );


        viewport.style.height =
          Math.round(
            720 *
            scale
          )
          +
          'px';


      }



      updateScale();



      if (
        'ResizeObserver'
        in window
      ) {


        new ResizeObserver(
          updateScale
        )
        .observe(
          root
        );


      } else {


        window.addEventListener(
          'resize',
          updateScale,
          {
            passive:
              true
          }
        );


      }



      /* =====================================================
         VIDEO CONTROL
         ===================================================== */

      let activeCard =
        null;


      let videoPaused =
        false;


      let hoverPaused =
        false;



      function getBaseSrc(
        frame
      ) {


        return (
          frame.dataset.baseSrc ||
          frame.src ||
          ''
        );


      }



      function addAutoplay(
        url
      ) {


        try {


          const parsed =
            new URL(
              url
            );


          parsed.searchParams.set(
            'autoplay',
            '1'
          );


          parsed.searchParams.set(
            'preload',
            '0'
          );


          return parsed.toString();


        } catch (
          error
        ) {


          return (
            url +
            (
              url.indexOf('?') >
              -1
              ?
              '&'
              :
              '?'
            )
            +
            'autoplay=1'
          );


        }


      }



      function closeVideo(
        card,
        resume
      ) {


        if (
          !card
        ) {

          return;

        }


        const frame =
          card.querySelector(
            '[data-review-frame]'
          );


        if (
          frame
        ) {


          const base =
            getBaseSrc(
              frame
            );


          /*
           * Сначала очищаем iframe,
           * чтобы видео точно остановилось.
           */

          frame.src =
            'about:blank';


          requestAnimationFrame(
            function () {


              frame.src =
                base;


            }
          );


        }


        card.classList.remove(
          'is-active'
        );


        if (
          activeCard ===
          card
        ) {


          activeCard =
            null;


        }


        if (
          resume !==
          false
        ) {


          videoPaused =
            false;


        }


      }



      function openVideo(
        card
      ) {


        if (
          activeCard &&
          activeCard !==
          card
        ) {


          closeVideo(
            activeCard,
            false
          );


        }


        const frame =
          card.querySelector(
            '[data-review-frame]'
          );


        if (
          !frame
        ) {

          return;

        }


        activeCard =
          card;


        videoPaused =
          true;


        card.classList.add(
          'is-active'
        );


        frame.src =
          addAutoplay(
            getBaseSrc(
              frame
            )
          );


      }



      root
        .querySelectorAll(
          '[data-review-card]'
        )
        .forEach(
          function (card) {


            const play =
              card.querySelector(
                '[data-review-play]'
              );


            const close =
              card.querySelector(
                '[data-review-close]'
              );


            if (
              play
            ) {


              play.addEventListener(
                'click',
                function (
                  event
                ) {


                  event.preventDefault();

                  event.stopPropagation();


                  openVideo(
                    card
                  );


                }
              );


            }


            if (
              close
            ) {


              close.addEventListener(
                'click',
                function (
                  event
                ) {


                  event.preventDefault();

                  event.stopPropagation();


                  closeVideo(
                    card,
                    true
                  );


                }
              );


            }


          }
        );



      /* =====================================================
         HOVER PAUSE
         ===================================================== */

      rail.addEventListener(
        'mouseenter',
        function () {


          hoverPaused =
            true;


        }
      );


      rail.addEventListener(
        'mouseleave',
        function () {


          hoverPaused =
            false;


        }
      );



      /* =====================================================
         ENTRANCE
         ===================================================== */

      const reduceMotion =
        window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        );



      if (
        reduceMotion.matches ||
        isTildaEditor()
      ) {


        root.classList.add(
          'is-visible'
        );


      } else {


        const observer =
          new IntersectionObserver(

            function (
              entries
            ) {


              entries.forEach(
                function (
                  entry
                ) {


                  if (
                    !entry.isIntersecting
                  ) {

                    return;

                  }


                  root.classList.add(
                    'is-visible'
                  );


                  observer.disconnect();


                }
              );


            },

            {
              threshold:
                .1
            }

          );


        observer.observe(
          root
        );


      }



      /* =====================================================
         CONTINUOUS RAIL
         
         Без дублей iframe.
         Когда карточка полностью ушла влево,
         она переносится в конец.
         ===================================================== */

      let position =
        0;


      let lastTime =
        performance.now();


      let visible =
        true;


      let cardStep =
        224;



      function calculateStep() {


        const first =
          rail.querySelector(
            '[data-review-card]'
          );


        if (
          !first
        ) {

          return;

        }


        const width =
          first
            .getBoundingClientRect()
            .width;


        const styles =
          window.getComputedStyle(
            rail
          );


        const gap =
          parseFloat(
            styles.columnGap ||
            styles.gap ||
            0
          );


        cardStep =
          width +
          gap;


      }



      calculateStep();



      function animate(
        now
      ) {


        const dt =
          Math.min(
            40,
            now -
            lastTime
          );


        lastTime =
          now;



        if (
          visible

          &&

          !reduceMotion.matches

          &&

          !isTildaEditor()

          &&

          !videoPaused

          &&

          !hoverPaused
        ) {


          const speed =
            window.innerWidth <=
            640
            ?
            18
            :
            22;


          position -=
            speed *
            (
              dt /
              1000
            );



          while (
            -position >=
            cardStep
          ) {


            const first =
              rail.firstElementChild;


            if (
              !first
            ) {

              break;

            }


            rail.appendChild(
              first
            );


            position +=
              cardStep;


          }



          rail.style.transform =
            'translate3d(' +
            position.toFixed(3) +
            'px,0,0)';


        }



        requestAnimationFrame(
          animate
        );


      }



      /* =====================================================
         VISIBILITY
         ===================================================== */

      const railObserver =
        new IntersectionObserver(

          function (
            entries
          ) {


            entries.forEach(
              function (
                entry
              ) {


                visible =
                  entry.isIntersecting;


              }
            );


          },

          {
            threshold:
              0
          }

        );


      railObserver.observe(
        root
      );



      /* =====================================================
         RESIZE
         ===================================================== */

      window.addEventListener(
        'resize',
        function () {


          calculateStep();


        },
        {
          passive:
            true
        }
      );



      /* =====================================================
         INIT
         ===================================================== */

      requestAnimationFrame(
        function () {


          calculateStep();


          lastTime =
            performance.now();


          requestAnimationFrame(
            animate
          );


        }
      );


    }
  );


})();
</script>
