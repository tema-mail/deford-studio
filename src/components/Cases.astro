    transition:
        transform .2s ease,
        opacity .2s ease;
}

#deford-case-v2 .dfc-nav svg {
    display: block;

    width: min(9px, .625vw);
    height: min(9px, .625vw);

    fill: none;
    stroke: #ffffff;

    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
}


/* prev */

#deford-case-v2 .dfc-nav-prev {
    left: min(-19px, -1.3194vw);
}

#deford-case-v2 .dfc-nav-prev svg {
    transform: rotate(180deg);
}


/* next */

#deford-case-v2 .dfc-nav-next {
    right: min(-19px, -1.3194vw);
}


@media (hover:hover) {

    #deford-case-v2 .dfc-nav:hover {
        transform:
            translateY(-50%)
            scale(1.08);
    }

}


/* disabled */

#deford-case-v2 .dfc-nav.is-disabled {
    opacity: .3;

    pointer-events: none;
}


/* =========================================================
   DOTS
   ========================================================= */

#deford-case-v2 .dfc-dots {
    position: absolute;

    z-index: 12;

    left: 50%;
    bottom: min(10px, .6944vw);

    display: flex;
    align-items: center;
    justify-content: center;

    gap: min(6px, .4167vw);

    transform: translateX(-50%);
}

#deford-case-v2 .dfc-dot {
    width: min(6px, .4167vw);
    height: min(6px, .4167vw);

    padding: 0;

    border: 0;
    border-radius: 50%;

    background:
        rgba(255,255,255,.55);

    cursor: pointer;

    box-shadow:
        0 1px 3px
        rgba(0,0,0,.15);

    transition:
        width .25s ease,
        border-radius .25s ease,
        background-color .25s ease;
}

#deford-case-v2 .dfc-dot.is-active {
    width: min(19px, 1.3194vw);

    border-radius: 999px;

    background: #ffffff;
}


/* hide controls if only 1 image */

#deford-case-v2
.dfc-gallery.is-single
.dfc-nav,

#deford-case-v2
.dfc-gallery.is-single
.dfc-dots {
    display: none;
}


/* =========================================================
   COUNTER
   ========================================================= */

#deford-case-v2 .dfc-counter {
    position: absolute;

    z-index: 12;

    right: min(12px, .8333vw);
    top: min(12px, .8333vw);

    display: flex;
    align-items: center;

    min-width: min(42px, 2.9167vw);
    height: min(25px, 1.7361vw);

    padding:
        0
        min(9px, .625vw);

    border-radius: 999px;

    background:
        rgba(26,26,28,.62);

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);

    font-size: min(11px, .7639vw);

    color: #ffffff;

    line-height: 1;

    justify-content: center;
}

#deford-case-v2
.dfc-gallery.is-single
.dfc-counter {
    display: none;
}


/* =========================================================
   BOTTOM SPACE
   ========================================================= */

#deford-case-v2 .dfc-bottom-space {
    height: min(190px, 13.1944vw);
}


/* =========================================================
   MOBILE 300–640px
   ========================================================= */

@media screen and (max-width:640px) {

    #deford-case-v2 .dfc-container {
        padding-left:
            clamp(16px,5vw,28px);

        padding-right:
            clamp(16px,5vw,28px);
    }


    #deford-case-v2 .dfc-layout {
        display: flex;
        flex-direction: column;

        gap:
            clamp(38px,10vw,60px);
    }


    /* LEFT */

    #deford-case-v2 .dfc-left {
        width: 100%;
        height: auto;
    }

    #deford-case-v2 .dfc-title {
        width: 100%;
        max-width: 600px;

        font-size:
            clamp(40px,11.5vw,62px);

        line-height: .94;

        letter-spacing:
            -.055em;
    }

    #deford-case-v2 .dfc-description {
