---
/** Админка → Заявки. Доска по этапам – остров islands/admin/Orders (режим leads),
    перенесён с кабинета ALEX KROWN.

    Своего приёмника у сайта нет: все пять форм отправляют данные напрямую
    в Тильду (forms.tildacdn.com). Поэтому живых заявок здесь пока нет,
    а показан пример с настоящих форм сайта – он подписан «пример». */

import Admin from '../../layouts/Admin.astro';
import Orders, { type Lead } from '../../islands/admin/Orders';

const at = (d: number, h: number) => new Date(Date.UTC(2026, 9, d, h)).toISOString();

/* Формы сайта: «Оставьте заявку» на главной, форма цветочного лендинга,
   три формы тарифов Target Factory и квиз. Источники – каналы, которые
   действительно есть в Метрике Deford. */
const sample: Lead[] = [
  {
    id: 'L-1016-01',
    createdAt: at(16, 9),
    name: 'Пример: Ирина',
    phone: '+7 900 000-00-11',
    form: 'Оставьте заявку (главная)',
    page: '/',
    message: 'Задача: нужен сайт и реклама под студию',
    stage: 'новая',
    source: 'Прямые заходы',
  },
  {
    id: 'L-1015-02',
    createdAt: at(15, 12),
    name: 'Пример: Максим',
    phone: '+7 900 000-00-12',
    form: 'Настройка таргетированной рекламы (тариф)',
    page: '/targetfactory/',
    message: 'Бюджет до 50 000 ₽, ниша – автосервис',
    stage: 'в работе',
    source: 'Поиск Яндекса',
  },
  {
    id: 'L-1014-03',
    createdAt: at(14, 7),
    name: 'Пример: Алёна',
    phone: '+7 900 000-00-13',
    form: 'Квиз «Рассчитать стоимость»',
    page: '/targetfactory/',
    message: 'Прошла квиз: 5 шагов, просит расчёт',
    stage: 'выполнена',
    source: 'Переходы с сайтов',
  },
];
---

<Admin title="Заявки" active="leads">
  <div class="demo-note">
    <span>⚠</span>
    <div>
      Живых заявок здесь пока нет: все формы сайта отправляют данные напрямую
      в Тильду, своего приёмника у копии нет. Ниже – пример с настоящих форм,
      чтобы видеть, как раздел выглядит в работе. Чтобы заявки попадали сюда,
      нужен свой приёмник или доступ к проекту Тильды, который их принимает.
    </div>
  </div>

  <Orders client:load mode="leads" orders={[]} leads={[]} sampleOrders={[]} sampleLeads={sample} />
</Admin>
