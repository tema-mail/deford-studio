---
/** «Ошибки в маркетинге». На оригинале (rec4182829501) карточки едут
    по колесу, пока секция прилипает к экрану, а на телефоне листаются
    свайпом. Здесь по решению Артёма: на десктопе шесть карточек сеткой
    3 × 2, на планшете по две в ряд. На телефоне — одной лентой с
    горизонтальным скроллом с фиксацией: секция прилипает к экрану,
    прокрутка вниз двигает ленту вбок, а когда лента доехала до конца,
    страница идёт дальше вниз. Свайп вбок по ленте делает то же.

    Вид карточки, шапки и подложки взят с оригинала: фото, стеклянная
    плашка текста, радиусы, цвета, появление при прокрутке. Десктоп
    масштабируется от макета 1200 так же, как соседние секции. */

const errors = [
  {
    img: '31663164-ChatGPT_Image_17__20.png',
    title: 'Таргетолог работает, а что происходит, непонятно',
    text: 'Платите деньги, реклама крутится. Но что делается, почему именно так, никто не объясняет. Отчётов нет, цифр нет. Работаете на веру.',
  },
  {
    img: '38663061-ChatGPT_Image_17__20.png',
    title: 'Потратили бюджет, а запустили 2 картинки и 3 текста',
    text: 'Захожу на аудит, вижу: потрачено 100 тысяч, крутится одно объявление месяцами. Никаких тестов, никаких гипотез. Клиент думал, так и должно быть.',
  },
  {
    img: '63383836-ChatGPT_Image_17__20.png',
    title: 'База 10 тысяч человек, и ни одной рассылки за три года',
    text: 'База есть. Никто ни разу не предложил по ней написать. Люди, которые уже покупали у вас, просто лежат мёртвым грузом.',
  },
  {
    img: '35646638-ChatGPT_Image_17__20.png',
    title: 'Хотите расти, а подрядчик не знает как',
    text: 'Говорите: давайте больше бюджет, хочу лучше результат. В ответ, тишина или отговорки. Новых связок нет, стратегии нет. Думать приходится самому, хотя именно за это платите.',
  },
  {
    img: '32396563-ChatGPT_Image_17__20.png',
    title: 'В праздники не справляетесь, в остальное время, пусто',
    text: '8 Марта и День влюблённых дают поток, не успеваете отвечать. Но это 2 недели в году. Остальные 10 месяцев магазин работает вполсилы, потому что никто не выстраивает стратегию под сезон заранее.',
  },
  {
    img: '33343936-ChatGPT_Image_17__20.png',
    title:
      'Нет регулярных отчетов. Нет метрики и аналитики. И самое плохое даже нет доступа к рекламному кабинету.',
    text: 'Подрядчик уйдёт, и заберёт всё с собой. Ваш бюджет потрачен, а на руках ничего. Ни кабинета, ни статистики, ни базы. Многие узнают об этом только когда уже поздно.',
  },
];
---

<section class="fm-errors" data-fm-errors style="padding-top: 15px;">
  <div class="fm-errors__viewport">
    <div class="fm-errors__pin">
    <header class="fm-errors__header">
      <div class="fm-errors__tag">Ошибки</div>
      <h2 class="fm-errors__title">
        <span class="fm-errors__title-line"><span>Ошибки в маркетинге, которые</span></span>
        <span class="fm-errors__title-line"><span>не дают вам развиваться</span></span>
      </h2>
    </header>

    <div class="fm-errors__grid">
      {
        errors.map((item) => (
          <article class="fm-errors__card">
            <img
              class="fm-errors__image"
              src={`/img/flowers/${item.img}`}
              alt=""
              decoding="async"
            />
            <div class="fm-errors__glass">
              <h3 class="fm-errors__card-title">{item.title}</h3>
              <p class="fm-errors__card-text">{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
    </div>
  </div>
</section>

<style is:global>
  .fm-errors {
    --fm-errors-bg: #dbdbdb;
    --fm-errors-dark: #202020;
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    background: #fff;
    font-family: 'Inter Tight', Inter, Arial, sans-serif;
    color: var(--fm-errors-dark);
    /* единица макета: 1/1200 ширины секции */
    container-type: inline-size;
  }

  .fm-errors,
  .fm-errors * {
    box-sizing: border-box;
  }

  .fm-errors__viewport {
    --u: calc(100cqw / 1200);
    position: relative;
    width: 100%;
    padding: calc(88 * var(--u)) 0 calc(88 * var(--u));
    overflow: hidden;
    background: var(--fm-errors-bg);
    border-radius: clamp(42px, 6.25vw, 120px);
  }

  /* ШАПКА */
  .fm-errors__header {
    width: calc(620 * var(--u));
    margin: 0 auto;
    text-align: center;
  }

  .fm-errors__tag {
    width: max-content;
    margin: 0 auto calc(27 * var(--u));
    padding: calc(7 * var(--u)) calc(10 * var(--u));
    background: #fff;
    border: 1px solid #ededee;
    border-radius: 100px;
    font-size: calc(11 * var(--u));
    line-height: calc(13 * var(--u));
    font-weight: 400;
  }

  .fm-errors__title {
    margin: 0;
    color: var(--fm-errors-dark);
    font-size: calc(33 * var(--u));
    line-height: calc(33 * var(--u));
    font-weight: 600;
    letter-spacing: -1px;
  }

  .fm-errors__title-line {
    display: block;
    overflow: hidden;
  }

  .fm-errors__title-line > span {
    display: block;
  }

  /* СЕТКА: 3 колонки на ширине кейсов (1080 из 1200) */
  .fm-errors__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(20 * var(--u));
    width: calc(1080 * var(--u));
    margin: calc(50 * var(--u)) auto 0;
  }

  /* КАРТОЧКА — пропорции и оформление с оригинала */
  .fm-errors__card {
    position: relative;
    aspect-ratio: 324 / 421;
    overflow: hidden;
    border-radius: calc(30 * var(--u));
    background: #222;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.05);
    transition:
      transform 0.32s cubic-bezier(0.2, 0.75, 0.25, 1),
      filter 0.32s ease;
  }

  .fm-errors__card:hover {
    transform: scale(1.025);
    filter: brightness(1.03);
  }

  .fm-errors__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fm-errors__glass {
    position: absolute;
    z-index: 4;
    top: calc(25 * var(--u));
    left: calc(25 * var(--u));
    right: calc(25 * var(--u));
    padding: calc(15 * var(--u));
    border-radius: calc(10 * var(--u));
    background: rgba(32, 32, 32, 0.5);
    -webkit-backdrop-filter: blur(7.5px);
    backdrop-filter: blur(7.5px);
  }

  .fm-errors__card-title {
    margin: 0;
    color: #fff;
    font-size: calc(15 * var(--u));
    line-height: calc(17 * var(--u));
    font-weight: 500;
    letter-spacing: -0.5px;
  }

  .fm-errors__card-text {
    margin: calc(4 * var(--u)) 0 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: calc(11 * var(--u));
    line-height: calc(13 * var(--u));
    font-weight: 500;
  }

  /* ПОЯВЛЕНИЕ при прокрутке — только если скрипт включил анимацию,
     без скрипта карточки видны сразу */
  .fm-errors.is-anim .fm-errors__title-line > span {
    transform: translateY(120%);
    opacity: 0;
  }

  .fm-errors.is-anim .fm-errors__card {
    opacity: 0;
  }

  .fm-errors.is-anim.is-ready .fm-errors__title-line:nth-child(1) > span {
    animation: fm-errors-title-in 1.2s cubic-bezier(0.16, 0.82, 0.21, 1) 0.1s forwards;
  }

  .fm-errors.is-anim.is-ready .fm-errors__title-line:nth-child(2) > span {
    animation: fm-errors-title-in 1.2s cubic-bezier(0.16, 0.82, 0.21, 1) 0.25s forwards;
  }

  .fm-errors.is-anim.is-ready .fm-errors__card {
    animation: fm-errors-card-in 0.65s both;
  }

  .fm-errors.is-anim.is-ready .fm-errors__card:nth-child(1) { animation-delay: 0.2s; }
  .fm-errors.is-anim.is-ready .fm-errors__card:nth-child(2) { animation-delay: 0.25s; }
  .fm-errors.is-anim.is-ready .fm-errors__card:nth-child(3) { animation-delay: 0.3s; }
  .fm-errors.is-anim.is-ready .fm-errors__card:nth-child(4) { animation-delay: 0.35s; }
  .fm-errors.is-anim.is-ready .fm-errors__card:nth-child(5) { animation-delay: 0.4s; }
  .fm-errors.is-anim.is-ready .fm-errors__card:nth-child(6) { animation-delay: 0.45s; }

  @keyframes fm-errors-title-in {
    from { transform: translateY(120%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  @keyframes fm-errors-card-in {
    from { opacity: 0; scale: 0.92; }
    to { opacity: 1; scale: 1; }
  }

  /* ПЛАНШЕТ: две карточки в ряд, макет 800 */
  @media (max-width: 979px) {
    .fm-errors__viewport {
      --u: calc(100cqw / 800);
      padding: calc(70 * var(--u)) 0 calc(70 * var(--u));
    }

    .fm-errors__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: calc(720 * var(--u));
      margin-top: calc(44 * var(--u));
    }
  }

  /* ТЕЛЕФОН: столбиком, размеры — с мобильной версии оригинала */
  @media (max-width: 640px) {
    .fm-errors {
      background: transparent;
    }

    .fm-errors__viewport {
      padding: 48px 0 46px;
      border-radius: 36px;
    }

    .fm-errors__header {
      width: 100%;
      padding: 0 18px;
    }

    .fm-errors__tag {
      margin-bottom: 20px;
      padding: 7px 10px;
      font-size: 11px;
      line-height: 13px;
    }

    .fm-errors__title {
      width: 100%;
      max-width: 430px;
      margin: 0 auto;
      font-size: clamp(27px, 7.7vw, 35px);
      line-height: 0.98;
      letter-spacing: -0.8px;
    }

    .fm-errors__title-line,
    .fm-errors__title-line > span {
      display: inline;
      overflow: visible;
    }

    .fm-errors__title-line:first-child > span::after {
      content: ' ';
    }

    .fm-errors.is-anim .fm-errors__title-line > span {
      transform: none;
      opacity: 1;
      animation: none !important;
    }

    /* Лента. Без скрипта — обычный свайп со снапом;
       со скриптом — прилипание и сдвиг от прокрутки страницы. */
    .fm-errors__grid {
      display: flex;
      gap: 12px;
      width: 100%;
      margin-top: 38px;
      padding: 0 18px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .fm-errors__grid::-webkit-scrollbar {
      display: none;
    }

    .fm-errors__card {
      flex: 0 0 min(85vw, 500px);
      aspect-ratio: 500 / 360;
      border-radius: 24px;
      scroll-snap-align: center;
    }

    /* без обрезки на подложке: при overflow hidden у предка
       прилипание к экрану не срабатывает. Режет ленту сам экран секции. */
    .fm-errors.is-pinned .fm-errors__viewport {
      padding: 0;
      border-radius: 36px;
      overflow: visible;
    }

    /* экран секции: прилипает, контент по центру ниже шапки сайта */
    .fm-errors.is-pinned .fm-errors__pin {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 76px 0 24px;
      overflow: hidden;
    }

    .fm-errors.is-pinned .fm-errors__grid {
      overflow: visible;
      scroll-snap-type: none;
      will-change: transform;
      touch-action: pan-y;
    }

    .fm-errors__card:hover {
      transform: none;
      filter: none;
    }

    /* на телефоне плашка снизу, как в мобильной версии оригинала */
    .fm-errors__glass {
      top: auto;
      left: 16px;
      right: 16px;
      bottom: 16px;
      padding: 14px;
      border-radius: 10px;
      background: rgba(32, 32, 32, 0.52);
    }

    .fm-errors__card-title {
      font-size: clamp(14px, 4vw, 17px);
      line-height: 1.08;
      letter-spacing: -0.4px;
    }

    .fm-errors__card-text {
      margin-top: 5px;
      font-size: clamp(10px, 2.75vw, 12px);
      line-height: 1.2;
    }
  }

  @media (max-width: 350px) {
    .fm-errors__header,
    .fm-errors__grid {
      padding-left: 12px;
      padding-right: 12px;
    }

    .fm-errors__title {
      font-size: 25px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fm-errors.is-anim .fm-errors__title-line > span,
    .fm-errors.is-anim .fm-errors__card {
      transform: none !important;
      opacity: 1 !important;
      animation: none !important;
    }

    .fm-errors__card {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-fm-errors]');
    if (!root) return;

    var viewport = root.querySelector('.fm-errors__viewport');
    var pin = root.querySelector('.fm-errors__pin');
    var track = root.querySelector('.fm-errors__grid');
    var cards = track.querySelectorAll('.fm-errors__card');

    /* ПОЯВЛЕНИЕ: прячем до показа, только если сможем показать */
    if ('IntersectionObserver' in window) {
      root.classList.add('is-anim');
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            root.classList.add('is-ready');
            io.disconnect();
          });
        },
        { threshold: 0.15 },
      );
      io.observe(root);
    }

    /* ТЕЛЕФОН: горизонтальный скролл с фиксацией */
    var mq = window.matchMedia('(max-width: 640px)');
    var distance = 0;
    var ticking = false;

    function measure() {
      if (!mq.matches) {
        root.classList.remove('is-pinned');
        viewport.style.height = '';
        track.style.transform = '';
        return;
      }

      root.classList.add('is-pinned');
      track.style.transform = '';

      var last = cards[cards.length - 1];
      var pad = parseFloat(getComputedStyle(track).paddingRight) || 0;
      distance = Math.max(0, last.offsetLeft + last.offsetWidth + pad - track.clientWidth);

      /* секция выше экрана ровно на длину ленты: столько прокрутки
         уходит в сдвиг вбок, потом страница едет дальше */
      viewport.style.height = pin.offsetHeight + distance + 'px';
      update();
    }

    function update() {
      ticking = false;
      if (!root.classList.contains('is-pinned')) return;
      var travel = viewport.offsetHeight - pin.offsetHeight;
      var passed = -viewport.getBoundingClientRect().top;
      var p = travel > 0 ? Math.min(1, Math.max(0, passed / travel)) : 0;
      track.style.transform = 'translate3d(' + -p * distance + 'px, 0, 0)';
    }

    window.addEventListener('scroll', function () {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });

    /* Свайп вбок по ленте двигает прокрутку страницы — лента едет за пальцем */
    var startX = 0;
    var startY = 0;
    var lastX = 0;
    var horizontal = null;

    track.addEventListener('touchstart', function (e) {
      if (!root.classList.contains('is-pinned')) return;
      startX = lastX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      horizontal = null;
    }, { passive: true });

    track.addEventListener('touchmove', function (e) {
      if (!root.classList.contains('is-pinned')) return;
      var x = e.touches[0].clientX;
      var y = e.touches[0].clientY;
      if (horizontal === null) {
        var dx = Math.abs(x - startX);
        var dy = Math.abs(y - startY);
        if (dx < 6 && dy < 6) return;
        horizontal = dx > dy;
      }
      if (!horizontal) return;
      window.scrollBy(0, lastX - x);
      lastX = x;
    }, { passive: true });

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(measure, 120);
    }, { passive: true });

    if (mq.addEventListener) mq.addEventListener('change', measure);
    window.addEventListener('load', measure);
    measure();
  })();
</script>
