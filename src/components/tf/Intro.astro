---
/** Заставка перед страницей.

    Внизу — колокольчик с подписью «Ваша компания» и счётчиком заявок,
    который набегает до 50. Из него снизу вверх вылетают уведомления:
    белые карточки, как пуши на телефоне, слегка вразнобой — влево,
    вправо и с небольшим наклоном. Сначала одно-два, потом поток.
    К концу они гаснут и остаётся строка «Знаем, где сидят ваши клиенты».

    Значки источников — свои, простой геометрии.

    demo=true добавляет кнопку «Ещё раз» и не снимает заставку сама:
    нужно, чтобы смотреть её на черновой странице. */

interface Props {
  demo?: boolean;
}

const { demo = false } = Astro.props;

/* kind — вид значка; x/r — куда и под каким наклоном уводит карточку;
   d — задержка в секундах: две первые неспешно, дальше поток. */
const notes = [
  { kind: 'chat', who: 'Сообщения', text: 'Здравствуйте! Хочу заказать таргет', x: -0.10, r: -3, d: 0.30 },
  { kind: 'search', who: 'Заявка с сайта', text: 'Сколько стоит продвижение?', x: 0.14, r: 3, d: 0.78 },

  { kind: 'sms', who: 'SMS', text: 'Можно записаться на завтра?', x: -0.30, r: -6, d: 1.06 },
  { kind: 'chat', who: 'Сообщения', text: 'Нужна реклама для автосервиса', x: 0.26, r: 5, d: 1.16 },
  { kind: 'search', who: 'Заявка с сайта', text: 'Есть кейсы по моей нише?', x: -0.04, r: -1, d: 1.26 },
  { kind: 'chat', who: 'Сообщения', text: 'Пришлите цены, пожалуйста', x: 0.40, r: 7, d: 1.36 },
  { kind: 'sms', who: 'SMS', text: 'Готов обсудить бюджет', x: -0.44, r: -8, d: 1.46 },
  { kind: 'chat', who: 'Сообщения', text: 'Остались места на этой неделе?', x: 0.08, r: 2, d: 1.56 },
  { kind: 'search', who: 'Заявка с сайта', text: 'Работаете с небольшими бюджетами?', x: -0.22, r: -4, d: 1.64 },
  { kind: 'chat', who: 'Сообщения', text: 'Хочу заявки с ВКонтакте', x: 0.33, r: 6, d: 1.72 },
  { kind: 'sms', who: 'SMS', text: 'Перезвоните, пожалуйста', x: -0.36, r: -5, d: 1.80 },
  { kind: 'chat', who: 'Сообщения', text: 'Запустите рекламу к выходным?', x: 0.18, r: 4, d: 1.88 },
  { kind: 'search', who: 'Заявка с сайта', text: 'Нужен разбор кабинета', x: -0.14, r: -2, d: 1.96 },
  { kind: 'chat', who: 'Сообщения', text: 'Сколько заявок будет в месяц?', x: 0.44, r: 8, d: 2.04 },
  { kind: 'sms', who: 'SMS', text: 'Подскажите по срокам', x: -0.26, r: -6, d: 2.12 },
  { kind: 'chat', who: 'Сообщения', text: 'Beauty-студия, нужны клиенты', x: 0.02, r: 1, d: 2.20 },
];
---

<div class={`tfintro${demo ? ' tfintro--demo' : ''}`} data-tfintro>
  <div class="tfintro__flow">
    {
      notes.map((n) => (
        <article
          class={`tfintro__note tfintro__note--${n.kind}`}
          style={`--d: ${n.d}s; --x: ${n.x}; --r: ${n.r}deg`}
        >
          <span class="tfintro__icon" aria-hidden="true">
            {n.kind === 'chat' && (
              <svg viewBox="0 0 24 24"><path d="M12 4a8 8 0 0 0-6.9 12l-.9 3.4 3.5-.9A8 8 0 1 0 12 4Z" /></svg>
            )}
            {n.kind === 'search' && (
              <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6" /><path d="M15.5 15.5 20 20" /></svg>
            )}
            {n.kind === 'sms' && (
              <svg viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" rx="2.5" /><path d="M11 18h2" /></svg>
            )}
          </span>

          <span class="tfintro__body">
            <span class="tfintro__head">
              <span class="tfintro__who">{n.who}</span>
              <span class="tfintro__time">сейчас</span>
            </span>
            <span class="tfintro__text">{n.text}</span>
          </span>
        </article>
      ))
    }
  </div>

  <div class="tfintro__bell">
    <span class="tfintro__bell-circle" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <path d="M12 3a5.5 5.5 0 0 0-5.5 5.5c0 3.2-.8 4.8-1.6 5.8-.5.6-.1 1.6.7 1.6h12.8c.8 0 1.2-1 .7-1.6-.8-1-1.6-2.6-1.6-5.8A5.5 5.5 0 0 0 12 3Z" />
        <path d="M10 19a2 2 0 0 0 4 0" />
      </svg>
      <span class="tfintro__badge" data-tfintro-count>0</span>
    </span>
    <span class="tfintro__bell-label">Ваша компания</span>
  </div>

  <p class="tfintro__claim">Знаем, где сидят ваши клиенты</p>

  {demo && <button class="tfintro__again" type="button" data-tfintro-again>Ещё раз</button>}
</div>

<style is:global>
  .tfintro {
    position: fixed;
    inset: 0;
    z-index: 10000002;
    overflow: hidden;
    background:
      radial-gradient(70% 60% at 100% 0%, rgba(238, 0, 0, 0.32) 0%, rgba(129, 0, 5, 0) 62%),
      radial-gradient(60% 55% at 0% 100%, rgba(238, 0, 0, 0.26) 0%, rgba(129, 0, 5, 0) 62%),
      #070707;
    font-family: 'Inter Tight', Inter, Arial, sans-serif;
    animation: tfintro-out 0.6s ease 3.55s both;
  }

  .tfintro[hidden] { display: none; }
  .tfintro--demo { animation: none; }

  @keyframes tfintro-out {
    to { opacity: 0; visibility: hidden; }
  }

  /* ---------- поток уведомлений ---------- */

  .tfintro__flow {
    position: absolute;
    left: 50%;
    bottom: 150px;
    width: 0;
    height: 0;
    animation: tfintro-flow-out 0.45s ease 2.55s both;
  }

  @keyframes tfintro-flow-out {
    to { opacity: 0; }
  }

  /* Белая карточка, как пуш на телефоне: значок, название, время, текст */
  .tfintro__note {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 11px;
    width: 332px;
    margin-left: -166px;
    padding: 11px 14px;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transform: translate3d(0, 40px, 0) scale(0.92);
    animation: tfintro-fly 2.1s cubic-bezier(0.22, 0.65, 0.3, 1) var(--d) both;
  }

  /* Вылет снизу вверх с уводом в сторону и лёгким наклоном */
  @keyframes tfintro-fly {
    0% { opacity: 0; transform: translate3d(0, 40px, 0) scale(0.92) rotate(0deg); }
    9% { opacity: 1; transform: translate3d(calc(var(--x) * 60px), -10px, 0) scale(1) rotate(calc(var(--r) * 0.3)); }
    55% { opacity: 1; }
    100% {
      opacity: 0;
      transform: translate3d(calc(var(--x) * 760px), -78vh, 0) scale(0.84) rotate(var(--r));
    }
  }

  .tfintro__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: linear-gradient(95.58deg, #ee0000 0%, #810005 96.03%);
  }

  .tfintro__note--search .tfintro__icon { background: #202020; }
  .tfintro__note--sms .tfintro__icon { background: #3b7d4f; }

  .tfintro__icon svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: #fff;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tfintro__body { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1 1 auto; }

  .tfintro__head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }

  .tfintro__who {
    color: #202020;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .tfintro__time { color: #9b9b9b; font-size: 11px; font-weight: 500; }

  .tfintro__text {
    color: #3b3b3b;
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.22;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---------- колокольчик ---------- */

  .tfintro__bell {
    position: absolute;
    left: 50%;
    bottom: 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    transform: translateX(-50%);
    animation: tfintro-bell-out 0.45s ease 2.55s both;
  }

  @keyframes tfintro-bell-out {
    to { opacity: 0; transform: translateX(-50%) translateY(14px); }
  }

  .tfintro__bell-circle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 74px;
    height: 74px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.07);
    animation: tfintro-ring 0.55s ease-in-out 0.25s 4;
    transform-origin: 50% 18%;
  }

  /* Покачивание — колокольчик звенит, пока идут заявки */
  @keyframes tfintro-ring {
    0%, 100% { transform: rotate(0deg); }
    20% { transform: rotate(11deg); }
    45% { transform: rotate(-9deg); }
    70% { transform: rotate(6deg); }
  }

  .tfintro__bell-circle svg {
    width: 32px;
    height: 32px;
    fill: none;
    stroke: #fff;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tfintro__badge {
    position: absolute;
    right: -4px;
    top: -2px;
    min-width: 30px;
    height: 30px;
    padding: 0 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 120px;
    background: linear-gradient(95.58deg, #ee0000 0%, #810005 96.03%);
    box-shadow: 0 0 18px rgba(238, 0, 0, 0.55);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .tfintro__bell-label {
    color: rgba(255, 255, 255, 0.55);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* ---------- финальная строка ---------- */

  .tfintro__claim {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(820px, calc(100% - 32px));
    margin: 0;
    color: #fff;
    font-size: clamp(28px, 5vw, 56px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-align: center;
    opacity: 0;
    transform: translate(-50%, -46%);
    animation: tfintro-claim-in 0.6s cubic-bezier(0.2, 0.75, 0.25, 1) 2.8s both;
  }

  @keyframes tfintro-claim-in {
    to { opacity: 1; transform: translate(-50%, -50%); }
  }

  .tfintro__again {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    padding: 11px 24px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 120px;
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    opacity: 0;
    animation: tfintro-claim-in 0.4s ease 3.1s both;
  }

  body.tf-introlock { overflow: hidden; }

  /* ---------- телефон: разлёт уже, карточка компактнее ---------- */

  @media (max-width: 720px) {
    .tfintro__flow { bottom: 132px; }

    .tfintro__note {
      width: min(300px, calc(100vw - 40px));
      margin-left: calc(min(300px, 100vw - 40px) / -2);
      gap: 9px;
      padding: 10px 12px;
      border-radius: 16px;
    }

    @keyframes tfintro-fly {
      0% { opacity: 0; transform: translate3d(0, 36px, 0) scale(0.92) rotate(0deg); }
      9% { opacity: 1; transform: translate3d(calc(var(--x) * 24px), -8px, 0) scale(1) rotate(calc(var(--r) * 0.3)); }
      55% { opacity: 1; }
      100% { opacity: 0; transform: translate3d(calc(var(--x) * 150px), -72vh, 0) scale(0.86) rotate(var(--r)); }
    }

    .tfintro__text { font-size: 12.5px; }
    .tfintro__bell { bottom: 40px; }
    .tfintro__bell-circle { width: 64px; height: 64px; }
    .tfintro__bell-circle svg { width: 28px; height: 28px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tfintro,
    .tfintro__flow,
    .tfintro__note,
    .tfintro__bell,
    .tfintro__bell-circle,
    .tfintro__claim { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
  }
</style>

<script is:inline>
  (function () {
    var box = document.querySelector('[data-tfintro]');
    if (!box) return;

    var demo = box.classList.contains('tfintro--demo');
    document.body.classList.add('tf-introlock');

    /* Счётчик на колокольчике: добегает до 50 к концу потока */
    function runCounter(node) {
      var badge = node.querySelector('[data-tfintro-count]');
      if (!badge) return;

      var TARGET = 50;
      var START = 250;
      var DURATION = 2050;
      var begun = performance.now();

      function tick(now) {
        var p = Math.min(1, (now - begun - START) / DURATION);
        if (p < 0) return requestAnimationFrame(tick);

        /* сначала по одной, ближе к концу — пачками */
        var value = Math.round(TARGET * Math.pow(p, 1.7));
        badge.textContent = String(value);

        if (p < 1) requestAnimationFrame(tick);
      }

      requestAnimationFrame(tick);
    }

    runCounter(box);

    if (!demo) {
      setTimeout(function () {
        box.hidden = true;
        document.body.classList.remove('tf-introlock');
      }, 4200);
      return;
    }

    /* Черновик: «Ещё раз» подменяет блок копией — анимации стартуют заново */
    function bindAgain(node) {
      var btn = node.querySelector('[data-tfintro-again]');
      if (!btn) return;

      btn.addEventListener('click', function () {
        var fresh = node.cloneNode(true);
        node.parentNode.replaceChild(fresh, node);
        runCounter(fresh);
        bindAgain(fresh);
      });
    }

    bindAgain(box);
  })();
</script>
