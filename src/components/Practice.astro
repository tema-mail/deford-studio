<style is:global>
/* ===== слой 1 из Тильды ===== */
/* =========================================================
   DEFORD — BLOCK 03
   Как решаем задачи на практике

   Figma base:
   canvas — 1440px
   heading x60 / y2166
   cards — 430×236
   gaps — 15px
   ========================================================= */

#deford-practice-v1,
#deford-practice-v1 * {
    box-sizing: border-box;
}

#deford-practice-v1 {
    --black: #2f2f2f;
    --text: #525252;
    --card: #f3f3f3;
    --blue: #0f68ff;

    width: 100%;
    overflow: hidden;

    background: #ffffff;

    font-family: Inter, Arial, sans-serif;
}


/* =========================================================
   CONTAINER
   ========================================================= */

#deford-practice-v1 .dfp-container {
    width: 100%;
    max-width: 1440px;

    margin: 0 auto;

    padding-left: min(60px, 4.1667vw);
    padding-right: min(60px, 4.1667vw);
}


/* =========================================================
   TOP SPACE
   120px from previous block
   ========================================================= */

#deford-practice-v1 .dfp-top-space {
    height: min(120px, 8.3333vw);
}


/* =========================================================
   HEADING
   ========================================================= */

#deford-practice-v1 .dfp-title {
    width: min(591px, 41.0417vw);

    margin: 0;

    font-family: Arial, Helvetica, sans-serif;

    font-size: min(65px, 4.5139vw);
    font-weight: 700;

    line-height: .95;
    letter-spacing: -0.06em;

    color: var(--black);
}


/* =========================================================
   CARDS
   ========================================================= */

#deford-practice-v1 .dfp-grid {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: min(15px, 1.0417vw);

    margin-top: min(30px, 2.0833vw);
}


/* card */

#deford-practice-v1 .dfp-card {
    position: relative;

    display: flex;
    flex-direction: column;

    width: 100%;
    height: min(236px, 16.3889vw);

    padding:
        min(30px, 2.0833vw)
        min(30px, 2.0833vw);

    border-radius: min(40px, 2.7778vw);

    background: var(--card);

    text-decoration: none;

    overflow: hidden;

    transition:
        transform .25s ease,
        background-color .25s ease;
}


/* =========================================================
   CARD TITLE
   ========================================================= */

#deford-practice-v1 .dfp-card-title {
    width: min(389px, 27.0139vw);

    margin: 0;

    font-size: min(30px, 2.0833vw);
    font-weight: 600;

    line-height: .95;
    letter-spacing: -0.06em;

    color: var(--black);
}


/* =========================================================
   CARD TEXT
   ========================================================= */

#deford-practice-v1 .dfp-card-text {
    width: min(358px, 24.8611vw);

    margin:
        min(10px, .6944vw)
        0
        0;

    font-size: min(15px, 1.0417vw);
    font-weight: 100;

    line-height: 1;

    letter-spacing: 0;

    color: var(--text);
}


/* =========================================================
   MORE LINK
   ========================================================= */

#deford-practice-v1 .dfp-more {
    display: inline-flex;
    align-items: center;

    gap: min(5px, .3472vw);

    margin-top: auto;

    width: fit-content;

    font-size: min(15px, 1.0417vw);
    font-weight: 700;

    line-height: 1;

    color: var(--blue);
}

#deford-practice-v1 .dfp-more-arrow {
    position: relative;

    display: block;

    width: min(13px, .9028vw);
    height: min(8px, .5556vw);

    flex-shrink: 0;
}

#deford-practice-v1 .dfp-more-arrow::before {
    content: "";

    position: absolute;

    top: 50%;
    left: 0;

    width: 100%;
    height: 1px;

    background: var(--blue);

    transform: translateY(-50%);
}

#deford-practice-v1 .dfp-more-arrow::after {
    content: "";

    position: absolute;

    right: 0;
    top: 50%;

    width: min(5px, .3472vw);
    height: min(5px, .3472vw);

    border-top: 1px solid var(--blue);
    border-right: 1px solid var(--blue);

    transform:
        translateY(-50%)
        rotate(45deg);
}


/* =========================================================
   HOVER
   ========================================================= */

@media (hover:hover) {

    #deford-practice-v1 .dfp-card:hover {
        transform: translateY(-4px);
        background: #eeeeee;
    }

    #deford-practice-v1 .dfp-card:hover .dfp-more-arrow {
        transform: translateX(4px);
    }

}


/* =========================================================
   BOTTOM SPACE
   120px to the next Figma block
   ========================================================= */

#deford-practice-v1 .dfp-bottom-space {
    height: min(120px, 8.3333vw);
}


/* =========================================================
   MOBILE
   ONE ADAPTIVE FROM 300 TO 640px
   ========================================================= */

@media screen and (max-width:640px) {

    #deford-practice-v1 .dfp-container {
        padding-left: clamp(16px, 5vw, 28px);
        padding-right: clamp(16px, 5vw, 28px);
    }


    /* spaces */

    #deford-practice-v1 .dfp-top-space {
        height: clamp(70px, 18vw, 100px);
    }

    #deford-practice-v1 .dfp-bottom-space {
        height: clamp(70px, 18vw, 100px);
    }


    /* title */

    #deford-practice-v1 .dfp-title {
        width: 100%;
        max-width: 560px;

        font-size: clamp(40px, 11.5vw, 62px);

        line-height: .94;
        letter-spacing: -0.055em;
    }


    /* cards */

    #deford-practice-v1 .dfp-grid {
        display: flex;
        flex-direction: column;

        gap: 12px;

        margin-top: clamp(28px, 8vw, 40px);
    }

    #deford-practice-v1 .dfp-card {
        width: 100%;
        height: auto;

        min-height: clamp(220px, 60vw, 285px);

        padding:
            clamp(24px, 7vw, 36px)
            clamp(22px, 6vw, 34px);

        border-radius: clamp(24px, 7vw, 36px);
    }

    #deford-practice-v1 .dfp-card-title {
        width: 100%;
        max-width: 500px;

        font-size: clamp(28px, 8vw, 40px);

        line-height: .97;
    }

    #deford-practice-v1 .dfp-card-text {
        width: 100%;
        max-width: 500px;

        margin-top: 16px;

        font-size: clamp(14px, 4vw, 16px);

        line-height: 1.15;
    }

    #deford-practice-v1 .dfp-more {
        gap: 6px;

        margin-top: 28px;

        font-size: clamp(14px, 4vw, 16px);
    }

    #deford-practice-v1 .dfp-more-arrow {
        width: 14px;
        height: 8px;
    }

    #deford-practice-v1 .dfp-more-arrow::after {
        width: 5px;
        height: 5px;
    }

}

/* ===== слой 2 из Тильды ===== */
.dfp-card {
    font-weight: 100;
    font-family: var(--t-headline-font);
}

/* Compact mobile reading scale. */
@media (max-width: 640px) {
  #deford-practice-v1 .dfp-container { padding: 0 16px 56px; }
  #deford-practice-v1 .dfp-title {
    font-size: clamp(30px, 9vw, 38px);
    line-height: .94;
    letter-spacing: -.055em;
  }
  #deford-practice-v1 .dfp-grid { gap: 12px; margin-top: 24px; }
  #deford-practice-v1 .dfp-card { min-height: 0; padding: 22px 20px 24px; border-radius: 20px; }
  #deford-practice-v1 .dfp-card-title {
    font-size: clamp(20px, 6.8vw, 26px);
    line-height: .98;
    letter-spacing: -.045em;
  }
  #deford-practice-v1 .dfp-card-text { margin-top: 14px; font-size: 14px; line-height: 1.38; }
  #deford-practice-v1 .dfp-more { margin-top: 18px; }
}
</style>
