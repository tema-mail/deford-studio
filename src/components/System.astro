<style is:global>
/* ===== слой 1 из Тильды ===== */
/* =========================================================
   DEFORD — BLOCK 02 V4

   Desktop = auto-scale
   Tablet = scaled desktop
   Mobile = one adaptive 300–640px
   ========================================================= */

#deford-system-v4,
#deford-system-v4 * {
    box-sizing: border-box;
}

#deford-system-v4 {
    --blue: #0f68ff;
    --dark: #1a1a1c;
    --black: #2f2f2f;
    --text: #525252;
    --light: #f3f3f3;
    --grey: #dadada;
    --white: #ffffff;

    width: 100%;
    overflow: hidden;

    background: #ffffff;

    font-family: Inter, Arial, sans-serif;
}


/* =========================================================
   CONTAINER
   ========================================================= */

#deford-system-v4 .dfs-container {
    width: 100%;
    max-width: 1440px;

    margin: 0 auto;

    padding-left: min(60px, 4.1667vw);
    padding-right: min(60px, 4.1667vw);
}


/* =========================================================
   INTRO
   ========================================================= */

#deford-system-v4 .dfs-intro {
    position: relative;

    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: min(20px, 1.3889vw);

    height: min(457px, 31.7361vw);

    padding-top: min(91px, 6.3194vw);
}

#deford-system-v4 .dfs-intro-left {
    padding-top: min(29px, 2.0139vw);
}

#deford-system-v4 .dfs-title {
    width: min(641px, 44.5139vw);

    margin: 0;

    font-family: Arial, Helvetica, sans-serif;

    font-size: min(65px, 4.5139vw);
    font-weight: 700;

    line-height: .95;
    letter-spacing: -0.055em;

    color: var(--black);
}

#deford-system-v4 .dfs-description {
    width: min(633px, 43.9583vw);

    margin:
        min(20px, 1.3889vw)
        0
        0;

    font-size: min(15px, 1.0417vw);
    font-weight: 400;

    line-height: 1;

    color: var(--text);
}

#deford-system-v4 .dfs-description p {
    margin: 0;
}

#deford-system-v4 .dfs-description p + p {
    margin-top: min(15px, 1.0417vw);
}


/* =========================================================
   INTRO IMAGE
   ========================================================= */

#deford-system-v4 .dfs-intro-art {
    position: relative;

    width: 100%;
    height: 100%;
}

#deford-system-v4 .dfs-intro-image {
    position: absolute;

    top: 0;
    left: min(77px, 5.3472vw);

    display: block;

    width: min(496px, 34.4444vw);
    height: auto;

    object-fit: contain;
}


/* =========================================================
   TWO CARDS
   ========================================================= */

#deford-system-v4 .dfs-cards-row {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: min(20px, 1.3889vw);
}

#deford-system-v4 .dfs-card {
    position: relative;

    height: min(381px, 26.4583vw);

    overflow: hidden;

    border-radius: min(40px, 2.7778vw);
}

#deford-system-v4 .dfs-card-dark {
    background: var(--dark);
}

#deford-system-v4 .dfs-card-light {
    background: var(--light);
}

#deford-system-v4 .dfs-card-content {
    position: relative;
    z-index: 5;

    padding:
        min(40px, 2.7778vw)
        min(40px, 2.7778vw)
        0;
}

#deford-system-v4 .dfs-card-title {
    position: relative;
    z-index: 3;

    width: min(450px, 31.25vw);

    margin: 0;

    font-size: min(36px, 2.5vw);
    font-weight: 600;

    line-height: .95;
    letter-spacing: -0.035em;
}

#deford-system-v4 .dfs-card-dark .dfs-card-title {
    color: #ffffff;
}

#deford-system-v4 .dfs-card-light .dfs-card-title {
    color: var(--black);
}

#deford-system-v4 .dfs-card-text {
    position: relative;
    z-index: 3;

    margin:
        min(15px, 1.0417vw)
        0
        0;

    font-size: min(15px, 1.0417vw);
    font-weight: 400;

    line-height: 1;

    color: var(--text);
}

#deford-system-v4
.dfs-card-dark
