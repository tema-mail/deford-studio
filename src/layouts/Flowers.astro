---
/* Оболочка лендинга «Маркетинг для цветочных магазинов».
   Отдельная от главной: у страницы свои шрифты (Oswald + Montserrat)
   и свои метаданные, снятые с targetfactory.ru/flowers. */
import '../styles/flowers.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = '',
  canonical = 'https://targetfactory.ru/flowers',
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link
      rel="shortcut icon"
      href="/img/flowers/32353231-Frame_708.png"
      type="image/x-icon"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Montserrat:wght@100..900&subset=latin,cyrillic"
    />
  </head>

  <body>
    <slot />

    <script is:inline>
      /* Плавный переход по якорям меню. Заменяет служебный блок
         rec4182947201: цель — <a name> или <div id>, стоп на 3px ниже её
         (замерено на оригинале: страница встаёт на top + 3),
         попапы и ссылки в новом окне не трогаем. */
      (function () {
        var OFFSET = 3;

        function target(hash) {
          var name = decodeURIComponent(hash.slice(1));
          if (!name) return null;
          return document.querySelector('a[name="' + name + '"], div[id="' + name + '"]');
        }

        function scrollToHash(hash, smooth) {
          var el = target(hash);
          if (!el) return false;
          var top = el.getBoundingClientRect().top + window.scrollY + OFFSET;
          window.scrollTo({ top: top, behavior: smooth ? 'smooth' : 'auto' });
          return true;
        }

        document.addEventListener('click', function (event) {
          var link = event.target.closest && event.target.closest('a[href^="#"]');
          if (!link || link.target === '_blank') return;

          var hash = link.getAttribute('href');
          if (hash === '#' || /^#(popup|closepopup|zeropopup|!)/.test(hash)) return;

          if (scrollToHash(hash, true)) event.preventDefault();
        });

        /* Переход на страницу сразу с якорем */
        window.addEventListener('load', function () {
          if (location.hash) setTimeout(function () { scrollToHash(location.hash, false); }, 1000);
        });

        window.addEventListener('popstate', function () {
          if (location.hash) scrollToHash(location.hash, false);
        });
      })();
    </script>
  </body>
</html>
