ps://t.me/hedpack_artem\">https://t.me/hedpack_artem</a>. Покажем полный перечень работ по разработке многостраничных сайтов и обсудим, как ваш бизнес может зарабатывать больше с помощью правильных маркетинговых инструментов.<br><br></div> </div> </div> </div>   </div>"},{"id":"780652558","type":"396","html":"<div id=\"rec780652558\" class=\"r t-rec\" style=\" \" data-animationappear=\"off\" data-record-type=\"396\">  <style>#rec780652558 .t396__artboard {height:4367px;}#rec780652558 .t396__filter {height:4367px;}#rec780652558 .t396__carrier{height:4367px;background-position:center center;background-attachment:scroll;background-size:cover;background-repeat:no-repeat;}@media screen and (max-width:1199px) {#rec780652558 .t396__artboard,#rec780652558 .t396__filter,#rec780652558 .t396__carrier {height:4149px;}#rec780652558 .t396__filter {}#rec780652558 .t396__carrier {background-attachment:scroll;}}@media screen and (max-width:959px) {#rec780652558 .t396__artboard,#rec780652558 .t396__filter,#rec780652558 .t396__carrier {height:1025px;}#rec780652558 .t396__filter {}#rec780652558 .t396__carrier {background-attachment:scroll;}}#rec780652558 .tn-elem[data-elem-id=\"1685121427765\"]{z-index:4;top:2846px;;left:calc(50% - 600px + 19px);;width:1161px;height:auto;}#rec780652558 .tn-elem[data-elem-id=\"1685121427765\"] .tn-atom{background-position:center center;border-width:var(--t396-borderwidth,0);border-style:var(--t396-borderstyle,solid);border-color:var(--t396-bordercolor,transparent);transition:background-color var(--t396-speedhover,0s) ease-in-out,color var(--t396-speedhover,0s) ease-in-out,border-color var(--t396-speedhover,0s) ease-in-out,box-shadow var(--t396-shadowshoverspeed,0.2s) ease-in-out;}@media screen and (max-width:1199px){#rec780652558 .tn-elem[data-elem-id=\"1685121427765\"]{top:2853px;;left:calc(50% - 480px + 9px);;width:941px;height:auto;}}@media screen and (max-width:959px){#rec780652558 .tn-elem[data-elem-id=\"1685121427765\"]{top:589px;;left:calc(50% - 