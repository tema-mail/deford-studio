<style is:global>
/* ===== слой 1 из Тильды ===== */
/* =========================================================
   DEFORD — FOOTER
   Desktop base: 1440 × 282
   Tablet: proportional desktop scale
   Mobile: one adaptive 300–640
   ========================================================= */

#deford-footer-v1,
#deford-footer-v1 * {
    box-sizing: border-box;
}

#deford-footer-v1 {
    --dark: #2f2f2f;
    --blue: #0f68ff;
    --white: #ffffff;

    position: relative;

    width: 100%;

    font-family: "Inter Tight", Inter, Arial, sans-serif;
}


/* =========================================================
   FULL WIDTH BACKGROUND
   ========================================================= */

#deford-footer-v1::before {
    content: "";

    position: absolute;
    z-index: 0;

    top: 0;
    bottom: 0;

    left: 50%;

    width: 100vw;
    width: 100dvw;

    transform: translateX(-50%);

    background: var(--dark);

    /* скругления только сверху */
    border-radius:
        min(40px, 2.7778vw)
        min(40px, 2.7778vw)
        0
        0;

    pointer-events: none;
}


/* =========================================================
   FOOTER CONTENT
   ========================================================= */

#deford-footer-v1 .dff-footer {
    position: relative;
    z-index: 1;

    width: 100%;
    max-width: 1440px;

    height: min(282px, 19.5833vw);

    margin: 0 auto;

    overflow: visible;

    /* фон теперь находится на ::before */
    background: transparent;

    /* снизу скруглений нет */
    border-radius: 0;
}


/* =========================================================
   TOP ROW
   ========================================================= */

#deford-footer-v1 .dff-top {
    position: absolute;

    left: min(60px, 4.1667vw);
    right: min(60px, 4.1667vw);
    top: min(38px, 2.6389vw);

    display: grid;

    grid-template-columns:
        min(178px, 12.3611vw)
        1fr
        min(178px, 12.3611vw);

    align-items: center;
}


/* =========================================================
   SOCIALS
   ========================================================= */

#deford-footer-v1 .dff-socials {
    display: flex;
    align-items: center;

    gap: min(1.2px, .0833vw);

    width: fit-content;
}

#deford-footer-v1 .dff-social {
    display: flex;
    align-items: center;
    justify-content: center;

    width: min(42px, 2.9167vw);
    height: min(42px, 2.9167vw);

    flex: 0 0 auto;

    border-radius: 50%;

    background: var(--white);

    color: var(--blue);

    text-decoration: none;

    transition:
        transform .2s ease,
        background-color .2s ease,
        color .2s ease;
}

#deford-footer-v1 .dff-social svg {
    display: block;

    width: min(12px, .8333vw);
    height: min(12px, .8333vw);

    flex: 0 0 auto;
}

#deford-footer-v1 .dff-social svg path {
    fill: currentColor;

    transition: fill .2s ease;
}


/* MAX чуть крупнее из-за пропорций оригинальной иконки */

#deford-footer-v1 .dff-social--max svg {
    width: min(14px, .9722vw);
    height: min(14px, .9722vw);
}


@media (hover:hover) {

    #deford-footer-v1 .dff-social:hover {
        transform: translateY(-2px);

        background: var(--blue);
        color: var(--white);
    }

}


/* =========================================================
   MENU
   ========================================================= */

#deford-footer-v1 .dff-menu {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: min(30px, 2.0833vw);

    min-width: 0;
}

#deford-footer-v1 .dff-menu-link {
    font-size: min(13.2px, .9167vw);
    font-weight: 600;

    line-height: 1.09;

    white-space: nowrap;

    color: #ffffff;

    text-decoration: none;

    transition: opacity .2s ease;
}

@media (hover:hover) {

    #deford-footer-v1 .dff-menu-link:hover {
        opacity: .65;
    }

}


/* =========================================================
   CTA BUTTON
   ========================================================= */

#deford-footer-v1 .dff-button-wrap {
    display: flex;
    justify-content: flex-end;
}

#deford-footer-v1 .dff-button {
    display: flex;
    align-items: center;
    justify-content: center;

    width: min(177.9px, 12.3542vw);
    height: min(42.4px, 2.9444vw);

    border-radius: 999px;

    background: var(--blue);

    color: #ffffff;

    font-size: min(13.2px, .9167vw);
    font-weight: 600;

    line-height: 1;

    text-decoration: none;

    white-space: nowrap;

    transition:
        transform .2s ease,
        filter .2s ease;
}

@media (hover:hover) {

    #deford-footer-v1 .dff-button:hover {
        transform: translateY(-2px);
        filter: brightness(.95);
    }

}


/* =========================================================
   BOTTOM LEGAL
   ========================================================= */

#deford-footer-v1 .dff-legal {
    position: absolute;

    left: min(60px, 4.1667vw);
    right: min(60px, 4.1667vw);
    top: min(141px, 9.7917vw);

    display: flex;
    justify-content: space-between;
    align-items: flex-end;
}


/* LEFT LINKS */

#deford-footer-v1 .dff-legal-left {
    display: flex;
    flex-direction: column;

    gap: min(8px, .5556vw);
}

#deford-footer-v1 .dff-legal-link,
#deford-footer-v1 .dff-credit {
    font-size: min(14px, .9722vw);
    font-weight: 500;

    line-height: 1.25;

    color: rgba(255,255,255,.4);

    text-decoration: none;

    transition: color .2s ease;
}

@media (hover:hover) {

    #deford-footer-v1 .dff-legal-link:hover,
    #deford-footer-v1 .dff-credit:hover {
        color: rgba(255,255,255,.75);
    }

}


/* CREDIT */

#deford-footer-v1 .dff-credit {
    align-self: flex-end;
}


/* =========================================================
   MOBILE — ONE ADAPTIVE 300–640
   ========================================================= */

@media screen and (max-width:640px) {

    /* фон на всю ширину + только верхние скругления */

    #deford-footer-v1::before {
        border-radius:
            clamp(24px, 7vw, 36px)
            clamp(24px, 7vw, 36px)
            0
            0;
    }


    #deford-footer-v1 .dff-footer {
        height: auto;
        min-height: 0;

        padding:
            clamp(28px, 8vw, 42px)
            clamp(18px, 5vw, 28px)
            clamp(24px, 7vw, 36px);

        border-radius: 0;
    }


    /* TOP */

    #deford-footer-v1 .dff-top {
        position: relative;

        left: auto;
        right: auto;
        top: auto;

        display: flex;
        flex-direction: column;
        align-items: stretch;

        gap: 28px;
    }


    /* SOCIALS */

    #deford-footer-v1 .dff-socials {
        gap: 8px;
    }

    #deford-footer-v1 .dff-social {
        width: 44px;
        height: 44px;
    }

    #deford-footer-v1 .dff-social svg {
        width: 13px;
        height: 13px;
    }

    #deford-footer-v1 .dff-social--max svg {
        width: 14px;
        height: 14px;
    }


    /* MENU */

    #deford-footer-v1 .dff-menu {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        justify-content: stretch;

        gap:
            14px
            20px;
    }

    #deford-footer-v1 .dff-menu-link {
        font-size: clamp(14px, 4vw, 16px);

        line-height: 1.15;

        white-space: normal;
    }


    /* CTA */

    #deford-footer-v1 .dff-button-wrap {
        justify-content: flex-start;
    }

    #deford-footer-v1 .dff-button {
        width: 100%;
        max-width: 260px;

        height: 52px;

        font-size: 15px;
    }


    /* LEGAL */

    #deford-footer-v1 .dff-legal {
        position: relative;

        left: auto;
        right: auto;
        top: auto;

        display: flex;
        flex-direction: column;
        align-items: flex-start;

        gap: 24px;

        margin-top: 48px;
    }

    #deford-footer-v1 .dff-legal-left {
        gap: 9px;
    }

    #deford-footer-v1 .dff-legal-link,
    #deford-footer-v1 .dff-credit {
        font-size: clamp(12px, 3.5vw, 14px);

        line-height: 1.25;
    }

    #deford-footer-v1 .dff-credit {
        align-self: flex-start;
    }

}


/* Keep the background inside the Vibe iframe on mobile. */
@media screen and (max-width: 640px) {
    #deford-footer-v1::before {
        left: 0;
        width: 100%;
        transform: none;
    }
}
</style>
