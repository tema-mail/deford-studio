/* ===== слой 1 из Тильды ===== */
/* =========================================================
   BASE
   ========================================================= */

.fmfaq {

  --ff-bg: #dbdbdb;
  --ff-dark: #202020;
  --ff-green: #cefe46;

  position: relative;

  width: 100%;

  margin: 0;
  padding: 0;

  overflow: hidden;

  background: #fff;

  color:
    var(--ff-dark);

  font-family:
    "Inter Tight",
    Inter,
    Arial,
    sans-serif;

}


.fmfaq,
.fmfaq * {

  box-sizing: border-box;

}



/* =========================================================
   VIEWPORT
   ========================================================= */

.fmfaq__viewport {

  position: relative;

  width: 100%;

  min-height: 945px;

  overflow: hidden;

  background:
    var(--ff-bg);

  border-radius:
    clamp(
      42px,
      6.25vw,
      120px
    );

}



/* =========================================================
   STAGE
   ========================================================= */

.fmfaq__stage {

  position: relative;

  width: 1200px;

  min-height: 945px;

  margin: 0 auto;

  padding-top:
    50px;

  padding-bottom:
    55px;

  transform-origin:
    top center;

}



/* =========================================================
   HEADER
   ========================================================= */

.fmfaq__header {

  width: 600px;

  margin:
    0 auto;

  text-align: center;

}


.fmfaq__tag {

  width: max-content;

  margin:
    0 auto
    15px;

  padding:
    7px
    10px;

  border:
    1px solid #ededee;

  border-radius:
    100px;

  background: #fff;

  font-size:
    11px;

  line-height:
    13px;

}


.fmfaq__title {

  width:
    469px;

  margin:
    0 auto;

  font-size:
    33px;

  line-height:
    33px;

  letter-spacing:
    -1px;

  font-weight:
    600;

}


.fmfaq__subtitle {

  width:
    246px;

  margin:
    15px
    auto
    0;

  color:
    rgba(
      32,
      32,
      32,
      .5
    );

  font-size:
    14px;

  line-height:
    18px;

  font-weight:
    500;

}



/* =========================================================
   LIST
   ========================================================= */

.fmfaq__list {

  width:
    1077px;

  margin:
    30px
    auto
    0;

  display:
    flex;

  flex-direction:
    column;

  gap:
    10px;

}



/* =========================================================
   ITEM
   ========================================================= */

.fmfaq__item {

  width:
    100%;

  overflow:
    hidden;

  border-radius:
    30px;

  background:
    rgba(
      255,
      255,
      255,
      .72
    );

}



/* =========================================================
   QUESTION
   ========================================================= */

.fmfaq__question {

  width:
    100%;

  min-height:
    64px;

  padding:
    10px
    20px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    30px;

  border:
    0;

  background:
    transparent;

  color:
    var(--ff-dark);

  text-align:
    left;

  cursor:
    pointer;

  font-family:
    inherit;

}


.fmfaq__question-text {

  min-width:
    0;

  font-size:
    22px;

  line-height:
    22px;

  letter-spacing:
    -.4px;

  font-weight:
    600;

}



/* =========================================================
   ICON
   ========================================================= */

.fmfaq__icon {

  width:
    44px;

  height:
    44px;

  flex:
    0 0
    44px;

}


.fmfaq__icon svg {

  display:
    block;

  width:
    100%;

  height:
    100%;

}


.fmfaq__icon-v {

  transform-origin:
    center;

  transition:
    transform
    .32s
    cubic-bezier(
      .2,
      .75,
      .25,
      1
    );

}


.fmfaq__item.is-open
.fmfaq__icon-v {

  transform:
    scaleY(0);

}



/* =========================================================
   ANSWER
   ========================================================= */

.fmfaq__answer {

  display:
    grid;

  grid-template-rows:
    0fr;

  transition:
    grid-template-rows
    .45s
    cubic-bezier(
      .2,
      .75,
      .25,
      1
    );

}


.fmfaq__item.is-open
.fmfaq__answer {

  grid-template-rows:
    1fr;

}


.fmfaq__answer-inner {

  min-height:
    0;

  overflow:
    hidden;

  padding:
    0
    100px
    0
    20px;

  color:
    rgba(
      32,
      32,
      32,
      .5
    );

  font-size:
    14px;

  line-height:
    18px;

  font-weight:
    500;

  transition:
    padding-bottom
    .45s
    cubic-bezier(
      .2,
      .75,
      .25,
      1
    );

}


.fmfaq__item.is-open
.fmfaq__answer-inner {

  padding-bottom:
    20px;

}



/* =========================================================
   ENTRY MOTION
   ========================================================= */

.fmfaq
[data-faq-anim] {

  opacity:
    0;

}


.fmfaq.is-visible
.fmfaq__tag {

  animation:
    ff-up
    .55s
    .02s
    both;

}


.fmfaq.is-visible
.fmfaq__title {

  animation:
    ff-up
    .75s
    .10s
    both;

}


.fmfaq.is-visible
.fmfaq__subtitle {

  animation:
    ff-up
    .70s
    .18s
    both;

}


.fmfaq.is-visible
.fmfaq__list {

  animation:
    ff-up
    .8s
    .25s
    both;

}



@keyframes ff-up {

  from {

    opacity:
      0;

    transform:
      translateY(22px);

  }


  to {

    opacity:
      1;

    transform:
      translateY(0);

  }

}



/* =========================================================
   TABLET / DESKTOP SCALE
   ========================================================= */

@media (min-width: 641px) {

  .fmfaq__stage {

    transform:
      scale(
        var(
          --ff-scale,
          1
        )
      );

  }

}



/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 640px) {


  .fmfaq {

    background:
      transparent;

  }


  .fmfaq__viewport {

    min-height:
      0;

    border-radius:
      36px;

  }


  .fmfaq__stage {

    width:
      100%;

    min-height:
      0;

    padding:
      48px
      16px
      40px;

  }



  /* HEADER */

  .fmfaq__header {

    width:
      100%;

  }


  .fmfaq__tag {

    margin-bottom:
      20px;

  }


  .fmfaq__title {

    width:
      100%;

    max-width:
      470px;

    font-size:
      clamp(
        27px,
        7.7vw,
        35px
      );

    line-height:
      .98;

    letter-spacing:
      -.8px;

  }


  .fmfaq__title br {

    display:
      none;

  }


  .fmfaq__subtitle {

    width:
      100%;

    max-width:
      340px;

    margin-top:
      18px;

    font-size:
      13px;

    line-height:
      1.25;

  }



  /* LIST */

  .fmfaq__list {

    width:
      100%;

    margin-top:
      34px;

    gap:
      8px;

  }



  /* ITEM */

  .fmfaq__item {

    border-radius:
      22px;

  }


  .fmfaq__question {

    min-height:
      64px;

    padding:
      10px
      12px
      10px
      16px;

    gap:
      14px;

  }


  .fmfaq__question-text {

    font-size:
      clamp(
        17px,
        4.8vw,
        21px
      );

    line-height:
      1.05;

  }


  .fmfaq__icon {

    width:
      44px;

    height:
      44px;

    flex-basis:
      44px;

  }


  .fmfaq__answer-inner {

    padding-left:
      16px;

    padding-right:
      16px;

    font-size:
      12px;

    line-height:
      1.3;

  }


  .fmfaq__item.is-open
  .fmfaq__answer-inner {

    padding-bottom:
