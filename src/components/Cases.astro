}

/* Case CTA arrow: legible at desktop and mobile sizes. */
#deford-case-v2 .dfc-button svg{width:20px;height:20px;flex:0 0 20px;}
@media(max-width:640px){#deford-case-v2 .dfc-button svg{width:18px;height:18px;flex-basis:18px;}}

/* Let horizontal gallery gestures win without blocking vertical scroll. */
