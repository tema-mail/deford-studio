<script is:inline>
(function () {


  const sections =
    document.querySelectorAll(
      '[data-fmprocess]'
    );


  sections.forEach(
    function (root) {


      if (
        root.dataset.fmProcessReady ===
        '1'
      ) {

        return;

      }


      root.dataset.fmProcessReady =
        '1';



      const shell =
        root.querySelector(
          '.fmprocess__scroll-shell'
        );


      const sticky =
        root.querySelector(
          '.fmprocess__sticky'
        );


      const viewport =
        root.querySelector(
          '.fmprocess__viewport'
        );


      const cardsWindow =
        root.querySelector(
          '.fmprocess__cards-window'
        );


      const cards =
        root.querySelector(
          '[data-process-cards]'
        );



      /* =====================================================
         CONFIG
         ===================================================== */

      const BASE_WIDTH =
        1200;


      const BASE_HEIGHT =
        675;


      const BASE_WINDOW_HEIGHT =
        645;



      /* =====================================================
         STATE
         ===================================================== */

      let scale =
        1;


      let maxCardTravel =
        0;


      let targetY =
        0;


      let currentY =
        0;



      const reduceMotion =
        window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        );



      /* =====================================================
         TILDA EDITOR

         Disable sticky behavior while editing.
         ===================================================== */

      function isTildaEditor() {


        const body =
          document.body;


        const html =
          document.documentElement;


        return (

          body.classList.contains(
            't-body_edit'
          )

          ||

          body.classList.contains(
            'tilda-mode-edit'
          )

          ||

          html.classList.contains(
            'tilda-mode-edit'
          )

          ||

          !!document.querySelector(
            '.t-edit-toolbar'
          )

        );


      }



      /* =====================================================
         MEASURE

         Automatically adapts to ANY number of cards.
         ===================================================== */

      function measure() {


        const rootWidth =
          root
            .getBoundingClientRect()
            .width;



        /* MOBILE */

        if (
          rootWidth <= 640
        ) {


          scale = 1;


          root.style.removeProperty(
            '--fp-scale'
          );


          shell.style.height =
            'auto';


          sticky.style.height =
            'auto';


          viewport.style.height =
            'auto';


          cards.style.transform =
            'none';


          return;

        }



        /* DESKTOP / TABLET */

        scale =
          rootWidth /
          BASE_WIDTH;



        root.style.setProperty(
          '--fp-scale',
          scale
        );



        const visibleHeight =
          BASE_HEIGHT *
          scale;



        sticky.style.height =
          visibleHeight +
          'px';


        viewport.style.height =
          visibleHeight +
          'px';



        /*
         * Actual card rail height in
         * original 1200 coordinate space.
         */

        const railHeight =
          cards.scrollHeight;



        /*
         * How far the cards need to move upward
         * until the final card sits fully
         * inside the visible window.
         */

        maxCardTravel =
          Math.max(
            0,
            railHeight -
            BASE_WINDOW_HEIGHT
          );



        /*
         * In Tilda editor:
         * no scroll animation / extended runway.
         */

        if (
          isTildaEditor()
        ) {


          shell.style.height =
            visibleHeight +
            'px';


          targetY =
            0;


          currentY =
            0;


          cards.style.transform =
            'translate3d(0,0,0)';


          return;

        }



        /*
         * Published site.

         * Scroll distance is proportional
         * to the card travel.

         * A small multiplier makes the
         * motion feel slower and smoother.
         */

        const scrollDistance =
          maxCardTravel *
          scale *
          1.15;



        shell.style.height =
          (
            visibleHeight +
            scrollDistance
          )
          +
          'px';


      }



      /* =====================================================
         SCROLL PROGRESS
         ===================================================== */

      function updateTarget() {


        if (
          window.innerWidth <= 640
          ||
          isTildaEditor()
        ) {


          targetY =
            0;


          return;

        }



        if (
          reduceMotion.matches
        ) {


          targetY =
            0;


          return;

        }



        const shellRect =
          shell
            .getBoundingClientRect();



        const visibleHeight =
          BASE_HEIGHT *
          scale;



        const scrollRange =
          Math.max(
            1,
            shell.offsetHeight -
            visibleHeight
          );



        const travelled =
          Math.max(
            0,
            Math.min(
              scrollRange,
              -shellRect.top
            )
          );



        const progress =
          travelled /
          scrollRange;



        targetY =
          -maxCardTravel *
          progress;


      }



      /* =====================================================
         SMOOTH FOLLOW

         Cards softly catch up with scroll.
         ===================================================== */

      function animate() {


        if (
          window.innerWidth > 640
          &&
          !isTildaEditor()
          &&
          !reduceMotion.matches
        ) {


          currentY +=
            (
              targetY -
              currentY
            )
            *
            .09;



          if (
            Math.abs(
              targetY -
              currentY
            )
            <
            .01
          ) {


            currentY =
              targetY;

          }



          cards.style.transform =
            'translate3d(0,' +
            currentY.toFixed(2) +
            'px,0)';


        }



        requestAnimationFrame(
          animate
        );


      }



      /* =====================================================
         SCROLL
         ===================================================== */

      let ticking =
        false;



      function onScroll() {


        if (
          ticking
        ) {

          return;

        }


        ticking =
          true;



        requestAnimationFrame(
          function () {


            updateTarget();


            ticking =
              false;


          }
        );


      }



      /* =====================================================
         RESIZE
         ===================================================== */

      function onResize() {


        measure();

        updateTarget();


      }



      window.addEventListener(
        'scroll',
        onScroll,
        {
          passive: true
        }
      );


      window.addEventListener(
        'resize',
        onResize,
        {
          passive: true
        }
      );



      if (
        'ResizeObserver'
        in window
      ) {


        const ro =
          new ResizeObserver(
            function () {


              measure();

              updateTarget();


            }
          );


        ro.observe(
          root
        );


        ro.observe(
          cards
        );


      }



      /* =====================================================
         ENTRY
         ===================================================== */

      if (
        reduceMotion.matches
      ) {


        root.classList.add(
          'is-visible'
        );


      } else {


        const observer =
          new IntersectionObserver(

            function (entries) {


              entries.forEach(
                function (entry) {


                  if (
                    !entry.isIntersecting
                  ) {

                    return;

                  }


                  root.classList.add(
                    'is-visible'
                  );


                  observer.disconnect();


                }
              );


            },

            {
              threshold:
                .08
            }

          );


        observer.observe(
          root
        );


      }



      /* =====================================================
         INIT
         ===================================================== */

      measure();

      updateTarget();

      animate();


    }
  );


})();
</script>
