<style is:global>
/* ===== слой 1 из Тильды ===== */
/* =========================================================
   BASE
   ========================================================= */

.fmreviews {

  --fr-bg: #dbdbdb;
  --fr-dark: #202020;
  --fr-green: #cefe46;

  position: relative;

  width: 100%;

  margin: 0;
  padding: 0;

  overflow: hidden;

  background: #fff;

  color:
    var(--fr-dark);

  font-family:
    "Inter Tight",
    Inter,
    Arial,
    sans-serif;

}


.fmreviews,
.fmreviews * {
  box-sizing: border-box;
}



/* =========================================================
   VIEWPORT
   ========================================================= */

.fmreviews__viewport {

  position: relative;

  width: 100%;

  height: 720px;

  overflow: hidden;

  background:
    var(--fr-bg);

  border-radius:
    clamp(
      42px,
      6.25vw,
      120px
    );

}



/* =========================================================
   STAGE
   ========================================================= */

.fmreviews__stage {

  position: absolute;

  left: 50%;
  top: 0;

  width: 1200px;
  height: 720px;

  transform-origin:
    top center;

  transform:
    translateX(-50%)
    scale(var(--fr-scale,1));

}



/* =========================================================
   HEADER
   ========================================================= */

.fmreviews__header {

  position: absolute;

  z-index: 20;

  left: 50%;
  top: 82px;

  width: 820px;

  transform:
    translateX(-50%);

  text-align: center;

}


.fmreviews__tag {

  width: max-content;

  margin:
    0
    auto
    28px;

  padding:
    7px
    10px;

  border:
    1px
    solid
    #ededee;

  border-radius:
    100px;

  background:
    #fff;

  font-size:
    11px;

  line-height:
    13px;

  font-weight:
    400;

}


.fmreviews__title {

  width: 758px;

  max-width:
    100%;

  margin:
    0
    auto;

  font-size:
    33px;

  line-height:
    33px;

  letter-spacing:
    -1px;

  font-weight:
    600;

}



/* =========================================================
   RAIL WINDOW
   ========================================================= */

.fmreviews__rail-window {

  position: absolute;

  z-index: 5;

  left: 0;
  right: 0;

  top: 220px;

  height: 382px;

  overflow: hidden;

}



/* =========================================================
   RAIL
   ========================================================= */

.fmreviews__rail {

  position: absolute;

  left: 0;
  top: 0;

  display: flex;

  align-items:
    center;

  gap: 12px;

  width:
    max-content;

  will-change:
    transform;

  transform:
    translate3d(
      0,
      0,
      0
    );

}



/* =========================================================
   VIDEO CARD
   212 × 374
   ========================================================= */

.fmreviews__screen {

  position:
    relative;

  flex:
    0
    0
    212px;

  width:
    212px;

  height:
    374px;

  overflow:
    hidden;

  border-radius:
    20px;

  background:
    #111;

  box-shadow:
    0
    12px
    30px
    rgba(
      0,
      0,
      0,
      .04
    );

  isolation:
    isolate;

}



/* =========================================================
   KINESCOPE
   ========================================================= */

.fmreviews__video {

  position:
    absolute;

  z-index:
    1;

  inset:
    0;

  display:
    block;

  width:
    100%;

  height:
    100%;

  border:
    0;

  background:
    #111;

  pointer-events:
    none;

}



/*
 * После активации разрешаем
 * пользоваться Kinescope-плеером.
 */

.fmreviews__screen.is-active
.fmreviews__video {

  pointer-events:
    auto;

}



/* =========================================================
   PLAY OVERLAY
   ========================================================= */

.fmreviews__play {

  position:
    absolute;

  z-index:
    5;

  inset:
    0;

  width:
    100%;

  height:
    100%;

  margin:
    0;

  padding:
    0;

  border:
    0;

  background:
    linear-gradient(
      180deg,
      rgba(0,0,0,0) 55%,
      rgba(0,0,0,.08) 100%
    );

  cursor:
    pointer;

  transition:
    opacity
    .25s
    ease;

}


.fmreviews__play-circle {

  position:
    absolute;

  left:
    50%;

  top:
    50%;

  width:
    54px;

  height:
    54px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  border-radius:
    50%;

  transform:
    translate(
      -50%,
      -50%
    );

  background:
    rgba(
      32,
      32,
      32,
      .38
    );

  backdrop-filter:
    blur(5px);

  -webkit-backdrop-filter:
    blur(5px);

  transition:
    transform
    .25s
    ease,
    background-color
    .25s
    ease;

}


.fmreviews__play-circle svg {

  width:
    20px;

  height:
    20px;

  margin-left:
    2px;

}


.fmreviews__play:hover
.fmreviews__play-circle {

  transform:
    translate(
      -50%,
      -50%
    )
    scale(
      1.08
    );

  background:
    rgba(
      32,
      32,
      32,
      .58
    );

}


.fmreviews__screen.is-active
.fmreviews__play {

  opacity:
    0;

  visibility:
    hidden;

  pointer-events:
    none;

}



/* =========================================================
   CLOSE
   ========================================================= */

.fmreviews__close {

  position:
    absolute;

  z-index:
    20;

  right:
    10px;

  top:
    10px;

  width:
    34px;

  height:
    34px;

  padding:
    0;

  border:
    0;

  border-radius:
    50%;

  background:
    rgba(
      32,
      32,
      32,
      .78
    );

  backdrop-filter:
    blur(5px);

  -webkit-backdrop-filter:
    blur(5px);

  cursor:
    pointer;

  opacity:
    0;

  visibility:
    hidden;

  pointer-events:
    none;

  transition:
    opacity
    .25s
    ease,
    transform
    .25s
    ease;

}


.fmreviews__close span {

  position:
    absolute;

  left:
    50%;

  top:
    50%;

  width:
    14px;

  height:
    2px;

  border-radius:
    10px;

  background:
    #fff;

}


.fmreviews__close span:first-child {

  transform:
    translate(
      -50%,
      -50%
    )
    rotate(
      45deg
    );

}


.fmreviews__close span:last-child {

  transform:
    translate(
      -50%,
      -50%
    )
    rotate(
      -45deg
    );

}


.fmreviews__screen.is-active
.fmreviews__close {

  opacity:
    1;

  visibility:
    visible;

  pointer-events:
    auto;

}


.fmreviews__close:hover {

  transform:
    scale(
      1.08
    );

}



/* =========================================================
   CTA
   ========================================================= */

.fmreviews__cta-wrap {

  position:
    absolute;

  z-index:
    30;

  left:
    50%;

  bottom:
    22px;

  width:
    640px;

  min-height:
    84px;

  padding:
    15px;

  transform:
    translateX(-50%);

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    20px;

  border-radius:
    10px;

  background:
    rgba(
      32,
      32,
      32,
      .96
    );

  backdrop-filter:
    blur(
      7.5px
    );

  -webkit-backdrop-filter:
    blur(
      7.5px
    );

}



/* =========================================================
   CTA TEXT
   ========================================================= */

.fmreviews__cta-info {

  width:
    365px;

  display:
    flex;

  flex-direction:
    column;

  gap:
    3px;

}


.fmreviews__cta-title {

  color:
    #fff;

  font-size:
    15px;

  line-height:
    17px;

  letter-spacing:
    -.5px;

  font-weight:
    500;

}


.fmreviews__cta-text {

  width:
    350px;

  max-width:
    100%;

  color:
    rgba(
      255,
      255,
      255,
      .6
    );

  font-size:
    11px;

  line-height:
    13px;

  font-weight:
    500;

}



/* =========================================================
   CTA BUTTON
   ========================================================= */

.fmreviews__button {

  position:
    relative;

  min-height:
    54px;

  display:
    flex;

  align-items:
    center;

  gap:
    13px;

  padding:
    5px
    5px
    5px
    25px;

  flex:
    0
    0
    auto;

  border-radius:
    100px;

  background:
    var(--fr-green);

  color:
    var(--fr-dark);

  text-decoration:
    none;

  font-size:
    14.8px;

  line-height:
    16px;

  font-weight:
    600;

  white-space:
    nowrap;

  transition:
    transform
    .3s
    cubic-bezier(
      .2,
      .75,
      .25,
      1
    );

}


.fmreviews__button:hover {

  transform:
    translateY(
      -2px
    );

}


.fmreviews__button-icon {

  width:
    44px;

  height:
    44px;

  flex:
    0
    0
    44px;

}


.fmreviews__button-icon svg {

  display:
    block;

  width:
    100%;

  height:
    100%;

}



/* =========================================================
   INITIAL
   ========================================================= */

.fmreviews
[data-review-anim] {

  opacity:
    0;

}



/* =========================================================
   ENTRANCE
   ========================================================= */

.fmreviews.is-visible
[data-review-anim="tag"] {

  animation:
    fr-up
    .55s
    cubic-bezier(
      .2,
      .75,
      .25,
      1
    )
    .02s
    both;

}


.fmreviews.is-visible
[data-review-anim="title"] {

  animation:
    fr-up
    .75s
    cubic-bezier(
      .2,
      .75,
      .25,
      1
    )
    .10s
    both;

}


.fmreviews.is-visible
[data-review-anim="rail"] {

  animation:
    fr-rail-in
    .85s
    cubic-bezier(
      .16,
      .82,
      .21,
      1
    )
    .22s
    both;

}


.fmreviews.is-visible
[data-review-anim="cta"] {

  animation:
    fr-up-centered
    .65s
    cubic-bezier(
      .2,
      .75,
      .25,
      1
    )
    .36s
    both;

}



/* =========================================================
   KEYFRAMES
   ========================================================= */

@keyframes fr-up {

  from {

    opacity:
      0;

    transform:
      translateY(
        22px
      );

  }


  to {

    opacity:
      1;

    transform:
      translateY(
        0
      );

  }

}


@keyframes fr-up-centered {

  from {

    opacity:
      0;

    transform:
      translateX(
        -50%
      )
      translateY(
        22px
      );

  }


  to {

    opacity:
      1;

    transform:
      translateX(
        -50%
      )
      translateY(
        0
      );

  }

}


@keyframes fr-rail-in {

  from {

    opacity:
      0;

    transform:
      translateY(
        30px
      );

  }


  to {

    opacity:
      1;

    transform:
      translateY(
        0
      );

  }

}



