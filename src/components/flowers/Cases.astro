  }


  .fmcases__title {

    width: 100%;

    max-width:
      430px;

    font-size:
      clamp(
        27px,
        7.7vw,
        35px
      );

    line-height:
      .98;

    letter-spacing:
      -.8px;

  }


  .fmcases__title br {

    display: none;

  }



  /* =========================
     CARDS
     ========================= */

  .fmcases__grid {

    position: relative;

    left: auto;
    right: auto;
    top: auto;

    width: 100%;

    margin-top:
      38px;

    display: flex;

    flex-direction: column;

    gap: 12px;

  }


  .fmcases__card {

    width: 100%;

    height: auto;

    padding:
      clamp(
        18px,
        5vw,
        24px
      );

    gap: 16px;

    border-radius:
      24px;

  }


  .fmcases__card--center {

    transform: none;

  }



  /* =========================
     IMAGE
     ========================= */

  .fmcases__image {

    width: 100%;

    height: auto;

    min-height: 0;

    flex: none;

    display: block;

    overflow: hidden;

  }


  .fmcases__image img {

    width: 100%;

    height: auto;

    object-fit: contain;

  }



  /* =========================
     TEXT
     ========================= */

  .fmcases__card-title {

    width: 100%;

    max-width: 100%;

    font-size:
      clamp(
        20px,
        5.7vw,
        25px
      );

    line-height: 1;

  }


  .fmcases__card-meta {

    margin-top: 0;

    font-size:
      clamp(
        10px,
        2.8vw,
        12px
      );

  }


  .fmcases__more {

    margin-top: 8px;

    padding-top: 0;

    font-size: 14px;

    line-height: 16px;

  }



  /* =========================
     CTA
     ========================= */

  .fmcases__cta-wrap {

    position: relative;

    left: auto;
    right: auto;
    bottom: auto;

    width: 100%;

    margin-top:
      22px;

    display: block;

  }


  .fmcases__cta {

    position: relative;

    width: 100%;

    min-height: 55px;

    display: flex;

    align-items: center;

    justify-content: center;

    padding:
      5px
      55px;

    text-align: center;

  }


  .fmcases__cta-label {

    width: 100%;

    text-align: center;

  }


  .fmcases__cta-icon {

    position: absolute;

    right: 5px;

    top: 50%;

    transform:
      translateY(-50%);

  }



  /* =========================
     MOBILE MOTION
     ========================= */

  .fmcases.is-visible
  .fmcases__card--center {

    animation:
      fcCard
      .75s
      cubic-bezier(.16,.82,.21,1)
      .32s
      both;

  }


}



/* =========================================================
   SMALL MOBILE 300–350
   ========================================================= */

@media (max-width: 350px) {


  .fmcases__stage {

    padding-left:
      12px;

    padding-right:
      12px;

  }


  .fmcases__title {

    font-size:
      25px;

  }


  .fmcases__card {

    padding:
      16px;

  }


}



/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media
(prefers-reduced-motion: reduce) {


  .fmcases
  [data-cases-anim],

  .fmcases
  [data-cases-card] {

    opacity:
      1 !important;

    animation:
      none !important;

    transition:
      none !important;

  }


  .fmcases__card--center {

    transform:
      translateY(26px);

  }


}


@media
(max-width: 640px)
and
(prefers-reduced-motion: reduce) {


  .fmcases__card--center {

    transform: none;

  }


}

/* ===== слой 2 из Тильды ===== */
.fmcases__more {
    color: #abd243;
}
</style>

<script is:inline>
(function () {


  const sections =
    document.querySelectorAll(
      '[data-fmcases]'
    );


  sections.forEach(
    function (root) {


      if (
        root.dataset.fmCasesReady ===
        '1'
      ) {

        return;

      }


      root.dataset.fmCasesReady =
        '1';


      const viewport =
        root.querySelector(
          '.fmcases__viewport'
        );



      /* =====================================================
         AUTOSCALE
         ===================================================== */

      function updateScale() {


        const width =
          root
            .getBoundingClientRect()
            .width;



        if (
          width <= 640
        ) {


          root.style.removeProperty(
            '--fc-scale'
          );


          viewport.style.height =
            '';


          return;


        }



        const scale =
          width / 1200;



        root.style.setProperty(
          '--fc-scale',
          scale
        );


        viewport.style.height =
          Math.round(
            720 * scale
          )
          + 'px';


      }



      updateScale();



      if (
        'ResizeObserver'
        in window
      ) {


        const ro =
          new ResizeObserver(
            updateScale
          );


        ro.observe(
          root
        );


      } else {


        window.addEventListener(
          'resize',
          updateScale,
          {
            passive: true
          }
        );


      }



      /* =====================================================
         ENTRANCE MOTION
         ===================================================== */

      const reduceMotion =
        window
          .matchMedia(
            '(prefers-reduced-motion: reduce)'
          )
          .matches;



      if (
        reduceMotion
      ) {


        root
          .classList
          .add(
            'is-visible'
          );


        return;


      }



      const observer =
        new IntersectionObserver(

          function (entries) {


            entries.forEach(
              function (entry) {


                if (
                  !entry.isIntersecting
                ) {

                  return;

                }


                root
                  .classList
                  .add(
                    'is-visible'
                  );


                observer.disconnect();


              }
            );


          },

          {
            threshold: .12
          }

        );



      observer.observe(
        root
      );


    }
  );


})();
</script>
