top\" data-field-axisx-value=\"left\" data-field-container-value=\"grid\" data-field-topunits-value=\"px\" data-field-leftunits-value=\"px\" data-field-heightunits-value=\"px\" data-field-widthunits-value=\"px\" data-field-textfit-value=\"autoheight\" data-field-fontsize-value=\"17\" data-field-top-res-320-value=\"421\" data-field-left-res-320-value=\"24\" data-field-width-res-320-value=\"285\" data-field-fontsize-res-320-value=\"12\" data-field-top-res-960-value=\"102\" data-field-left-res-960-value=\"43\" data-field-width-res-960-value=\"429\" data-field-fontsize-res-960-value=\"14\"> <div class='tn-atom'field='tn_text_1676614112888'><span style=\"background-color: rgb(255, 255, 255);\">Пансионат «Бриз» начал свою работу с 1983 года и является для многих любимым местом отдыха. В пансионате работает гостеприимный персонал и лучшие повара, а также пансионат имеет свой собственный песочно-галечный пляж.</span><br><br><span style=\"background-color: rgb(255, 255, 255);\">Для «Бриза» мы разработали нереально современный лендинг в спокойно-голубых тонах, с красивым пейзажем на заднем фоне и анимацией. На нем представлена вся необходимая информация, чтобы узнать о пансионате получше и выбрать его в качестве места для отдыха.</span></div> </div> </div> </div>   </div>"},{"id":"553580069","type":"396","html":"<div id=\"rec553580069\" class=\"r t-rec\" style=\" \" data-animationappear=\"off\" data-record-type=\"396\">  <style>#rec553580069 .t396__artboard {height:4660px;}#rec553580069 .t396__filter {height:4660px;}#rec553580069 .t396__carrier{height:4660px;background-position:center center;background-attachment:scroll;background-size:cover;background-repeat:no-repeat;}@media screen and (max-width:1199px) {#rec553580069 .t396__artboard,#rec553580069 .t396__filter,#rec553580069 .t396__carrier {height:3830px;}#rec553580069 .t396__filter {}#rec553580069 .t396__carrier {background-attachment:scroll;}}@media screen and (max-width:959px) {#rec553580069 .t396__artboard,#rec55358006