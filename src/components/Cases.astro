<style is:global>
/* ===== слой 1 из Тильды ===== */
/* =========================================================
   DEFORD — CASE BLOCK V2
   Галерея до 8 изображений

   Desktop = auto-scale
   Tablet = scaled desktop
   Mobile = one adaptive 300–640px
   ========================================================= */

#deford-case-v2,
#deford-case-v2 * {
    box-sizing: border-box;
}

#deford-case-v2 {
    --blue: #0f68ff;
    --black: #2f2f2f;
    --text: #525252;
    --light: #f3f3f3;
    --grey: #dadada;
    --white: #ffffff;

    width: 100%;
    overflow: hidden;

    background: #ffffff;

    font-family: Inter, Arial, sans-serif;
}


/* =========================================================
   CONTAINER
   ========================================================= */

#deford-case-v2 .dfc-container {
    width: 100%;
    max-width: 1440px;

    margin: 0 auto;

    padding-left: min(60px, 4.1667vw);
    padding-right: min(60px, 4.1667vw);
}


/* =========================================================
   MAIN
   ========================================================= */

#deford-case-v2 .dfc-layout {
    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);

    gap: min(20px, 1.3889vw);

    width: 100%;
}


/* =========================================================
   LEFT
   ========================================================= */

#deford-case-v2 .dfc-left {
    display: flex;
    flex-direction: column;

    height: min(603px, 41.875vw);
}

#deford-case-v2 .dfc-title {
    width: min(579px, 40.2083vw);

    margin: 0;

    font-family: Arial, Helvetica, sans-serif;

    font-size: min(65px, 4.5139vw);
    font-weight: 700;

    line-height: .95;
    letter-spacing: -.06em;

    color: var(--black);
}

#deford-case-v2 .dfc-description {
    width: min(358px, 24.8611vw);

    margin:
        min(20px, 1.3889vw)
        0
        0;

    font-size: min(15px, 1.0417vw);
    font-weight: 400;

    line-height: 1;

    color: var(--text);
}


/* =========================================================
   VIDEO BUTTON
   ========================================================= */

#deford-case-v2 .dfc-button {
    position: relative;

    display: flex;
    align-items: center;

    width: min(270px, 18.75vw);
    height: min(64px, 4.4444vw);

    margin-top: auto;

    padding-left: min(25px, 1.7361vw);
    padding-right: min(7px, .4861vw);

    border-radius: 999px;

    background: var(--blue);

    color: var(--grey);

    text-decoration: none;

    transition:
        transform .25s ease,
        filter .25s ease;
}

#deford-case-v2 .dfc-button-text {
    font-size: min(16px, 1.1111vw);
    font-weight: 500;

    line-height: 1;

    white-space: nowrap;
}

#deford-case-v2 .dfc-button-circle {
    position: absolute;

    top: min(7px, .4861vw);
    right: min(7px, .4861vw);

    display: flex;
    align-items: center;
    justify-content: center;

    width: min(50px, 3.4722vw);
    height: min(50px, 3.4722vw);

    border-radius: 50%;

    background: #ffffff;

    transition: transform .3s ease;
}

#deford-case-v2 .dfc-button-circle svg {
    width: min(12px, .8333vw);
    height: min(12px, .8333vw);

    fill: none;
    stroke: #111111;

    stroke-width: 1.5;
}

@media (hover:hover) {

    #deford-case-v2 .dfc-button:hover {
        transform: translateY(-2px);
        filter: brightness(.96);
    }

    #deford-case-v2
    .dfc-button:hover
    .dfc-button-circle {
        transform: rotate(45deg);
    }

}


/* =========================================================
   RIGHT CARD
   ========================================================= */

#deford-case-v2 .dfc-card {
    position: relative;

    width: 100%;
    height: min(603px, 41.875vw);

    overflow: hidden;

    border-radius: min(40px, 2.7778vw);

    background: var(--light);
}


/* =========================================================
   METRICS
   ========================================================= */

#deford-case-v2 .dfc-metrics {
    position: absolute;

    top: min(40px, 2.7778vw);
    left: min(40px, 2.7778vw);
    right: min(40px, 2.7778vw);

    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);

    row-gap: min(40px, 2.7778vw);
}

#deford-case-v2 .dfc-number {
    margin: 0;

    font-family: Arial, Helvetica, sans-serif;

    font-size: min(48px, 3.3333vw);
    font-weight: 700;

    line-height: .95;
    letter-spacing: -.06em;

    color: var(--black);
}

#deford-case-v2 .dfc-metric-text {
    width: min(285px, 19.7917vw);

    margin:
        min(10px, .6944vw)
        0
        0;

    font-size: min(15px, 1.0417vw);
    font-weight: 400;

    line-height: 1;

    color: var(--text);
}


/* =========================================================
   GALLERY
   ========================================================= */

#deford-case-v2 .dfc-gallery {
    position: absolute;

    left: min(40px, 2.7778vw);
    right: min(40px, 2.7778vw);
    bottom: min(40px, 2.7778vw);

    height: min(223px, 15.4861vw);

    overflow: visible;
}


/* viewport */

#deford-case-v2 .dfc-gallery-viewport {
    position: relative;

    width: 100%;
    height: 100%;

    overflow: hidden;

    border-radius: min(21px, 1.4583vw);

    background: #e8e8e8;

    touch-action: pan-y;
}


/* track */

#deford-case-v2 .dfc-gallery-track {
    display: flex;

    width: 100%;
    height: 100%;

    transform: translate3d(0,0,0);

    transition:
        transform
        .55s
        cubic-bezier(.22,.61,.36,1);

    will-change: transform;
}


/* slide */

#deford-case-v2 .dfc-slide {
    position: relative;

    flex: 0 0 100%;

    width: 100%;
    height: 100%;

    overflow: hidden;
}


/* image */

#deford-case-v2 .dfc-image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;
}


/* =========================================================
   ARROWS
   ========================================================= */

#deford-case-v2 .dfc-nav {
    position: absolute;

    z-index: 10;

    top: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    width: min(38px, 2.6389vw);
    height: min(38px, 2.6389vw);

    padding: 0;

    border: 0;
    border-radius: 50%;

    background: var(--blue);

    cursor: pointer;

    transform: translateY(-50%);

