<style is:global>
/* ===== слой 1 из Тильды ===== */
/* =========================================================
   DEFORD — WHEN TO CONTACT
   Desktop: 1440 base + auto-scale
   Tablet: scaled desktop
   Mobile: one adaptive 300–640
   ========================================================= */

#deford-when-v1,
#deford-when-v1 * {
    box-sizing: border-box;
}

#deford-when-v1 {
    --blue: #0f68ff;
    --black: #2f2f2f;
    --text: #525252;
    --light: #f3f3f3;
    --white: #ffffff;

    width: 100%;
    overflow: hidden;

    background: #ffffff;

    font-family: Inter, Arial, sans-serif;
}


/* =========================================================
   CONTAINER
   ========================================================= */

#deford-when-v1 .dfw-container {
    width: 100%;
    max-width: 1440px;

    margin: 0 auto;

    padding-left: min(60px, 4.1667vw);
    padding-right: min(60px, 4.1667vw);
}


/* =========================================================
   HEADER
   ========================================================= */

#deford-when-v1 .dfw-header {
    position: relative;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    width: 100%;
    min-height: min(124px, 8.6111vw);
}

#deford-when-v1 .dfw-title {
    width: min(698px, 48.4722vw);

    margin: 0;

    font-family: Arial, Helvetica, sans-serif;

    font-size: min(65px, 4.5139vw);
    font-weight: 700;

    line-height: .95;
    letter-spacing: -0.06em;

    color: var(--black);
}


/* =========================================================
   NAVIGATION
   ========================================================= */

#deford-when-v1 .dfw-nav {
    display: flex;
    align-items: center;

    gap: min(10px, .6944vw);

    padding-bottom: min(8px, .5556vw);

    flex: 0 0 auto;
}

#deford-when-v1 .dfw-arrow {
    display: flex;
    align-items: center;
    justify-content: center;

    width: min(50px, 3.4722vw);
    height: min(50px, 3.4722vw);

    padding: 0;

    border: 0;
    border-radius: 50%;

    cursor: pointer;

    transition:
        transform .2s ease,
        opacity .2s ease,
        background-color .18s ease;
}

#deford-when-v1 .dfw-arrow--prev,
#deford-when-v1 .dfw-arrow--next {
    background: var(--light);
}

#deford-when-v1 .dfw-arrow svg {
    display: block;

    width: min(12px, .8333vw);
    height: min(12px, .8333vw);

    fill: none;

    stroke: var(--black);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
}

#deford-when-v1 .dfw-arrow--prev svg {
    transform: rotate(180deg);
}

#deford-when-v1 .dfw-arrow:hover {
    transform: scale(1.05);
}

#deford-when-v1 .dfw-arrow:active,
#deford-when-v1 .dfw-arrow.is-pressed {
    background: var(--blue);
}

#deford-when-v1 .dfw-arrow:active svg,
#deford-when-v1 .dfw-arrow.is-pressed svg {
    stroke: #ffffff;
}


/* =========================================================
   SLIDER
   ========================================================= */

#deford-when-v1 .dfw-slider {
    width: 100%;

    margin-top: min(30px, 2.0833vw);

    overflow: hidden;
}

#deford-when-v1 .dfw-track {
    display: flex;

    gap: min(15px, 1.0417vw);

    width: 100%;

    transition: transform .45s cubic-bezier(.22,.61,.36,1);
    will-change: transform;
}


/* =========================================================
   CARD
   Figma: 430 × 434
   ========================================================= */

#deford-when-v1 .dfw-card {
    position: relative;

    flex:
        0
        0
        calc((100% - min(30px, 2.0833vw)) / 3);

    height: min(434px, 30.1389vw);

    overflow: hidden;

    border-radius: min(40px, 2.7778vw);

    background: var(--light);
