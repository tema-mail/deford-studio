---
/** Тарифы «Выбирайте формат сотрудничества» — по макету Figma
    (узлы 5:234–5:315). Три колонки 418 px: сверху плитка с хромированным
    предметом и названием, снизу карточка со списком, ценой и кнопкой.
    Белая, красная (выделенная) и чёрная. Шрифт всего блока — Inter Tight,
    как в макете.

    Карточки в ряду тянутся до одной высоты, ценовой блок прижат к низу —
    цены и кнопки стоят на одной линии.
    Кнопка «Оплатить полностью» открывает заявку со своим тарифом. */

const plans = [
  {
    tone: 'light',
    icon: 'mic',
    title: 'Консультация по рекламе ВКонтакте',
    sub: 'Идеально для микробизнеса и начинающих предпринимателей',
    price: '15 000 ₽',
    items: [
      'Аудит рекламного кабинета: аудитории, тексты, креативы',
      'Рекомендации по упаковке сообщества и контенту',
      'Подсказки по обработке заявок и воронке продаж',
      'Онлайн-сессия 1,5 – 2 часа',
      'Вы получите чёткий план действий: сможете самостоятельно запустить рекламу или контролировать работу таргетолога',
    ],
    gifts: [],
    hook: '#zeropopupconsult',
  },
  {
    tone: 'red',
    icon: 'megaphone',
    title: 'Настройка таргетированной рекламы',
    sub: 'Для предпринимателей, которые хотят получать клиентов уже в первый месяц',
    price: '30 000 ₽',
    items: [
      'Аудит сообщества + рекомендации по улучшению',
      'Разработка стратегии продвижения',
      'Сбор и анализ целевой аудитории',
      'Настройка рекламного кабинета',
      'Создание креативов и текстов',
      'Запуск и ведение рекламы – 1 месяц',
      'Оптимизация, масштабирование, ежедневная работа с результатами',
    ],
    gifts: ['Оформление и дизайн сообщества', 'Установка чат-бота', 'Рекомендации по контенту и продажам'],
    hook: '#zeropopuptarget',
  },
  {
    tone: 'dark',
    icon: 'key',
    title: 'Продвижение под ключ – «Таргет + СММ»',
    sub: 'Вы делаете продажи. Всё остальное – берём на себя.',
    price: '60 000 ₽/мес',
    items: [
      'Всё из пакета по таргету +',
      '20–30 постов в месяц',
      'Контент-план, продуманный под ЦА, боли, страхи, возражения',
      'Посты, которые не просто украшают ленту, а ведут к заявкам и продажам',
      'Подходит тем, кто хочет полностью делегировать рекламу и контент – и не тратить время на публикации и тексты.',
    ],
    gifts: [],
    hook: '#zeropopuptargetsmm',
  },
];
---

<section class="tf-section tfplans" id="service">
  <div class="tf-panel tf-panel--dark tfplans__panel">
    <header class="tfplans__head" data-reveal>
      <div class="tf-tag tfplans__tag">– от консультации до полного ведения под ключ.</div>
      <h2 class="tf-h2 tfplans__title">Выбирайте формат сотрудничества, который подходит именно вам</h2>
    </header>

    <div class="tfplans__grid">
      {
        plans.map((p, i) => (
          <article class={`tfplans__col tfplans__col--${p.tone}`} data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
            <div class="tfplans__card tfplans__card--top">
              <div class="tfplans__badge" aria-hidden="true">
                <span class="tfplans__tile"></span>
                <img class={`tfplans__obj tfplans__obj--${p.icon}`} src={`/img/tf/fig/plan-${p.icon}.webp`} alt="" loading="lazy" decoding="async" />
              </div>
              <div class="tfplans__top-text">
                <h3 class="tfplans__name">{p.title}</h3>
                <p class="tfplans__sub">{p.sub}</p>
              </div>
            </div>

            <div class="tfplans__card tfplans__card--body">
              <div class="tfplans__label">Что получите:</div>
              <ul class="tfplans__list">
                {p.items.map((item) => <li>{item}</li>)}
              </ul>

              {p.gifts.length > 0 && (
                <div class="tfplans__gifts">
                  <div class="tfplans__gifts-title">Дарим бесплатно:</div>
                  <ul class="tfplans__list tfplans__list--gift">
                    {p.gifts.map((g) => <li>{g}</li>)}
                  </ul>
                </div>
              )}

              <div class="tfplans__pay">
                <div class="tfplans__from">стоимость от</div>
                <div class="tfplans__price">{p.price}</div>

                <a class="tfplans__btn" href={p.hook}>
                  <span>Оплатить полностью</span>
                  <span class="tfplans__btn-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8" /></svg>
                  </span>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  /* Фон секции — общий для страницы: чёрное поле с красным свечением */
  .tfplans__panel {
    --f: calc(100cqw / 1440);
    padding: calc(50 * var(--f)) 0 calc(63 * var(--f));
    border-radius: calc(90 * var(--f));
    font-family: 'Inter Tight', Inter, Arial, sans-serif;
  }

  /* Метка над заголовком — белая пилюля */
  .tfplans .tfplans__tag {
    background: #fff;
    border-color: #ededee;
    color: #202020;
    font-weight: 400;
  }

  .tfplans .tfplans__title { color: #fff; }

  .tfplans__head { display: flex; flex-direction: column; align-items: center; text-align: center; }

  .tfplans .tfplans__tag {
    padding: calc(8.4 * var(--f)) calc(12 * var(--f));
    border-width: 1.2px;
    font-size: calc(13.2 * var(--f));
    line-height: calc(15.6 * var(--f));
  }

  .tfplans .tfplans__title {
    width: calc(716 * var(--f));
    margin-top: calc(18 * var(--f));
    font-size: calc(39.6 * var(--f));
    line-height: 1;
    letter-spacing: calc(-1.2 * var(--f));
  }

  /* Колонки одной высоты — кнопки встают на одну линию */
  .tfplans__grid {
    display: grid;
    grid-template-columns: repeat(3, calc(418 * var(--f)));
    justify-content: center;
    align-items: stretch;
    gap: calc(22 * var(--f));
    margin-top: calc(40 * var(--f));
  }

  .tfplans__col {
    display: flex;
    flex-direction: column;
    gap: calc(10 * var(--f));
  }

  .tfplans__card {
    position: relative;
    border: 1.12px solid transparent;
    border-radius: calc(22.56 * var(--f));
  }

  /* ---------- плитка с предметом ---------- */

  .tfplans__card--top {
    display: flex;
    align-items: center;
    gap: calc(16 * var(--f));
    min-height: calc(157 * var(--f));
    padding: calc(18 * var(--f)) calc(23 * var(--f)) calc(18 * var(--f)) calc(20 * var(--f));
  }

  .tfplans__badge {
    position: relative;
    flex: 0 0 calc(115 * var(--f));
    width: calc(115 * var(--f));
    height: calc(110 * var(--f));
  }

  .tfplans__tile {
    position: absolute;
    left: calc(10 * var(--f));
    top: 0;
    width: calc(95.26 * var(--f));
    height: calc(109.83 * var(--f));
    border: 1.12px solid #303030;
    border-radius: calc(5.6 * var(--f));
    background: var(--tf-grad);
  }

  .tfplans__col--red .tfplans__tile { background: linear-gradient(97deg, #3b3b3b 0%, #000 96%); }

  /* Предмет выходит за плитку, но остаётся в своей колонке */
  .tfplans__obj { position: absolute; max-width: none; pointer-events: none; }
  .tfplans__obj--mic { left: calc(-12 * var(--f)); top: calc(-24 * var(--f)); width: calc(154 * var(--f)); height: calc(152.4 * var(--f)); object-fit: cover; object-position: left; clip-path: inset(0 23% 0 0); }
  .tfplans__obj--megaphone { left: calc(4 * var(--f)); top: calc(-6 * var(--f)); width: calc(123.3 * var(--f)); height: calc(107.3 * var(--f)); object-fit: contain; transform: rotate(-156.59deg) scaleY(-1); }
  .tfplans__obj--key { left: calc(-20 * var(--f)); top: calc(-37 * var(--f)); width: calc(170 * var(--f)); height: calc(170 * var(--f)); transform: rotate(21.94deg); }

  .tfplans__top-text {
    display: flex;
    flex-direction: column;
    gap: calc(9.6 * var(--f));
    min-width: 0;
  }

  .tfplans__name {
    margin: 0;
    color: #202020;
    font-size: calc(21 * var(--f));
    font-weight: 600;
    line-height: calc(26.4 * var(--f));
    letter-spacing: calc(-0.6 * var(--f));
  }

  .tfplans__sub {
    margin: 0;
    color: #a4a4a4;
    font-size: calc(13.2 * var(--f));
    font-weight: 500;
    line-height: calc(15.6 * var(--f));
  }

  /* ---------- карточка состава ---------- */

  .tfplans__card--body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: calc(24 * var(--f)) calc(25 * var(--f)) calc(27 * var(--f)) calc(24 * var(--f));
  }

  .tfplans__label {
    color: #202020;
    font-size: calc(21 * var(--f));
    font-weight: 600;
    line-height: calc(26.4 * var(--f));
    letter-spacing: calc(-0.6 * var(--f));
  }

  .tfplans__list {
    margin: calc(9.6 * var(--f)) 0 0;
    padding: 0 0 0 calc(19.8 * var(--f));
    color: #a4a4a4;
    font-size: calc(13.2 * var(--f));
    font-weight: 500;
    line-height: calc(15.6 * var(--f));
    list-style: disc;
  }

  .tfplans__list li + li { margin-top: calc(15.6 * var(--f)); }
  .tfplans__list li::marker { font-size: 0.8em; }

  .tfplans__gifts { margin-top: calc(15.6 * var(--f)); }

  .tfplans__gifts-title {
    color: #fff;
    font-size: calc(13.2 * var(--f));
    font-weight: 700;
    line-height: calc(15.6 * var(--f));
  }

  .tfplans__list--gift { margin-top: calc(4 * var(--f)); }
  .tfplans__list--gift li + li { margin-top: 0; }

  /* Ценовой блок прижат к низу карточки */
  .tfplans__pay {
    margin-top: auto;
    padding-top: calc(50 * var(--f));
  }

  .tfplans__from {
    padding-top: calc(20 * var(--f));
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    color: #a4a4a4;
    font-size: calc(13.2 * var(--f));
    font-weight: 500;
    line-height: calc(15.6 * var(--f));
  }

  .tfplans__price {
    margin-top: calc(5 * var(--f));
    color: #202020;
    font-size: calc(21 * var(--f));
    font-weight: 600;
    line-height: calc(26.4 * var(--f));
    letter-spacing: calc(-0.6 * var(--f));
    white-space: nowrap;
  }

  .tfplans__btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: calc(65.324 * var(--f));
    margin-top: calc(32 * var(--f));
    padding: calc(6 * var(--f)) calc(6 * var(--f)) calc(6 * var(--f)) calc(30 * var(--f));
    border-radius: 120px;
    background: #810005;
    color: #fff;
    font-size: calc(17.775 * var(--f));
    font-weight: 600;
    line-height: calc(19.39 * var(--f));
    text-decoration: none;
    transition: transform 0.25s ease, filter 0.25s ease;
  }

  .tfplans__btn-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 calc(53.324 * var(--f));
    width: calc(53.324 * var(--f));
    height: calc(53.324 * var(--f));
    border-radius: 50%;
    background: #fff;
  }

  .tfplans__btn-arrow svg {
    width: calc(20 * var(--f));
    height: calc(20 * var(--f));
    fill: none;
    stroke: #810005;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) and (pointer: fine) {
    .tfplans__btn:hover { transform: translateY(-2px); filter: brightness(1.1); }
  }

  .tfplans__btn:active { transform: translateY(1px); }

  /* ---------- белая колонка ---------- */

  .tfplans__col--light .tfplans__card { background: #fff; }

  /* ---------- красная колонка ---------- */

  .tfplans__col--red .tfplans__card--top { background: linear-gradient(95.58deg, #ee0000 0%, #810005 96.03%); }
  .tfplans__col--red .tfplans__card--body { background: linear-gradient(95.58deg, #ee0000 0%, #810005 96.03%); }

  .tfplans__col--red .tfplans__name,
  .tfplans__col--red .tfplans__label,
  .tfplans__col--red .tfplans__price { color: #fff; }

  .tfplans__col--red .tfplans__sub,
  .tfplans__col--red .tfplans__list,
  .tfplans__col--red .tfplans__from { color: rgba(255, 255, 255, 0.6); }

  .tfplans__col--red .tfplans__from { border-top-color: rgba(255, 255, 255, 0.25); }

  .tfplans__col--red .tfplans__btn { background: #fff; color: #3b3b3b; }
  .tfplans__col--red .tfplans__btn-arrow { background: #810005; }
  .tfplans__col--red .tfplans__btn-arrow svg { stroke: #fff; }

  /* ---------- чёрная колонка ---------- */

  .tfplans__col--dark .tfplans__card { border-color: #303030; }
  .tfplans__col--dark .tfplans__card--top { background: linear-gradient(96.63deg, #3b3b3b 0%, #000 96.03%); }
  .tfplans__col--dark .tfplans__card--body { background: linear-gradient(96.63deg, #3b3b3b 0%, #000 96.03%); }

  .tfplans__col--dark .tfplans__name,
  .tfplans__col--dark .tfplans__label,
  .tfplans__col--dark .tfplans__price { color: #fff; }

  .tfplans__col--dark .tfplans__sub,
  .tfplans__col--dark .tfplans__list,
  .tfplans__col--dark .tfplans__from { color: rgba(255, 255, 255, 0.6); }

  .tfplans__col--dark .tfplans__from { border-top-color: rgba(255, 255, 255, 0.18); }

  /* Первый пункт чёрной карточки — подзаголовок «Всё из пакета по таргету +» */
  .tfplans__col--dark .tfplans__list li:first-child {
    margin-left: calc(-19.8 * var(--f));
    color: #fff;
    font-weight: 700;
    list-style: none;
  }

  .tfplans__col--dark .tfplans__btn { background: #fff; color: #3b3b3b; }
  .tfplans__col--dark .tfplans__btn-arrow { background: #810005; }
  .tfplans__col--dark .tfplans__btn-arrow svg { stroke: #fff; }

  /* ---------- планшет и телефон ---------- */

  @media (max-width: 979px) {
    .tfplans__panel { --f: min(calc((100cqw - 36px) / 418), 1.15px); padding: 44px 0 30px; border-radius: 36px; }
    .tfplans .tfplans__tag { padding: 7px 11px; font-size: 12px; line-height: 14px; }
    .tfplans .tfplans__title { width: auto; max-width: 560px; margin-top: 14px; padding: 0 18px; font-size: clamp(26px, 6vw, 36px); letter-spacing: -0.03em; }
    .tfplans__grid { grid-template-columns: calc(418 * var(--f)); gap: 24px; margin-top: 30px; }
    .tfplans__pay { padding-top: calc(32 * var(--f)); }
  }
</style>
