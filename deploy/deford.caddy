# >>> deford-site: сайт Дефорда – блок добавляет deploy/install.sh репозитория deford-studio
deford.ru {
	# порт 80 сервера держит nginx ispmanager (301 на https) – сертификат только через 443
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy deford-site-web:8080
}
www.deford.ru {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	redir https://deford.ru{uri} permanent
}
# <<< deford-site
