---
/** Шапка Target Factory по макету Figma: фиксированная стеклянная плашка
    1300 × 81, слева логотип, в центре меню, справа телефон текстом
    («Звоните, мы на месте») и кнопка-контур «Бесплатная консультация». На телефоне — логотип, телефон
    и бургер с выпадающим меню. Ссылки и контакты — с targetfactory.ru. */

const menu = [
  { href: '#service', label: 'Услуги' },
  { href: '#case', label: 'Кейсы' },
  { href: '#Calculation', label: 'Расчёт продвижения' },
  { href: '#command', label: 'Команда' },
  { href: '#reviews', label: 'Отзывы' },
  { href: '#contact', label: 'Контакты' },
];

const socials = [
  { href: 'https://t.me/korotaev_denis', label: 'Telegram' },
  { href: 'https://max.ru/u/f9LHodD0cOLcKLkeG8Hr_oFXFF0snzqnNOGgHN2cX0meUwSiovnBh1wb8xM', label: 'MAX' },
  { href: 'https://vk.me/target_factory_vk', label: 'ВКонтакте' },
  { href: 'mailto:korotaev.TF@yandex.ru', label: 'Почта' },
];

const phoneIcon =
  'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z';
---

<header class="tfh" data-tfh>
  <div class="tfh__inner">
    <a class="tfh__logo" href="#top" aria-label="Target Factory — наверх">
      <img src="/img/tf/fig/logo.webp" alt="Target Factory" width="360" height="166" />
    </a>

    <nav class="tfh__nav" aria-label="Меню">
      {menu.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="tfh__actions">
      <a class="tfh__phone" href="tel:+79132090181" aria-label="Позвонить: +7 (913) 209-01-81">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={phoneIcon}></path></svg>
        <span class="tfh__phone-tip">
          <span class="tfh__phone-num">+7 (913) 209-01-81</span>
          <span class="tfh__phone-note"><i></i>Звоните, мы на месте</span>
        </span>
      </a>
      <a class="tfh__cta" href="#zeropopup">Бесплатная консультация</a>
    </div>

    <button class="tfh__burger" type="button" aria-label="Открыть меню" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="tfh__mobile" aria-hidden="true">
    <nav class="tfh__mobile-nav">
      {menu.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="tfh__mobile-phone" href="tel:+79132090181">+7 (913) 209-01-81</a>
    <a class="tf-btn tf-btn--red tfh__mobile-cta" href="#zeropopup">
      <span>Бесплатная консультация</span>
      <span class="tf-btn__arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8"></path></svg></span>
    </a>
    <div class="tfh__mobile-socials">
      {socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
    </div>
  </div>
</header>

<style is:global>
  .tfh {
    /* единица для общих кнопок внутри шапки — без масштаба */
    --u: 1px;
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    right: 0;
    font-family: var(--tf-font);
    pointer-events: none;
  }

  /* по макету: стеклянная плашка 1300 × 81 по центру, скругление 10 */
  .tfh__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: min(calc(100vw * 1300 / 1440), 1300px);
    height: 81px;
    margin: 16px auto 0;
    padding: 0 20px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    background: rgba(16, 16, 16, 0.2);
    -webkit-backdrop-filter: blur(4.9px);
    backdrop-filter: blur(4.9px);
    pointer-events: auto;
    transition: background-color 0.3s ease;
  }

  /* после прокрутки плашка плотнее – меню читается поверх светлых блоков */
  .tfh.is-scrolled .tfh__inner { background: rgba(16, 16, 16, 0.78); }

  .tfh__logo { display: flex; align-items: center; }
  .tfh__logo img { width: 88px; height: 40px; object-fit: contain; }

  .tfh__nav { display: flex; gap: 20px; }

  .tfh__nav a {
    color: rgba(255, 255, 255, 0.5);
    font-size: 14px;
    line-height: 1.5;
    font-weight: 400;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .tfh__nav a:hover { color: #fff; }

  .tfh__actions { display: flex; align-items: center; gap: 19px; }

  /* телефон текстом: номер и «Звоните, мы на месте» с зелёной точкой */
  .tfh__phone {
    display: flex;
    flex-direction: column;
    color: #fff;
    text-decoration: none;
  }

  .tfh__phone svg { display: none; }
  .tfh__phone-tip { display: contents; }
  .tfh__phone-num { font-size: 14px; line-height: 1.5; font-weight: 400; white-space: nowrap; }

  .tfh__phone-note {
    display: flex;
    align-items: center;
    gap: 5px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 10px;
    line-height: 1.5;
    font-weight: 300;
    white-space: nowrap;
  }

  .tfh__phone-note i { width: 4px; height: 4px; border-radius: 50%; background: #00d427; }

  .tfh__cta {
    display: flex;
    align-items: center;
    height: 45px;
    padding: 0 21px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 100px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
    line-height: 1.5;
    font-weight: 400;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
  }

  .tfh__cta:hover { border-color: #fff; background: #fff; color: var(--tf-page); }

  .tfh__burger {
    position: relative;
    display: none;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--tf-ink);
    cursor: pointer;
  }

  .tfh__burger span {
    position: absolute;
    left: 13px;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: #fff;
    transition: top 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
  }

  .tfh__burger span:nth-child(1) { top: 16px; }
  .tfh__burger span:nth-child(2) { top: 23px; }
  .tfh__burger span:nth-child(3) { top: 30px; }

  .tfh.is-open .tfh__burger { background: var(--tf-grad); }
  .tfh.is-open .tfh__burger span:nth-child(1) { top: 23px; transform: rotate(45deg); }
  .tfh.is-open .tfh__burger span:nth-child(2) { opacity: 0; }
  .tfh.is-open .tfh__burger span:nth-child(3) { top: 23px; transform: rotate(-45deg); }

  .tfh__mobile { display: none; }

  @media (max-width: 1180px) {
    .tfh__nav { gap: 14px; }
    .tfh__nav a { font-size: 13px; }
    .tfh__actions { gap: 12px; }
  }

  /* Планшет и телефон: бургер вместо меню */
  @media (max-width: 979px) {
    .tfh__inner { width: auto; height: 64px; margin: 10px 12px 0; padding: 0 8px 0 14px; }
    .tfh__nav, .tfh__cta { display: none; }
    .tfh__phone {
      display: grid;
      place-items: center;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: var(--tf-red);
    }
    .tfh__phone svg { display: block; width: 18px; height: 18px; fill: #fff; }
    .tfh__phone-tip { display: none; }
    .tfh__actions { margin-left: auto; }
    .tfh__burger { display: block; }

    .tfh__mobile {
      display: block;
      margin: 0 12px;
      padding: 10px 18px 20px;
      border-radius: 28px;
      background: var(--tf-ink);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
      pointer-events: none;
    }

    .tfh.is-open .tfh__mobile { opacity: 1; visibility: visible; transform: none; pointer-events: auto; }

    .tfh__mobile-nav a {
      display: flex;
      align-items: center;
      min-height: 48px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      color: #fff;
      font-size: 18px;
      font-weight: 600;
      text-decoration: none;
    }

    .tfh__mobile-phone {
      display: block;
      margin: 16px 0 14px;
      color: #fff;
      font-size: 17px;
      font-weight: 600;
      text-decoration: none;
    }

    .tfh__mobile-cta { width: 100%; }

    .tfh__mobile-socials { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 14px; }
    .tfh__mobile-socials a { color: rgba(255, 255, 255, 0.5); font-size: 13px; text-decoration: none; }
  }

  /* мобильное меню на планшете — по ширине меню, справа */
  @media (min-width: 641px) and (max-width: 979px) {
    .tfh__mobile { width: 360px; margin-left: auto; margin-right: 16px; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-tfh]');
    if (!root) return;
    var burger = root.querySelector('.tfh__burger');
    var panel = root.querySelector('.tfh__mobile');

    function setOpen(open) {
      root.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
      panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    }

    burger.addEventListener('click', function () {
      setOpen(!root.classList.contains('is-open'));
    });

    /* пункт меню выбран — меню закрывается, переход делает скролл страницы */
    panel.addEventListener('click', function (event) {
      if (event.target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') setOpen(false);
    });

    var onScroll = function () {
      root.classList.toggle('is-scrolled', window.scrollY > 40);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
