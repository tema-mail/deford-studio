<style is:global>
/* ===== слой 1 из Тильды ===== */
.fm-errors {
  --fm-errors-bg:#dbdbdb;
  --fm-errors-dark:#202020;
  --fm-errors-scale:1;

  position:relative;
  width:100%;
  margin:0;
  padding:0;
  background:#fff;

  font-family:
    "Inter Tight",
    Inter,
    Arial,
    sans-serif;

  color:var(--fm-errors-dark);
}

.fm-errors,
.fm-errors * {
  box-sizing:border-box;
}



/* SCROLL */

.fm-errors__scroll-shell {
  position:relative;
  width:100%;
  height:1375px;
}


.fm-errors__sticky {
  position:sticky;
  top:0;
  width:100%;
  height:675px;
  overflow:visible;
}



/* VIEWPORT */

.fm-errors__viewport {
  position:relative;
  width:100%;
  height:675px;
  margin:0;
  overflow:hidden;
  background:var(--fm-errors-bg);

  border-radius:
    clamp(42px,6.25vw,120px);
}



/* STAGE */

.fm-errors__stage {
  position:absolute;

  left:50%;
  top:0;

  width:1200px;
  height:675px;

  transform-origin:top center;

  transform:
    translateX(-50%)
    scale(var(--fm-errors-scale));
}



/* HEADER */

.fm-errors__header {
  position:absolute;

  z-index:50;

  top:88px;
  left:50%;

  width:620px;

  transform:
    translateX(-50%);

  text-align:center;

  pointer-events:none;
}


.fm-errors__tag {
  width:max-content;

  margin:
    0 auto
    27px;

  padding:
    7px
    10px;

  background:#fff;

  border:
    1px solid #ededee;

  border-radius:100px;

  font-size:11px;
  line-height:13px;
  font-weight:400;
}


.fm-errors__title {
  margin:0;

  color:#202020;

  font-size:33px;
  line-height:33px;

  font-weight:600;
  letter-spacing:-1px;
}


.fm-errors__title-line {
  display:block;
  overflow:hidden;
}


.fm-errors__title-line > span {
  display:block;
  transform:translateY(120%);
  opacity:0;
}


.fm-errors.is-ready
.fm-errors__title-line:nth-child(1) > span {
  animation:
    fm-errors-title-in
    1.2s
    cubic-bezier(.16,.82,.21,1)
    .10s
    forwards;
}


.fm-errors.is-ready
.fm-errors__title-line:nth-child(2) > span {
  animation:
    fm-errors-title-in
    1.2s
    cubic-bezier(.16,.82,.21,1)
    .25s
    forwards;
}



/* WHEEL SCENE */

.fm-errors__wheel-scene {
  position:absolute;

  left:50%;
  top:300px;

  width:1200px;
  height:900px;

  transform:
    translateX(-50%);

  pointer-events:none;
}


.fm-errors__wheel {
  position:absolute;

  left:600px;
  top:665px;

  width:0;
  height:0;

  transform:
    rotate(30deg);

  transform-origin:center;

  will-change:transform;
}



/* SLOTS */

.fm-errors__slot {
  --slot-angle:
    calc(
      var(--slot)
      *
      36deg
    );

  position:absolute;

  left:0;
  top:0;

  width:324px;
  height:421px;

  transform:
    rotate(var(--slot-angle))
    translateY(-505px);

  transform-origin:0 0;
}



/* CARD */

.fm-errors__card {
  position:absolute;

  left:-162px;
  top:-210.5px;

  width:324px;
  height:421px;

  overflow:hidden;

  border-radius:30px;

  background:#222;

  box-shadow:
    0
    15px
    40px
    rgba(0,0,0,.05);

  pointer-events:auto;

  transition:
    transform
    .32s
    cubic-bezier(.2,.75,.25,1),
    filter
    .32s
    ease;
}


.fm-errors__card:hover {
  transform:
    scale(1.025);

  filter:
    brightness(1.03);
}



/* IMAGE */

.fm-errors__image {
  position:absolute;

  inset:0;

  width:100%;
  height:100%;

  display:block;

  object-fit:cover;
}



/* =========================================================
   DESKTOP TEXT — NOW AT TOP
   ========================================================= */

.fm-errors__glass {
  position:absolute;

  z-index:4;

  left:25px;
  right:25px;

  /*
   * БЫЛО:
   * top:50%;
   * transform:translateY(-50%);
   *
   * ТЕПЕРЬ ТЕКСТ СВЕРХУ.
   */
  top:25px;

  padding:15px;

  transform:none;

  border-radius:10px;

  background:
    rgba(32,32,32,.50);

  backdrop-filter:
    blur(7.5px);

  -webkit-backdrop-filter:
    blur(7.5px);
}


.fm-errors__card-title {
  margin:0;

  color:#fff;

  font-size:15px;
  line-height:17px;

  font-weight:500;

  letter-spacing:-.5px;
}


.fm-errors__card-text {
  margin:
    4px
    0
    0;

  color:
    rgba(255,255,255,.62);

  font-size:11px;
  line-height:13px;

  font-weight:500;
}



/* CARD ENTRY */

.fm-errors__slot
.fm-errors__card {
  opacity:0;
}


.fm-errors.is-ready
.fm-errors__slot:nth-child(1)
.fm-errors__card {
  animation:
    fm-errors-card-in
    .65s
    .20s
    both;
}


.fm-errors.is-ready
.fm-errors__slot:nth-child(2)
.fm-errors__card {
  animation:
    fm-errors-card-in
    .65s
    .25s
    both;
}


.fm-errors.is-ready
.fm-errors__slot:nth-child(3)
.fm-errors__card {
  animation:
    fm-errors-card-in
    .65s
    .30s
    both;
}


.fm-errors.is-ready
.fm-errors__slot:nth-child(4)
.fm-errors__card {
  animation:
    fm-errors-card-in
    .65s
    .35s
    both;
}


.fm-errors.is-ready
.fm-errors__slot:nth-child(5)
.fm-errors__card {
  animation:
    fm-errors-card-in
    .65s
    .40s
    both;
}


.fm-errors.is-ready
.fm-errors__slot:nth-child(n+6)
.fm-errors__card {
  animation:
    fm-errors-card-in
    .65s
    .45s
    both;
}



/* MOBILE OFF DESKTOP */

.fm-errors__mobile {
  display:none;
}


.fm-errors__mobile-dots {
  display:none;
}



/* ANIMATIONS */

@keyframes fm-errors-title-in {

  from {
    transform:
      translateY(120%);

    opacity:0;
  }

  to {
    transform:
      translateY(0);

    opacity:1;
  }

}


@keyframes fm-errors-card-in {

  from {
    opacity:0;
    scale:.92;
  }

  to {
    opacity:1;
    scale:1;
  }

}



