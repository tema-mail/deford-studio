<style is:global>
/* ===== слой 1 из Тильды ===== */
/* =========================================================
   BASE
   ========================================================= */

.fmcases {

  --fc-dark: #202020;
  --fc-green: #cefe46;
  --fc-link: #607700;

  position: relative;

  width: 100%;

  padding: 10px 0;

  margin: 0;

  overflow: hidden;

  background: #fff;

  color: var(--fc-dark);

  font-family:
    "Inter Tight",
    Inter,
    Arial,
    sans-serif;

}


.fmcases,
.fmcases * {

  box-sizing: border-box;

}



/* =========================================================
   DESKTOP VIEWPORT
   ========================================================= */

.fmcases__viewport {

  position: relative;

  width: 100%;

  height: 720px;

  overflow: hidden;

  background:
    var(--fc-dark);

  border-radius:
    clamp(
      42px,
      6.25vw,
      120px
    );

}


.fmcases__stage {

  position: absolute;

  left: 50%;
  top: 0;

  width: 1200px;
  height: 720px;

  transform-origin:
    top center;

  transform:
    translateX(-50%)
    scale(var(--fc-scale,1));

}



/* =========================================================
   HEADER
   ========================================================= */

.fmcases__header {

  position: absolute;

  z-index: 20;

  left: 50%;

  top: 64px;

  width: 640px;

  transform:
    translateX(-50%);

  text-align: center;

}


.fmcases__tag {

  width: max-content;

  margin:
    0 auto
    31px;

  padding:
    7px
    10px;

  background: #fff;

  color:
    var(--fc-dark);

  border:
    1px solid #ededee;

  border-radius:
    100px;

  font-size: 11px;

  line-height: 13px;

  font-weight: 400;

}


.fmcases__title {

  width: 556px;

  margin:
    0 auto;

  color: #fff;

  font-size: 33px;

  line-height: 33px;

  letter-spacing:
    -1px;

  font-weight: 600;

}



/* =========================================================
   GRID
   ========================================================= */

.fmcases__grid {

  position: absolute;

  left: 60px;
  right: 60px;

  /* было ниже */
  top: 240px;

  display: grid;

  grid-template-columns:
    repeat(
      3,
      minmax(0,1fr)
    );

  gap: 20px;

  align-items: start;

}



/* =========================================================
   CARD
   ========================================================= */

.fmcases__card {

  position: relative;

  width: 100%;

  min-height: 0;
  height: auto;

  padding: 22px;

  display: flex;

  flex-direction: column;

  gap: 15px;

  overflow: hidden;

  border-radius:
    27px;

  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #f6f6f6 100%
    );

  color:
    var(--fc-dark);

  will-change:
    transform,
    opacity;

}


.fmcases__card--center {

  transform:
    translateY(26px);

}



/* =========================================================
   IMAGE
   ========================================================= */

.fmcases__image {

  position: relative;

  width: 100%;

  height: auto;

  flex: none;

  display: block;

  overflow: hidden;

  border-radius:
    10px;

  background: #fff;

}


.fmcases__image img {

  position: relative;

  display: block;

  width: 100%;
  height: auto;

  object-fit: contain;

  object-position: center;

}



/* =========================================================
   CARD CONTENT
   ========================================================= */

.fmcases__content {

  min-height: 0;

  display: flex;

  flex-direction: column;

  gap: 6px;

  justify-content: flex-start;

}


.fmcases__card-title {

  margin: 0;

  width: 100%;

  max-width: 100%;

  font-size: 19px;

  line-height: 1.08;

  letter-spacing:
    -.5px;

  font-weight: 600;

}


.fmcases__card-meta {

  margin-top: 2px;

  color:
    rgba(0,0,0,.46);

  font-size: 11px;

  line-height: 13px;

  font-weight: 500;

}



.fmcases__more {

  width: max-content;

  margin-top: 8px;

  padding-top: 0;

  display: inline-block;

  color:
    var(--fc-link);

  text-decoration: none;

  font-size: 13px;

  line-height: 15px;

  font-weight: 650;

  letter-spacing:
    -.1px;

  transition:
    color .2s ease,
    opacity .2s ease;

}


.fmcases__more:hover {

  color:
    #4f6200;

  opacity:
    .85;

}


/* =========================================================
   CTA WRAPPER
   ========================================================= */

.fmcases__cta-wrap {

  position: absolute;

  z-index: 30;

  left: 0;
  right: 0;

  bottom: 34px;

  display: flex;

  justify-content: center;

  pointer-events: none;

}



/* =========================================================
   CTA
   ========================================================= */

.fmcases__cta {

  position: relative;

  min-height: 54px;

  display: flex;

  align-items: center;

  gap: 13px;

  padding:
    5px
    5px
    5px
    25px;

  border-radius:
    100px;

  background:
    var(--fc-green);

  color:
    var(--fc-dark);

  text-decoration: none;

  font-size: 14.8px;

  line-height: 16px;

  font-weight: 600;

  white-space: nowrap;

  pointer-events: auto;

  transition:
    transform
    .3s
    cubic-bezier(.2,.75,.25,1);

}


.fmcases__cta:hover {

  transform:
    translateY(-2px);

}


.fmcases__cta-icon {

  width: 44px;
  height: 44px;

  flex:
    0 0 44px;

}


.fmcases__cta-icon svg {

  display: block;

  width: 100%;
  height: 100%;

}



/* =========================================================
   MOTION INITIAL
   ========================================================= */

.fmcases
[data-cases-anim],

.fmcases
[data-cases-card] {

  opacity: 0;

}



/* =========================================================
   HEADER MOTION
   ========================================================= */

.fmcases.is-visible
[data-cases-anim="tag"] {

  animation:
    fcUp
    .55s
    cubic-bezier(.2,.75,.25,1)
    .02s
    both;

}


.fmcases.is-visible
[data-cases-anim="title"] {

  animation:
    fcUp
    .70s
    cubic-bezier(.2,.75,.25,1)
    .10s
    both;

}



/* =========================================================
   CARD MOTION
   ========================================================= */

.fmcases.is-visible
.fmcases__card--left {

  animation:
    fcCard
    .75s
    cubic-bezier(.16,.82,.21,1)
    .22s
    both;

}


.fmcases.is-visible
.fmcases__card--center {

  animation:
    fcCardCenter
    .75s
    cubic-bezier(.16,.82,.21,1)
    .32s
    both;

}


.fmcases.is-visible
.fmcases__card--right {

  animation:
    fcCard
    .75s
    cubic-bezier(.16,.82,.21,1)
    .42s
    both;

}



/* =========================================================
   CTA MOTION

   transform применяется к WRAPPER,
   поэтому центрирование больше не ломается
   ========================================================= */

.fmcases.is-visible
[data-cases-anim="cta"] {

  animation:
    fcUp
    .65s
    cubic-bezier(.2,.75,.25,1)
    .52s
    both;

}



/* =========================================================
   KEYFRAMES
   ========================================================= */

@keyframes fcUp {

  from {

    opacity: 0;

    transform:
      translateY(22px);

  }


  to {

    opacity: 1;

    transform:
      translateY(0);

  }

}



@keyframes fcCard {

  from {

    opacity: 0;

    transform:
      translateY(42px)
      scale(.975);

  }


  to {

    opacity: 1;

    transform:
      translateY(0)
      scale(1);

  }

}



@keyframes fcCardCenter {

  from {

    opacity: 0;

    transform:
      translateY(68px)
      scale(.975);

  }


  to {

    opacity: 1;

    transform:
      translateY(26px)
      scale(1);

  }

}



/* =========================================================
