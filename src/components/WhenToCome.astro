}

#deford-when-v1 .dfw-cta-button {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: min(300px, 20.8333vw);
    height: min(66px, 4.5833vw);

    margin-top: auto;

    padding:
        0
        min(8px, .5556vw)
        0
        min(24px, 1.6667vw);

    border-radius: 999px;

    background: #191919;

    color: #ffffff;
    text-decoration: none;

    transition:
        transform .2s ease,
        background-color .2s ease;
}

#deford-when-v1 .dfw-cta-button:hover {
    transform: translateY(-2px);
    background: #101010;
}

#deford-when-v1 .dfw-cta-button-text {
    font-size: min(18px, 1.25vw);
    font-weight: 400;

    line-height: 1;

    white-space: nowrap;

    color: rgba(255,255,255,.85);
}

#deford-when-v1 .dfw-cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 auto;

    width: min(50px, 3.4722vw);
    height: min(50px, 3.4722vw);

    border-radius: 50%;

    background: #ffffff;
}

#deford-when-v1 .dfw-cta-icon svg {
    width: min(19px, 1.3194vw);
    height: min(19px, 1.3194vw);

    fill: none;

    stroke: #111111;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}


/* =========================================================
   BOTTOM SPACE TO NEXT BLOCK
   ========================================================= */

#deford-when-v1 .dfw-bottom-space {
    height: min(120px, 8.3333vw);
}


/* =========================================================
   MOBILE — 300–640
   ========================================================= */

@media screen and (max-width: 640px) {

    #deford-when-v1 .dfw-container {
        padding-left: clamp(16px, 5vw, 28px);
        padding-right: clamp(16px, 5vw, 28px);
    }


    /* HEADER */

    #deford-when-v1 .dfw-header {
        display: flex;
        flex-direction: column;
        align-items: flex-start;

        min-height: 0;

        gap: 16px;
    }

    #deford-when-v1 .dfw-title {
        width: 100%;

        font-size: clamp(30px, 9vw, 38px);

        line-height: .94;
        letter-spacing: -0.055em;
    }


    /* NAV */

    #deford-when-v1 .dfw-nav {
        gap: 8px;

        padding-bottom: 0;
    }

    #deford-when-v1 .dfw-arrow {
        width: clamp(38px, 11vw, 46px);
        height: clamp(38px, 11vw, 46px);
    }

    #deford-when-v1 .dfw-arrow svg {
        width: 11px;
        height: 11px;
    }


    /* SLIDER */

    #deford-when-v1 .dfw-slider {
        margin-top: 24px;

        overflow: hidden;
    }

    #deford-when-v1 .dfw-track {
        gap: 12px;

        overflow-x: auto;
        overflow-y: hidden;

        transform: none !important;

        transition: scroll-left .35s ease;

        scroll-snap-type: x mandatory;
        scroll-padding-left: 0;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior-x: contain;

        touch-action: pan-x pan-y;
        cursor: grab;
    }

    #deford-when-v1 .dfw-track::-webkit-scrollbar {
        display: none;
    }


    /* CARD */

    #deford-when-v1 .dfw-card {
        flex: 0 0 100%;

        height: clamp(350px, 88vw, 380px);
        min-height: 0;

        border-radius: clamp(22px, 6vw, 30px);

        scroll-snap-align: start;
        scroll-snap-stop: always;
    }


    /* IMAGE */

    #deford-when-v1 .dfw-image-wrap,
    #deford-when-v1 .dfw-card:nth-child(3) .dfw-image-wrap {
        display: block;

        width: calc(100% - 28px);
        height: clamp(138px, 39vw, 160px);

        aspect-ratio: auto;

        margin: 0 14px;

        padding: 0;

        overflow: hidden;
    }

    #deford-when-v1 .dfw-card:nth-child(3) .dfw-image-wrap {
        margin-top: 0;
    }

    #deford-when-v1 .dfw-image {
        display: block;

        width: 100%;
        height: 100%;

        object-fit: contain;

        visibility: visible;
        opacity: 1;
    }


    /* CONTENT */

    #deford-when-v1 .dfw-content,
    #deford-when-v1 .dfw-card:nth-child(3) .dfw-content {
        padding:
            12px
            20px
            18px;
    }

    #deford-when-v1 .dfw-card-title {
        font-size: clamp(19px, 5.9vw, 23px);

        line-height: .97;
    }

    #deford-when-v1 .dfw-card-text {
        margin-top: 10px;

        font-size: clamp(12px, 3.6vw, 13.5px);

        line-height: 1.18;
    }


    /* CTA CARD */

    #deford-when-v1 .dfw-card--cta {
        height: clamp(292px, 80vw, 330px);
        min-height: 0;

        padding:
            clamp(22px, 6vw, 28px)
            clamp(20px, 5.5vw, 26px)
            clamp(20px, 5.5vw, 24px);
    }

    #deford-when-v1 .dfw-cta-title {
        font-size: clamp(28px, 8.4vw, 36px);

        line-height: .94;
    }

    #deford-when-v1 .dfw-cta-text {
        max-width: 100%;

        margin-top: 12px;

        font-size: clamp(12.5px, 3.8vw, 14px);

        line-height: 1.22;
    }

    #deford-when-v1 .dfw-cta-button {
        width: min(100%, 270px);
        height: 48px;

        padding:
            0
            5px
            0
            18px;
    }

    #deford-when-v1 .dfw-cta-button-text {
        font-size: clamp(12px, 3.6vw, 14px);
    }

    #deford-when-v1 .dfw-cta-icon {
