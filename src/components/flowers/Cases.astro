    padding:
      8px
      0;

  }



  .fmcases__viewport {

    width: 100%;

    height: auto !important;

    min-height: 0;

    border-radius:
      36px;

  }



  .fmcases__stage {

    position: relative;

    left: auto;
    top: auto;

    width: 100%;
    height: auto;

    padding:
      48px
      clamp(
        16px,
        5vw,
        28px
      )
      40px;

    transform:
      none !important;

  }



  /* =========================
     HEADER
     ========================= */

  .fmcases__header {

    position: relative;

    left: auto;
    top: auto;

    width: 100%;

    transform: none;

  }


  .fmcases__tag {

    margin-bottom:
