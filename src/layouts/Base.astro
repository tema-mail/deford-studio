---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title,
  description = '',
  canonical = Astro.site?.href ?? 'https://deford.ru/',
  ogImage = '/img/Frame_7.png',
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, 'https://deford-studio.ru').href} />

    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap&subset=latin,cyrillic"
    />

    <meta name="yandex-verification" content="06fcf6a320e1024e" />
  </head>

  <body>
    <slot />

    <script>
      /* Плавный переход по якорям внутри страницы.
         Заменяет служебный блок Тильды rec4271444901. */
      const OFFSET = 3;

      const scrollToHash = (hash: string, smooth = true) => {
        if (!hash || hash === '#') return false;

        const target = document.querySelector(hash);
        if (!target) return false;

        const top = target.getBoundingClientRect().top + window.scrollY - OFFSET;
        window.scrollTo({ top, behavior: smooth ? 'smooth' : 'auto' });
        return true;
      };

      document.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement)?.closest?.('a[href^="#"]');
        if (!link) return;

        const hash = link.getAttribute('href') ?? '';
        /* Попап и пустые якоря обрабатываются своими скриптами */
        if (hash === '#' || hash.startsWith('#zeropopup')) return;

        if (scrollToHash(hash)) event.preventDefault();
      });

      /* Переход по ссылке с якорем извне */
      window.addEventListener('load', () => {
        if (location.hash) setTimeout(() => scrollToHash(location.hash, false), 300);
      });

      window.addEventListener('popstate', () => {
        if (location.hash) scrollToHash(location.hash);
      });
    </script>
    <script>
    // Формы отправляются браузером напрямую: перед отправкой дописываем источник, страницу и метки скрытыми полями.
    import { leadFields } from '../lib/attribution';
    document.addEventListener('submit', (e) => {
      const form = e.target as HTMLFormElement;
      form.querySelectorAll('[data-origin]').forEach((el) => el.remove());
      for (const [k, v] of Object.entries(leadFields())) {
        const input = Object.assign(document.createElement('input'), { type: 'hidden', name: k, value: v });
        input.dataset.origin = '1';
        form.append(input);
      }
    }, true);
  </script>
</body>
</html>
