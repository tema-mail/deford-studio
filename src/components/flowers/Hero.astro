<style is:global>
/* ===== слой 1 из Тильды ===== */
/* =========================
   BASE
   ========================= */

.fmhero {
  --fm-dark:#202020;
  --fm-green:#cefe46;
  --fm-bg:#dbdbdb;

  position:relative;
  width:100%;
  margin:0;
  overflow:visible;
  background:transparent;
  color:var(--fm-dark);

  font-family:
    "Inter Tight",
    Inter,
    Arial,
    sans-serif;
}

.fmhero,
.fmhero * {
  box-sizing:border-box;
}


/* =========================
   VIEWPORT
   ========================= */

.fmhero__viewport {
  position:relative;
  width:100%;
  height:675px;
  overflow:hidden;
  background:var(--fm-bg);

  border-radius:
    0
    0
    clamp(38px,6.25vw,120px)
    clamp(38px,6.25vw,120px);
}


/* =========================
   STAGE
   ========================= */

.fmhero__stage {
  position:absolute;

  left:50%;
  top:0;

  width:1200px;
  height:675px;

  transform-origin:top center;

  transform:
    translateX(-50%)
    scale(var(--fm-scale,1));
}


/* =========================
   BENEFITS
   ========================= */

.fmhero__benefits {
  position:absolute;

  z-index:5;

  left:60px;
  top:107px;

  width:535px;
  height:76px;

  overflow:hidden;

  border-radius:16px;

  isolation:isolate;
}

.fmhero__benefits-track {
  position:absolute;

  left:0;
  top:0;

  width:max-content;
  height:76px;

  display:flex;
  align-items:stretch;

  gap:10px;

  will-change:transform;
}

.fmhero__benefit {
  width:262.5px;
  height:76px;

  flex:
    0
    0
    262.5px;

  display:flex;

  align-items:center;

  gap:7px;

  padding:
    4px
    12px
    4px
    4px;

  overflow:hidden;

  border-radius:16px;

  background:
    rgba(
      255,
      255,
      255,
      .94
    );

  backdrop-filter:blur(6px);
  -webkit-backdrop-filter:blur(6px);
}

.fmhero__benefit-image {
  display:block;

  width:68px;
  height:68px;

  min-width:68px;
  max-width:68px;

  min-height:68px;
  max-height:68px;

  flex:
    0
    0
    68px;

  object-fit:cover;
  object-position:center;

  border-radius:13px;
}

.fmhero__benefit-copy {
  min-width:0;

  display:flex;

  flex-direction:column;

  gap:5px;
}

.fmhero__benefit-title {
  font-size:12px;
  line-height:13px;

  font-weight:700;

  white-space:nowrap;
}

.fmhero__benefit-text {
  font-size:11px;
  line-height:13px;

  color:
    rgba(
      0,
      0,
      0,
      .4
    );
}


/* =========================
   MAIN COPY
   ========================= */

.fmhero__copy {
  position:absolute;

  z-index:10;

  left:60px;
  top:288px;

  width:510px;
}

.fmhero__title {
  width:510px;

  margin:0;

  font-size:44.437px;
  line-height:1;

  letter-spacing:-1.35px;

  font-weight:600;
}

.fmhero__description {
  width:490px;

  margin-top:54px;

  font-size:14px;
  line-height:17.5px;

  font-weight:500;

  color:
    rgba(
      0,
      0,
      0,
      .4
    );
}


/* =========================
   BUTTONS
   ========================= */

.fmhero__actions {
  position:relative;

  z-index:30;

  display:flex;

  align-items:center;

  gap:11px;

  margin-top:35px;
}

.fmhero__button {
  position:relative;

  text-decoration:none;

  font-size:14.8px;
  line-height:16px;

  font-weight:600;

  white-space:nowrap;

  cursor:pointer;

  touch-action:manipulation;

  -webkit-tap-highlight-color:transparent;
}


/* PRIMARY */

.fmhero__button--primary {
  min-height:55px;

  display:inline-flex;

  align-items:center;

  gap:13px;

  padding:
    5px
    5px
    5px
    25px;

  border-radius:100px;

  background:var(--fm-dark);

  color:#fff;
}

.fmhero__button-label {
  display:block;
}

.fmhero__button-arrow {
  width:44px;
  height:44px;

  flex:
    0
    0
    44px;

  pointer-events:none;
}

.fmhero__button-arrow svg {
  display:block;

  width:100%;
  height:100%;

  pointer-events:none;
}

.fmhero__button-arrow svg * {
  pointer-events:none;
}


/* SECONDARY */

.fmhero__button--secondary {
  height:55px;

  display:inline-flex;

  align-items:center;
  justify-content:center;

  padding:
    0
    25px;

  border:
    1px
    solid
    var(--fm-dark);

  border-radius:100px;

  color:var(--fm-dark);
}


/* =========================
   DESKTOP HOVER
   ========================= */

@media
(hover:hover)
and
(pointer:fine) {

  .fmhero__button {
    transition:
      transform
      .3s
      cubic-bezier(
        .2,
        .75,
        .25,
        1
      );
  }

  .fmhero__button:hover {
    transform:
      translateY(-2px);
  }

}


/* =========================
   VISUAL
   ========================= */

.fmhero__visual {
  position:absolute;

  z-index:2;

  left:482px;
  top:-40px;

  width:752px;
  height:1002px;

  /*
   ВАЖНО:
   раньше здесь было pointer-events:none.
   Из-за этого изображение нельзя было
   нормально выбирать в редакторе.
  */

  pointer-events:auto;
}

.fmhero__person {
  position:absolute;

  inset:0;

  display:block;

  width:100%;
  height:100%;

  object-fit:cover;

  pointer-events:auto;
}


/* =========================
   LEADS
   ========================= */

.fmhero__lead {
  position:absolute;

  z-index:5;

  width:162px;

  display:flex;

  align-items:center;

  gap:7px;

  padding:
    17px
    10px;

  border-radius:10px;

  backdrop-filter:blur(6px);
  -webkit-backdrop-filter:blur(6px);

  box-shadow:
    0
    8px
    30px
    rgba(0,0,0,.04);
}

.fmhero__lead--vk {
  left:173px;
  top:169px;

  background:
    rgba(255,255,255,.96);

  transform:
    rotate(2.13deg);
}

.fmhero__lead--tg {
  left:151px;
  top:236px;

  color:#fff;

  background:var(--fm-dark);

  transform:
    rotate(-7deg);
}

.fmhero__lead--ya {
  left:181px;
  top:306px;

  background:
    rgba(255,255,255,.96);

  transform:
    rotate(3.39deg);
}

.fmhero__lead-icon {
  width:35px;
  height:35px;

  flex:
    0
    0
    35px;

  border-radius:4px;

  object-fit:cover;
}

.fmhero__lead-copy {
  min-width:0;

  display:flex;

  flex-direction:column;

  gap:2px;
}

.fmhero__lead-label {
  font-size:10px;
  line-height:13px;

  white-space:nowrap;
}

.fmhero__lead-title {
  font-size:14px;
  line-height:13px;

  font-weight:700;

  white-space:nowrap;
}

.fmhero__lead-count {
  position:absolute;

  right:-6px;
  top:-9px;

  width:18px;
  height:18px;

  display:flex;

  align-items:center;
  justify-content:center;

  border-radius:50%;

  background:var(--fm-green);

  color:var(--fm-dark);

  font-size:8px;

  font-weight:600;
}


/* =========================
   INITIAL
   ========================= */

.fmhero [data-anim],
.fmhero__lead {
  opacity:0;
}


/* =========================
   ENTRANCE
   ========================= */

.fmhero.is-visible
[data-anim="benefits"] {
  animation:
    fmFadeUp
    .75s
    cubic-bezier(.2,.75,.25,1)
    .05s
    both;
}

.fmhero.is-visible
[data-anim="title"] {
  animation:
    fmFadeUp
    .85s
    cubic-bezier(.2,.75,.25,1)
    .12s
    both;
}

.fmhero.is-visible
[data-anim="description"] {
  animation:
    fmFadeUp
    .8s
    cubic-bezier(.2,.75,.25,1)
    .22s
    both;
}

.fmhero.is-visible
[data-anim="actions"] {
  animation:
    fmFadeUp
    .8s
    cubic-bezier(.2,.75,.25,1)
    .30s
    both;
}

.fmhero.is-visible
[data-anim="visual"] {
  animation:
    fmVisual
    1.05s
    cubic-bezier(.16,.82,.21,1)
    .08s
    both;
}

.fmhero.is-visible
.fmhero__lead--vk {
  animation:
    fmVK
    .72s
    cubic-bezier(.18,.89,.32,1.22)
    .48s
    both;
}

.fmhero.is-visible
.fmhero__lead--tg {
  animation:
    fmTG
    .72s
    cubic-bezier(.18,.89,.32,1.22)
    .58s
    both;
}

.fmhero.is-visible
.fmhero__lead--ya {
  animation:
    fmYA
    .72s
    cubic-bezier(.18,.89,.32,1.22)
    .68s
    both;
}


/* =========================
   KEYFRAMES
   ========================= */

@keyframes fmFadeUp {

  from {
    opacity:0;

    transform:
      translateY(26px);
  }

  to {
    opacity:1;

    transform:
      translateY(0);
  }

}

@keyframes fmVisual {

  from {
    opacity:0;

    transform:
      translate(35px,22px)
      scale(.97);
  }

  to {
    opacity:1;

    transform:
      translate(0,0)
      scale(1);
  }

}

@keyframes fmVK {

  from {
    opacity:0;

    transform:
      translateY(28px)
      scale(.88)
      rotate(-3deg);
  }

  to {
    opacity:1;

    transform:
      translateY(0)
      scale(1)
      rotate(2.13deg);
  }

}

@keyframes fmTG {

  from {
    opacity:0;

    transform:
      translateY(28px)
      scale(.88)
      rotate(-13deg);
  }

  to {
    opacity:1;

    transform:
      translateY(0)
      scale(1)
      rotate(-7deg);
  }

}

@keyframes fmYA {

  from {
    opacity:0;

    transform:
      translateY(28px)
      scale(.88)
      rotate(-3deg);
  }

  to {
    opacity:1;

    transform:
      translateY(0)
      scale(1)
      rotate(3deg);
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media
(max-width:640px) {

  .fmhero {
    width:100%;
  }

  .fmhero__viewport {
    width:100%;

    height:auto !important;

    min-height:0;

    border-radius:
      0
      0
      36px
      36px;
  }


  /* STAGE */

  .fmhero__stage {
    position:relative;

    left:auto;
    top:auto;

    width:100%;
    height:auto;

    display:flex;

    flex-direction:column;

    padding:
      clamp(
        92px,
        24vw,
        108px
      )
      clamp(
        16px,
        5vw,
        28px
      )
      0;

    transform:none !important;

    overflow:hidden;
  }


  /* BENEFITS */

  .fmhero__benefits {
    position:relative;

    left:auto;
    top:auto;

    order:1;

    width:100%;

    height:
      clamp(
        69px,
        19vw,
        82px
      );
  }

  .fmhero__benefits-track {
    height:100%;

    gap:
      clamp(
        6px,
        2vw,
        10px
      );
  }

  .fmhero__benefit {
    width:
      calc(
        (
          100vw
          -
          clamp(
            32px,
            10vw,
            56px
          )
          -
          clamp(
            6px,
            2vw,
            10px
          )
        )
        /
        2
      );

    height:100%;

    flex:
      0
      0
      calc(
        (
          100vw
          -
          clamp(
            32px,
            10vw,
            56px
          )
          -
          clamp(
            6px,
            2vw,
            10px
          )
        )
        /
        2
      );

    gap:6px;

    padding:
      4px
      7px
      4px
      4px;
  }

  .fmhero__benefit-image {
    width:
      clamp(
        48px,
        15vw,
        68px
      );

    height:
      clamp(
        48px,
        15vw,
        68px
      );

    min-width:
      clamp(
        48px,
        15vw,
        68px
      );

    max-width:
      clamp(
        48px,
        15vw,
        68px
      );

    min-height:
      clamp(
        48px,
        15vw,
        68px
      );

    max-height:
      clamp(
        48px,
        15vw,
        68px
      );

    flex-basis:
      clamp(
        48px,
        15vw,
        68px
      );
  }

  .fmhero__benefit-title {
    font-size:
      clamp(
        9px,
        2.7vw,
        12px
      );

    line-height:1.05;

    white-space:normal;
  }

  .fmhero__benefit-text {
    font-size:
      clamp(
        8px,
        2.35vw,
        11px
      );

    line-height:1.12;
  }


  /* COPY */

  .fmhero__copy {
    position:relative;

    left:auto;
    top:auto;

    order:2;

    z-index:20;

    width:100%;

    margin-top:
      clamp(
        38px,
        10vw,
        56px
