        height: 15px;
    }


    #deford-when-v1 .dfw-bottom-space {
        height: clamp(80px, 20vw, 110px);
    }
}
</style>

<script is:inline>
(function () {

    const root = document.getElementById("deford-when-v1");

    if (!root || root.dataset.carouselReady) return;

    root.dataset.carouselReady = "true";


    const track = root.querySelector(".dfw-track");
    const cards = Array.from(root.querySelectorAll(".dfw-card"));

    const prev = root.querySelector(".dfw-arrow--prev");
    const next = root.querySelector(".dfw-arrow--next");


    if (!track || !cards.length || !prev || !next) return;


    let index = 0;
    let startX = 0;


    const mobile = () => {
        return window.matchMedia("(max-width: 640px)").matches;
    };


    const step = () => {

        const styles = getComputedStyle(track);

        const gap =
            parseFloat(styles.columnGap) ||
            parseFloat(styles.gap) ||
            0;

        return cards[0].getBoundingClientRect().width + gap;
    };


    const max = () => {
        return Math.max(
            0,
            cards.length - (mobile() ? 1 : 3)
        );
    };


    const updateButtons = () => {

        prev.style.opacity =
            index === 0
                ? ".45"
                : "1";

        next.style.opacity =
            index >= max()
                ? ".45"
                : "1";
    };


    const paint = () => {

        index = Math.max(
            0,
            Math.min(index, max())
        );


        const x = index * step();


        if (mobile()) {

            track.scrollTo({
                left: x,
                behavior: "smooth"
            });

        } else {

            track.style.transform =
                "translate3d(" + (-x) + "px,0,0)";

        }


        updateButtons();
    };


    const move = (delta) => {

        index += delta;

        paint();
    };


    const bind = (button, delta) => {

        button.addEventListener("click", function () {

            button.classList.add("is-pressed");

            setTimeout(function () {
                button.classList.remove("is-pressed");
            }, 220);

            move(delta);

        });

    };


    bind(prev, -1);
    bind(next, 1);


    track.addEventListener(
        "scroll",
        function () {

            if (!mobile()) return;


            const s = step();

            if (!s) return;


            index = Math.round(
                track.scrollLeft / s
            );


            updateButtons();

        },
        {
            passive: true
        }
    );


    track.addEventListener(
        "pointerdown",
        function (event) {

            if (event.pointerType === "touch") return;

            startX = event.clientX;

        }
    );


    track.addEventListener(
        "pointerup",
        function (event) {

            if (!mobile() || event.pointerType === "touch") return;


            const dx =
                event.clientX - startX;


            if (Math.abs(dx) > 36) {

                index += dx < 0 ? 1 : -1;

                paint();

            }

        }
    );


    window.addEventListener(
        "resize",
        paint,
        {
            passive: true
        }
    );


    paint();

})();
</script>
