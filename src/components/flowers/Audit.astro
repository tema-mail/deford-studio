<script is:inline>
(function () {


  const roots =
    document.querySelectorAll(
      '[data-fmvideo]'
    );


  roots.forEach(
    function (root) {


      if (
        root.dataset.fmVideoReady ===
        '1'
      ) {

        return;

      }


      root.dataset.fmVideoReady =
        '1';



      const viewport =
        root.querySelector(
          '.fmvideo__viewport'
        );


      const track =
        root.querySelector(
          '[data-video-track]'
        );



      /* =====================================================
         TILDA EDITOR
         ===================================================== */

      function isTildaEditor() {


        const body =
          document.body;


        const html =
          document.documentElement;


        return (

          body.classList.contains(
            't-body_edit'
          )

          ||

          body.classList.contains(
            'tilda-mode-edit'
          )

          ||

          html.classList.contains(
            'tilda-mode-edit'
          )

          ||

          !!document.querySelector(
            '.t-edit-toolbar'
          )

        );


      }



      /* =====================================================
         SCALE
         ===================================================== */

      function updateScale() {


        const width =
          root
            .getBoundingClientRect()
            .width;


        if (
          width <=
          640
        ) {


          root.style.removeProperty(
            '--fv-scale'
          );


          viewport.style.height =
            '';


          return;

        }



        const scale =
          width /
          1200;


        root.style.setProperty(
          '--fv-scale',
          scale
        );


        viewport.style.height =
          Math.round(
            675 *
            scale
          )
          +
          'px';


      }



      updateScale();



      if (
        'ResizeObserver'
        in window
      ) {


        new ResizeObserver(
          updateScale
        )
        .observe(
          root
        );


      } else {


        window.addEventListener(
          'resize',
          updateScale,
          {
            passive:
              true
          }
        );


      }



      /* =====================================================
         ORIGINAL CARDS
         ===================================================== */

      const originals =
        Array.from(
          track.querySelectorAll(
            ':scope > [data-video-card]'
          )
        );



      /* =====================================================
         CLONES

         В редакторе Tilda не клонируем,
         чтобы редактировать было проще.
         ===================================================== */

      let cloneSet =
        [];


      if (
        !isTildaEditor()
      ) {


        cloneSet =
          originals.map(
            function (
              card
            ) {


              const clone =
                card.cloneNode(
                  true
                );


              clone.classList.add(
                'fmvideo__clone'
              );


              clone.setAttribute(
                'aria-hidden',
                'true'
              );


              track.appendChild(
                clone
              );


              return clone;


            }
          );


      }



      /* =====================================================
         VIDEO CONTROL
         ===================================================== */

      let activeCard =
        null;


      let playing =
        false;



      function baseURL(
        frame
      ) {


        return (
          frame.dataset.src ||
          frame.getAttribute(
            'src'
          ) ||
          ''
        );


      }



      function autoplayURL(
        url
      ) {


        if (
          !url
        ) {

          return url;

        }


        if (
          /[?&]autoplay=/i
          .test(
            url
          )
        ) {

          return url;

        }


        return (
          url +
          (
            url.includes('?')
            ?
            '&'
            :
            '?'
          )
          +
          'autoplay=1'
        );


      }



      function closeCard(
        card
      ) {


        if (
          !card
        ) {

          return;

        }


        const frame =
          card.querySelector(
            '[data-video-frame]'
          );


        if (
          frame
        ) {


          /*
           * Перезагрузка iframe
           * гарантированно останавливает VK Video.
           */

          frame.src =
            'about:blank';


          requestAnimationFrame(
            function () {


              frame.src =
                baseURL(
                  frame
                );


            }
          );


        }


        card.classList.remove(
          'is-playing'
        );


        if (
          activeCard ===
          card
        ) {


          activeCard =
            null;


        }


        playing =
          false;


      }



      function openCard(
        card
      ) {


        if (
          activeCard &&
          activeCard !==
          card
        ) {


          closeCard(
            activeCard
          );


        }


        const frame =
          card.querySelector(
            '[data-video-frame]'
          );


        if (
          !frame
        ) {

          return;

        }


        activeCard =
          card;


        playing =
          true;


        card.classList.add(
          'is-playing'
        );


        const url =
          baseURL(
            frame
          );


        /*
         * Пытаемся запустить автоматически.
         * Если VK/браузер блокирует autoplay,
         * пользователь просто нажмёт Play
         * уже внутри самого VK Player.
         */

        frame.src =
          autoplayURL(
            url
          );


      }



      function prepareCard(
        card
      ) {


        const play =
          card.querySelector(
            '[data-video-play]'
          );


        const close =
          card.querySelector(
            '[data-video-close]'
          );


        if (
          play
        ) {


          play.addEventListener(
            'click',
            function (
              event
            ) {


              event.preventDefault();

              event.stopPropagation();


              openCard(
                card
              );


            }
          );


        }


        if (
          close
        ) {


          close.addEventListener(
            'click',
            function (
              event
            ) {


              event.preventDefault();

              event.stopPropagation();


              closeCard(
                card
              );


            }
          );


        }


      }



      [
        ...originals,
        ...cloneSet
      ]
      .forEach(
        prepareCard
      );



      /* =====================================================
         INFINITE CAROUSEL
         ===================================================== */

      let x =
        0;


      let last =
        performance.now();


      let loopWidth =
        0;


      let visible =
        true;



      const reducedMotion =
        window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        );



      function calculateLoopWidth() {


        if (
          !originals.length ||
          !cloneSet.length
        ) {


          loopWidth =
            0;


          return;

        }



        const first =
          originals[0]
            .getBoundingClientRect();


        const firstClone =
          cloneSet[0]
            .getBoundingClientRect();


        loopWidth =
          firstClone.left -
          first.left;


      }



      function animate(
        now
      ) {


        const delta =
          Math.min(
            40,
            now -
            last
          );


        last =
          now;



        if (
          !isTildaEditor()
          &&
          !reducedMotion.matches
          &&
          !playing
          &&
          visible
          &&
          loopWidth >
          0
        ) {


          /*
           * Скорость.
           *
           * 18 – текущая.
           * 12 – медленнее.
           * 25 – быстрее.
           */

          const speed =
            18;


          x -=
            speed *
            (
              delta /
              1000
            );



          if (
            -x >=
            loopWidth
          ) {


            x +=
              loopWidth;


          }



          track.style.transform =
            'translate3d(' +
            x.toFixed(3) +
            'px,0,0)';


        }



        requestAnimationFrame(
          animate
        );


      }



      /* =====================================================
         VISIBILITY
         ===================================================== */

      const visibilityObserver =
        new IntersectionObserver(

          function (
            entries
          ) {


            entries.forEach(
              function (
                entry
              ) {


                visible =
                  entry.isIntersecting;


              }
            );


          },

          {
            threshold:
              0
          }

        );


      visibilityObserver.observe(
        root
      );



      /* =====================================================
         RECALCULATE
         ===================================================== */

      function recalculate() {


        if (
          !cloneSet.length
        ) {

          return;

        }


        const current =
          x;


        track.style.transform =
          'translate3d(0,0,0)';


        requestAnimationFrame(
          function () {


            calculateLoopWidth();


            x =
              loopWidth
              ?
              (
                current %
                loopWidth
              )
              :
              0;


            track.style.transform =
              'translate3d(' +
              x +
              'px,0,0)';


          }
        );


      }



      window.addEventListener(
        'resize',
        recalculate,
        {
          passive:
            true
        }
      );



      /* =====================================================
         ENTRANCE
         ===================================================== */

      if (
        reducedMotion.matches
        ||
        isTildaEditor()
      ) {


        root.classList.add(
          'is-visible'
        );


      } else {


        const entranceObserver =
          new IntersectionObserver(

            function (
              entries
            ) {


              entries.forEach(
                function (
                  entry
                ) {


                  if (
                    !entry.isIntersecting
                  ) {

                    return;

                  }


                  root.classList.add(
                    'is-visible'
                  );


                  entranceObserver.disconnect();


                }
              );


            },

            {
              threshold:
                .1
            }

          );


        entranceObserver.observe(
          root
        );


      }



      /* =====================================================
         INIT
         ===================================================== */

      requestAnimationFrame(
        function () {


          calculateLoopWidth();


          last =
            performance.now();


          requestAnimationFrame(
            animate
          );


        }
      );


    }
  );


})();
</script>
