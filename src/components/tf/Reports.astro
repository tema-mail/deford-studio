---
/** «Прозрачная отчётность — без «воды» и сложных терминов». Тексты и ссылка
    на видео — с оригинала. Тёмная подложка, слева телефон с онлайн-чатом
    и плашка сообщения, справа текст и карточка-призыв с кнопкой видео. */

const VIDEO = 'https://vkvideo.ru/video-213005931_456239276?list=ln-QssLrLS6shpviZiGOL';
---

<section class="tf-section tfreports">
  <div class="tf-panel tf-panel--dark tfreports__panel">
    <div class="tf-wrap tfreports__grid">
      <div class="tfreports__media" aria-hidden="true">
        <img class="tfreports__phone" src="/img/tf/reports-phone.webp" alt="" width="760" height="927" loading="lazy" decoding="async" />
        <img class="tfreports__msg" src="/img/tf/reports-msg.webp" alt="" width="520" height="350" loading="lazy" decoding="async" />
      </div>

      <div class="tfreports__copy" data-reveal>
        <div class="tf-tag tfreports__tag">Отчётность</div>
        <h2 class="tfreports__title">Прозрачная отчётность — без «воды» и сложных терминов</h2>
        <p class="tfreports__text">
          Мы предоставляем ежедневную и еженедельную отчётность — в удобном для вас формате:
          короткое видео, созвон по видеосвязи, Google-таблица с ключевыми показателями.
        </p>
        <p class="tfreports__text">
          Всё объясняем простым языком — без сложных терминов. Вы точно понимаете, куда уходит
          бюджет и какой результат он приносит.
        </p>
        <p class="tfreports__text tfreports__text--strong">Хотите увидеть, как это выглядит на практике?</p>

        <a class="tfreports__video" href={VIDEO} target="_blank" rel="noopener">
          <span class="tfreports__video-text">
            Посмотрите короткое видео — покажем,<br />как выглядит наша работа изнутри
          </span>
          <span class="tfreports__play" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8" /></svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .tfreports__panel { padding: calc(70 * var(--u)) 0; }

  .tfreports__grid { display: grid; grid-template-columns: 1.08fr 1fr; align-items: center; gap: calc(50 * var(--u)); }

  /* По макету текст слева, телефон справа */
  .tfreports__copy { order: 1; }
  .tfreports__media { order: 2; }

  .tfreports__media { position: relative; min-height: calc(500 * var(--u)); }

  .tfreports__media::before {
    content: '';
    position: absolute;
    inset: 8% 6%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(238, 0, 0, 0.35), transparent 65%);
  }

  .tfreports__phone {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: auto;
    height: 100%;
    transform: translateX(-50%);
    object-fit: contain;
  }

  .tfreports__msg {
    position: absolute;
    left: 0;
    top: calc(40 * var(--u));
    width: calc(230 * var(--u));
    height: auto;
    filter: drop-shadow(0 16px 30px rgba(0, 0, 0, 0.5));
    animation: tfreports-float 6s ease-in-out infinite;
  }

  @keyframes tfreports-float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 calc(-8 * var(--u)); }
  }

  .tfreports__title { margin-top: calc(22 * var(--u)); font-size: calc(40 * var(--u)); line-height: 1.02; font-weight: 600; letter-spacing: -1.2px; }

  .tfreports__text {
    margin-top: calc(16 * var(--u));
    color: rgba(255, 255, 255, 0.7);
    font-size: calc(14 * var(--u));
    line-height: calc(20 * var(--u));
    font-weight: 500;
  }

  .tfreports__text--strong { color: #fff; font-weight: 600; }

  /* Кнопка по макету: белая пилюля, текст в две строки, стрелка в круге справа */
  .tfreports__video {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(18 * var(--u));
    width: max-content;
    max-width: 100%;
    margin-top: calc(26 * var(--u));
    padding: calc(6 * var(--u)) calc(6 * var(--u)) calc(6 * var(--u)) calc(26 * var(--u));
    border: 0;
    border-radius: 120px;
    background: #fff;
    color: #202020;
    font-size: calc(15 * var(--u));
    line-height: calc(19 * var(--u));
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.25s ease, filter 0.25s ease;
  }

  .tfreports__video:hover { transform: translateY(-2px); filter: brightness(1.04); }

  .tfreports__play {
    display: grid;
    place-items: center;
    width: calc(50 * var(--u));
    height: calc(50 * var(--u));
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--tf-grad);
  }

  .tfreports__play svg {
    width: 40%;
    height: 40%;
    fill: none;
    stroke: #fff;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 979px) {
    .tfreports__grid { grid-template-columns: 1fr; gap: calc(30 * var(--u)); }
    .tfreports__media { order: 2; min-height: calc(460 * var(--u)); }
  }

  @media (max-width: 640px) {
    .tfreports__panel { padding: 40px 0 0; }
    .tfreports__grid { gap: 20px; }
    .tfreports__media { min-height: 360px; }
    .tfreports__msg { top: 20px; width: 170px; }
    .tfreports__title { margin-top: 16px; font-size: clamp(27px, 7.6vw, 34px); letter-spacing: -0.8px; }
    .tfreports__text { margin-top: 12px; font-size: 14px; line-height: 19px; }
    .tfreports__video { gap: 12px; width: 100%; margin-top: 20px; padding: 6px 6px 6px 20px; border-radius: 120px; font-size: 13.5px; line-height: 17px; }
    .tfreports__play { width: 44px; height: 44px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tfreports__msg { animation: none; }
  }
</style>
