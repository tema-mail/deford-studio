---
/* Главная Target Factory: тексты и порядок блоков — с targetfactory.ru,
   дизайн — система лендинга /flowers в красно-чёрной гамме оригинала.
   Блоки добавляются по одному в порядке оригинала. Якоря меню —
   id обёрток: service, case, Calculation, command, reviews, contact. */
import TargetFactory from '../layouts/TargetFactory.astro';
import Header from '../components/tf/Header.astro';
import Hero from '../components/tf/Hero.astro';
import Facts from '../components/tf/Facts.astro';
import LeadPopup from '../components/tf/LeadPopup.astro';
import QuizCta from '../components/tf/QuizCta.astro';
import Quiz from '../components/tf/Quiz.astro';
import Reasons from '../components/tf/Reasons.astro';
import Plans from '../components/tf/Plans.astro';
import FirstLeads from '../components/tf/FirstLeads.astro';
import Cases from '../components/tf/Cases.astro';
import WhySimple from '../components/tf/WhySimple.astro';
import WhyAnimated from '../components/tf/WhyAnimated.astro';
import Founder from '../components/tf/Founder.astro';
import Reports from '../components/tf/Reports.astro';
import Reviews from '../components/tf/Reviews.astro';
import Faq from '../components/tf/Faq.astro';
---

<TargetFactory
  title="Стабильно привлекаем клиентов через ВК, даже если раньше реклама не работала или «сливался» бюджет"
  description="Запускаем рекламу, которая приносит заявки и прибыль. Более 200 успешных проектов и 500+ млн ₽ рекламных бюджетов только за последние 2 года работы"
>
  <Header />
  <Hero />
  <Facts />
  <QuizCta />
  <Reasons />
  <Plans />
  <FirstLeads />
  <Cases />

  <!-- «Почему выбирают нас» в двух вариантах — на выбор, второй потом убрать -->
  <p class="tf-variant">Вариант 1 — простой</p>
  <WhySimple />
  <p class="tf-variant">Вариант 2 — с анимацией</p>
  <WhyAnimated />
  <Founder />
  <Reports />
  <Reviews />
  <Faq />


  <LeadPopup />
  <Quiz />
</TargetFactory>

<style>
  /* подпись варианта для выбора — временная */
  .tf-variant {
    max-width: 1080px;
    margin: 24px auto 0;
    padding: 8px 16px;
    border: 1px dashed #b5b5b5;
    border-radius: 12px;
    color: #6b6b6b;
    font: 600 13px/1.4 Arial, sans-serif;
    text-align: center;
  }

  @media (max-width: 1112px) {
    .tf-variant { margin: 20px 16px 0; }
  }
</style>
