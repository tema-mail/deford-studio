---
/** «Почему выбирают нас» — вариант 1, простой. По решению Артёма без
    лампочек и огромных номеров: пять карточек с иконками на светлой
    подложке, появляются при прокрутке. Тексты — с оригинала, общие
    с вариантом 2 — в src/data/tf-why.json. */

import why from '../../data/tf-why.json';

const whyItems = why.items;
const whyIcons: Record<string, string> = why.icons;
---

<section class="tf-section tfwhy1">
  <div class="tf-panel tf-panel--light tfwhy1__panel">
    <div class="tf-wrap tfwhy1__grid">
      <div class="tfwhy1__intro" data-reveal>
        <div class="tf-tag">Преимущества</div>
        <h2 class="tf-h2 tfwhy1__title">Почему <br />выбирают нас</h2>
        <a class="tf-btn tf-btn--red tfwhy1__btn" href="#zeropopup">
          <span>Получить бесплатную консультацию</span>
          <span class="tf-btn__arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8"></path></svg></span>
        </a>
      </div>

      {
        whyItems.map((it, i) => (
          <article class="tf-card tfwhy1__card" data-reveal style={`--reveal-delay: ${(i % 3) * 0.08}s`}>
            <span class="tfwhy1__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={whyIcons[it.icon]}></path></svg>
            </span>
            <h3 class="tfwhy1__card-title">{it.title}</h3>
            {it.text && <p class="tfwhy1__card-text">{it.text}</p>}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .tfwhy1__panel { padding: calc(80 * var(--u)) 0; }

  .tfwhy1__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(20 * var(--u));
  }

  .tfwhy1__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: calc(8 * var(--u)) calc(8 * var(--u)) 0 0;
  }

  .tfwhy1__title { margin-top: calc(24 * var(--u)); }
  /* кнопка под заголовком с отступом, а не прижата к низу ряда — не налезает */
  .tfwhy1__btn { margin-top: calc(32 * var(--u)); }

  .tfwhy1__card {
    display: flex;
    flex-direction: column;
    min-height: calc(180 * var(--u));
    padding: calc(26 * var(--u));
  }

  .tfwhy1__icon {
    display: grid;
    place-items: center;
    width: calc(46 * var(--u));
    height: calc(46 * var(--u));
    margin-bottom: auto;
    border-radius: 50%;
    border: 1px solid rgba(227, 19, 27, 0.35);
    background: rgba(227, 19, 27, 0.1);
    color: #ff4a4f;
  }

  .tfwhy1__icon svg {
    width: 48%;
    height: 48%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tfwhy1__card-title {
    margin-top: calc(26 * var(--u));
    font-size: calc(20 * var(--u));
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.5px;
  }

  .tfwhy1__card-text {
    margin-top: calc(10 * var(--u));
    color: var(--tf-muted-light);
    font-size: calc(13 * var(--u));
    line-height: calc(18 * var(--u));
    font-weight: 500;
  }

  @media (max-width: 979px) {
    .tfwhy1__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tfwhy1__intro { grid-column: 1 / -1; padding: 0 0 calc(10 * var(--u)); }
    .tfwhy1__btn { margin-top: calc(26 * var(--u)); }
  }

  @media (max-width: 640px) {
    .tfwhy1__panel { padding: 46px 0 30px; }
    .tfwhy1__grid { grid-template-columns: 1fr; gap: 10px; }
    .tfwhy1__intro { padding-bottom: 14px; }
    .tfwhy1__title { margin-top: 18px; }
    .tfwhy1__btn { margin-top: 22px; }

    .tfwhy1__card {
      display: grid;
      grid-template-columns: 44px 1fr;
      column-gap: 14px;
      align-items: center;
      min-height: 0;
      padding: 16px 18px;
    }

    .tfwhy1__icon { grid-row: span 2; width: 44px; height: 44px; margin: 0; }
    .tfwhy1__card-title { margin-top: 0; font-size: clamp(16px, 4.6vw, 19px); }
    .tfwhy1__card-text { margin-top: 4px; font-size: 13px; line-height: 17px; }
  }
</style>
