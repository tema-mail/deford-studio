ight-value=\"260\" data-field-width-value=\"589\" data-field-axisy-value=\"top\" data-field-axisx-value=\"left\" data-field-container-value=\"grid\" data-field-topunits-value=\"px\" data-field-leftunits-value=\"px\" data-field-heightunits-value=\"px\" data-field-widthunits-value=\"px\" data-field-textfit-value=\"autoheight\" data-field-fontsize-value=\"17\" data-field-top-res-320-value=\"421\" data-field-left-res-320-value=\"24\" data-field-width-res-320-value=\"285\" data-field-fontsize-res-320-value=\"12\" data-field-top-res-960-value=\"102\" data-field-left-res-960-value=\"43\" data-field-width-res-960-value=\"488\" data-field-fontsize-res-960-value=\"14\"> <div class='tn-atom'field='tn_text_1676614112888'><span style=\"background-color: rgb(255, 255, 255);\">BOOMBOX - это новая доставка роллов в Новосибирске. Очень креативные ребята, которые нарисуют ваш портрет на пакете, пока готовится заказ.</span><br><br><span style=\"background-color: rgb(255, 255, 255);\">Для компании мы разработали яркий шрифтовой логотип и п</span>ростой понятный лендинг для пользователя, который точно покорит Ваши сердца. Нет лишней информации, а только продукция, доставка, акции и контакты.<br><br>Далее<span style=\"background-color: rgb(255, 255, 255);\"> были разработаны элементы фирменного стиля: деловая документация (визитные карточки, бланки), сувенирная продукция (блокноты, пакеты) и фирменная одежда (футболки, кепки и фартуки).</span></div> </div> </div> </div>   </div>"},{"id":"552540109","type":"396","html":"<div id=\"rec552540109\" class=\"r t-rec\" style=\" \" data-animationappear=\"off\" data-record-type=\"396\">  <style>#rec552540109 .t396__artboard {height:2090px;}#rec552540109 .t396__filter {height:2090px;}#rec552540109 .t396__carrier{height:2090px;background-position:center center;background-attachment:scroll;background-size:cover;background-repeat:no-repeat;}@media screen and (max-width:1199px) {#rec552540109 .t396__artboard,#rec552540109 .t396__filter,#rec552540109 .t