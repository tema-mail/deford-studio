---
/** «Делаем интернет-магазины для цветочных салонов» — короткий вход
    в кейсы сайтов (следующий блок ShopCases.astro). По правкам Артёма
    и Дениса Коротаева: только заголовок, подводка и три тезиса —
    почему старые сайты цветочных не продают; внизу ссылка к кейсам.

    Стилистика — с соседних секций: серая подложка #dbdbdb, графит,
    лайм #cefe46, пилюля-тег, заголовок 33/33, белые карточки.
    Цифры про штрафы — от Артёма; доля сайтов подписана как оценка. */

const points = [
  {
    icon: 'old',
    title: 'Сайты, сделанные 5–10 лет назад, уже не работают',
    text: 'Каталог-«портянка» из сотни одинаковых карточек не продаёт: покупатель теряется и уходит к конкурентам.',
  },
  {
    icon: 'law',
    title: 'Штрафы до 3 млн ₽ в 2027 году',
    text: 'По нашей оценке, больше 80% сайтов не готовы к требованиям законов, принятых в 2026 году.',
  },
  {
    icon: 'sales',
    title: 'Сайты не продают, потому что сделаны без маркетинга',
    text: 'Их собирали как витрину — без сценария заказа, аналитики и связки с рекламой.',
  },
];
---

<section class="fmsites" data-fmsites>
  <div class="fmsites__viewport">
    <header class="fmsites__header">
      <div class="fmsites__tag">Сайты</div>
      <h2 class="fmsites__title">
        Делаем интернет-магазины для цветочных салонов с упором на маркетинг и продажи
      </h2>
      <p class="fmsites__lead">
        Мы не только приводим трафик, но и создаём сайты, которые продают.
        За плечами — больше 10 лет опыта и огромное количество кейсов.
      </p>
    </header>

    <div class="fmsites__points">
      {
        points.map((p) => (
          <article class="fmsites__point">
            <span class="fmsites__icon" aria-hidden="true">
              {p.icon === 'old' && (
                <svg viewBox="0 0 24 24">
                  <rect x="4" y="5" width="16" height="15" rx="2.5" />
                  <path d="M4 10h16M9 3v4M15 3v4M9.5 14.5l5 3M14.5 14.5l-5 3" />
                </svg>
              )}
              {p.icon === 'law' && (
                <svg viewBox="0 0 24 24">
                  <path d="M12 4l9 16H3z" />
                  <path d="M12 10v4.5M12 17.3v.2" />
                </svg>
              )}
              {p.icon === 'sales' && (
                <svg viewBox="0 0 24 24">
                  <path d="M4 6l5 5 4-3 7 8" />
                  <path d="M15 16h5v-5" />
                </svg>
              )}
            </span>
            <div>
              <h3 class="fmsites__point-title">{p.title}</h3>
              <p class="fmsites__point-text">{p.text}</p>
            </div>
          </article>
        ))
      }
    </div>

    <a class="fmsites__more" href="#shops">
      <span>Посмотрите ниже малую часть наших сайтов, которые мы недавно сдали</span>
      <span class="fmsites__more-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
      </span>
    </a>
  </div>
</section>

<style is:global>
  .fmsites {
    --fs-dark: #202020;
    --fs-green: #cefe46;
    --fs-bg: #dbdbdb;
    position: relative;
    width: 100%;
    padding: 15px 0 0;
    background: #fff;
    color: var(--fs-dark);
    font-family: 'Inter Tight', Inter, Arial, sans-serif;
    /* единица макета: 1/1200 ширины секции, как у соседних секций */
    container-type: inline-size;
  }

  .fmsites,
  .fmsites * {
    box-sizing: border-box;
  }

  .fmsites__viewport {
    --u: calc(100cqw / 1200);
    width: 100%;
    padding: calc(88 * var(--u)) 0 calc(72 * var(--u));
    overflow: hidden;
    background: var(--fs-bg);
    border-radius: clamp(42px, 6.25vw, 120px);
  }

  .fmsites__header {
    width: calc(760 * var(--u));
    margin: 0 auto;
    text-align: center;
  }

  .fmsites__tag {
    width: max-content;
    margin: 0 auto calc(27 * var(--u));
    padding: calc(7 * var(--u)) calc(10 * var(--u));
    background: #fff;
    border: 1px solid #ededee;
    border-radius: 100px;
    font-size: calc(11 * var(--u));
    line-height: calc(13 * var(--u));
  }

  .fmsites__title {
    margin: 0;
    font-size: calc(33 * var(--u));
    line-height: calc(35 * var(--u));
    font-weight: 600;
    letter-spacing: -1px;
  }

  .fmsites__lead {
    width: calc(560 * var(--u));
    margin: calc(18 * var(--u)) auto 0;
    color: rgba(32, 32, 32, 0.6);
    font-size: calc(14 * var(--u));
    line-height: calc(19 * var(--u));
    font-weight: 500;
  }

  /* Три тезиса — белые карточки в ряд */
  .fmsites__points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(20 * var(--u));
    width: calc(1080 * var(--u));
    margin: calc(44 * var(--u)) auto 0;
  }

  .fmsites__point {
    display: flex;
    flex-direction: column;
    gap: calc(28 * var(--u));
    padding: calc(24 * var(--u));
    border-radius: calc(27 * var(--u));
    background: linear-gradient(180deg, #ffffff 0%, #f6f6f6 100%);
  }

  .fmsites__icon {
    display: grid;
    place-items: center;
    width: calc(44 * var(--u));
    height: calc(44 * var(--u));
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--fs-green);
  }

  .fmsites__icon svg {
    width: 50%;
    height: 50%;
    fill: none;
    stroke: var(--fs-dark);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fmsites__point-title {
    margin: 0;
    font-size: calc(19 * var(--u));
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.5px;
  }

  .fmsites__point-text {
    margin: calc(8 * var(--u)) 0 0;
    color: rgba(0, 0, 0, 0.5);
    font-size: calc(12 * var(--u));
    line-height: calc(16 * var(--u));
    font-weight: 500;
  }

  /* Переход к кейсам */
  .fmsites__more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(12 * var(--u));
    width: max-content;
    margin: calc(36 * var(--u)) auto 0;
    color: var(--fs-dark);
    font-size: calc(15 * var(--u));
    line-height: calc(18 * var(--u));
    font-weight: 600;
    text-decoration: none;
  }

  .fmsites__more-arrow {
    display: grid;
    place-items: center;
    width: calc(40 * var(--u));
    height: calc(40 * var(--u));
    border-radius: 50%;
    background: var(--fs-dark);
    animation: fmsites-nudge 2.4s ease-in-out infinite;
  }

  .fmsites__more-arrow svg {
    width: 45%;
    height: 45%;
    fill: none;
    stroke: var(--fs-green);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @keyframes fmsites-nudge {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 calc(4 * var(--u)); }
  }

  /* Появление при прокрутке — только если скрипт включил анимацию */
  .fmsites.is-anim .fmsites__point { opacity: 0; }

  .fmsites.is-anim.is-ready .fmsites__point {
    animation: fmsites-in 0.7s cubic-bezier(0.16, 0.82, 0.21, 1) both;
  }

  .fmsites.is-anim.is-ready .fmsites__point:nth-child(2) { animation-delay: 0.1s; }
  .fmsites.is-anim.is-ready .fmsites__point:nth-child(3) { animation-delay: 0.2s; }

  @keyframes fmsites-in {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }

  /* ПЛАНШЕТ: макет 800, тезисы столбиком */
  @media (max-width: 979px) {
    .fmsites__viewport { --u: calc(100cqw / 800); padding: calc(70 * var(--u)) 0 calc(60 * var(--u)); }
    .fmsites__header { width: calc(640 * var(--u)); }
    .fmsites__points { grid-template-columns: 1fr; width: calc(640 * var(--u)); gap: calc(14 * var(--u)); }
    .fmsites__point { flex-direction: row; align-items: flex-start; gap: calc(18 * var(--u)); }
  }

  /* ТЕЛЕФОН */
  @media (max-width: 640px) {
    .fmsites { background: transparent; }
    .fmsites__viewport { padding: 48px 0 40px; border-radius: 36px; }
    .fmsites__header { width: 100%; padding: 0 18px; }
    .fmsites__tag { margin-bottom: 20px; padding: 7px 10px; font-size: 11px; line-height: 13px; }

    .fmsites__title {
      max-width: 460px;
      margin: 0 auto;
      font-size: clamp(25px, 7vw, 33px);
      line-height: 1;
      letter-spacing: -0.8px;
    }

    .fmsites__lead { width: 100%; margin-top: 14px; font-size: 14px; line-height: 19px; }
    .fmsites__points { width: 100%; margin-top: 28px; padding: 0 18px; gap: 10px; }
    .fmsites__point { gap: 14px; padding: 18px; border-radius: 24px; }
    .fmsites__icon { width: 44px; height: 44px; }
    .fmsites__point-title { font-size: clamp(17px, 4.8vw, 20px); }
    .fmsites__point-text { margin-top: 6px; font-size: 13px; line-height: 17px; }

    .fmsites__more {
      gap: 12px;
      width: auto;
      margin: 26px 18px 0;
      justify-content: space-between;
      font-size: 14px;
      line-height: 18px;
      text-align: left;
    }

    .fmsites__more-arrow { width: 40px; height: 40px; flex: 0 0 auto; }

    @keyframes fmsites-nudge {
      0%, 100% { translate: 0 0; }
      50% { translate: 0 4px; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fmsites__more-arrow { animation: none; }
    .fmsites.is-anim .fmsites__point { opacity: 1 !important; animation: none !important; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-fmsites]');
    if (!root || !('IntersectionObserver' in window)) return;

    root.classList.add('is-anim');

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          root.classList.add('is-ready');
          io.disconnect();
        });
      },
      { threshold: 0.15 },
    );

    io.observe(root);
  })();
</script>
