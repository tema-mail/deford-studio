---
/** «Давайте поговорим, а там решите» — финальный призыв (якорь contact).
    Тексты и ссылки — с оригинала. Красно-тёмная подложка, слева текст
    с мигающим курсором после первой строки (как печатный эффект
    оригинала, но спокойнее) и две кнопки мессенджеров, справа —
    телефоны с сообществом ВКонтакте. */

const TG = 'https://t.me/korotaev_denis';
const MAX = 'https://max.ru/u/f9LHodD0cOLcKLkeG8Hr_oFXFF0snzqnNOGgHN2cX0meUwSiovnBh1wb8xM';
---

<section class="tf-section tfcontact" id="contact">
  <div class="tf-panel tf-panel--dark tfcontact__panel">
    <img class="tfcontact__bg" src="/img/tf/contact-bg.jpg" alt="" width="1400" height="932" loading="lazy" decoding="async" />

    <div class="tf-wrap tfcontact__grid">
      <div class="tfcontact__copy" data-reveal>
        <h2 class="tfcontact__title">
          <span class="tfcontact__type">Давайте поговорим,</span><br />а там решите
        </h2>
        <p class="tfcontact__text">
          Мы понимаем, что Вы хотите получать больше продаж и наша задача — понять, чем мы
          можем быть полезны.
        </p>

        <div class="tfcontact__buttons">
          <a class="tfcontact__btn tfcontact__btn--tg" href={TG} target="_blank" rel="noopener">
            <img src="/img/tf/ic-tg.svg" alt="" width="38" height="38" />
            <span>Написать в Telegram</span>
          </a>
          <a class="tfcontact__btn tfcontact__btn--max" href={MAX} target="_blank" rel="noopener">
            <img src="/img/tf/ic-max.png" alt="" width="38" height="38" />
            <span>Написать в MAX</span>
          </a>
        </div>
      </div>

      <img
        class="tfcontact__phones"
        src="/img/tf/contact-phones.webp"
        alt="Сообщество Target Factory ВКонтакте на телефонах"
        width="640"
        height="1039"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<style is:global>
  .tfcontact__panel { padding: calc(70 * var(--u)) 0 0; }

  .tfcontact__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.85; }

  .tfcontact__panel::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(90deg, rgba(20, 20, 20, 0.92) 0%, rgba(20, 20, 20, 0.6) 45%, rgba(20, 20, 20, 0.15) 100%);
    pointer-events: none;
  }

  .tfcontact__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr calc(430 * var(--u));
    align-items: end;
    gap: calc(40 * var(--u));
  }

  .tfcontact__copy { align-self: center; padding-bottom: calc(70 * var(--u)); }

  .tfcontact__title { font-size: calc(48 * var(--u)); line-height: 1; font-weight: 600; letter-spacing: -1.5px; }

  /* мигающий курсор после первой строки */
  .tfcontact__type::after {
    content: '';
    display: inline-block;
    width: 0.06em;
    height: 0.9em;
    margin-left: 0.08em;
    vertical-align: -0.08em;
    background: var(--tf-red);
    animation: tfcontact-caret 1s steps(1) infinite;
  }

  @keyframes tfcontact-caret {
    50% { opacity: 0; }
  }

  .tfcontact__text {
    max-width: calc(440 * var(--u));
    margin-top: calc(20 * var(--u));
    color: rgba(255, 255, 255, 0.7);
    font-size: calc(15 * var(--u));
    line-height: calc(21 * var(--u));
    font-weight: 500;
  }

  .tfcontact__buttons { display: flex; flex-direction: column; align-items: flex-start; gap: calc(12 * var(--u)); margin-top: calc(32 * var(--u)); }

  .tfcontact__btn {
    display: inline-flex;
    align-items: center;
    gap: calc(12 * var(--u));
    min-width: calc(320 * var(--u));
    min-height: calc(58 * var(--u));
    padding: calc(6 * var(--u)) calc(26 * var(--u)) calc(6 * var(--u)) calc(8 * var(--u));
    border-radius: 100px;
    color: #fff;
    font-size: calc(15 * var(--u));
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .tfcontact__btn:hover { transform: translateY(-2px); }
  .tfcontact__btn img { width: calc(44 * var(--u)); height: calc(44 * var(--u)); }

  .tfcontact__btn--tg { background: linear-gradient(270deg, #0a76b8 0%, #24a1de 100%); box-shadow: 0 10px 30px rgba(36, 161, 222, 0.25); }
  .tfcontact__btn--max { background: linear-gradient(270deg, #3d0bb3 0%, #e00 100%); box-shadow: 0 10px 30px rgba(120, 20, 180, 0.25); }

  .tfcontact__phones { width: 100%; height: auto; margin-top: calc(-10 * var(--u)); filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.5)); }

  @media (max-width: 979px) {
    .tfcontact__grid { grid-template-columns: 1fr calc(300 * var(--u)); }
    .tfcontact__btn { min-width: calc(280 * var(--u)); }
  }

  @media (max-width: 640px) {
    .tfcontact__panel { padding: 44px 0 0; }
    .tfcontact__panel::before { background: linear-gradient(180deg, rgba(20, 20, 20, 0.92) 0%, rgba(20, 20, 20, 0.6) 60%, rgba(20, 20, 20, 0.3) 100%); }
    .tfcontact__grid { grid-template-columns: 1fr; gap: 16px; }
    .tfcontact__copy { padding-bottom: 0; }
    .tfcontact__title { font-size: clamp(30px, 8.6vw, 40px); letter-spacing: -1px; }
    .tfcontact__text { max-width: none; margin-top: 14px; font-size: 14px; line-height: 19px; }
    .tfcontact__buttons { align-items: stretch; gap: 10px; margin-top: 22px; }
    .tfcontact__btn { min-width: 0; min-height: 56px; padding: 6px 20px 6px 7px; font-size: 15px; }
    .tfcontact__btn img { width: 42px; height: 42px; }
    .tfcontact__phones { width: 78%; margin: 6px auto 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tfcontact__type::after { animation: none; }
  }
</style>
