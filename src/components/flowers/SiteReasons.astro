---
/** «6 причин сделать новый сайт уже в этом месяце» — после кейсов сайтов,
    перед подарком. По правке Артёма: две группы по три причины — для тех,
    у кого сайт есть (тезисы, перенесённые из вводного блока), и для тех,
    у кого его ещё нет. Коротко, в стилистике соседних блоков.

    Про оплату в соцсетях проверено: переводы без чека — штраф
    ст. 14.5 КоАП (для компаний до 100% суммы); уголовная ст. 187 УК
    с 2025 года касается переводов через чужие карты («дропперы»),
    поэтому формулировка — «может попасть». Цифры про штрафы 2027 года
    и 1000 продаж в месяц — от Артёма. */

const groups = [
  {
    label: 'Для тех, у кого есть сайт',
    tone: 'dark',
    items: [
      {
        icon: 'old',
        title: 'Сайты, сделанные 5–10 лет назад, уже не работают',
        text: 'Каталог-«портянка» из сотни одинаковых карточек не продаёт: покупатель теряется и уходит к конкурентам.',
      },
      {
        icon: 'law',
        title: 'Штрафы до 3 млн ₽ в 2027 году',
        text: 'По нашей оценке, больше 80% сайтов не готовы к требованиям законов, принятых в 2026 году.',
      },
      {
        icon: 'sales',
        title: 'Сайты не продают, потому что сделаны без маркетинга',
        text: 'Их собирали как витрину — без сценария заказа, аналитики и связки с рекламой.',
      },
    ],
  },
  {
    label: 'Для тех, у кого ещё нет сайта',
    tone: 'green',
    items: [
      {
        icon: 'online',
        title: 'Без сайта вы теряете тех, кто покупает онлайн',
        text: 'Поверьте, мы знаем, о чём говорим: каждый месяц мы приводим нашим клиентам из интернета 1000 продаж.',
      },
      {
        icon: 'repeat',
        title: 'Без сайта сложно удерживать клиентов',
        text: 'Нет истории заказов, бонусов и напоминаний о важных датах — каждый повторный заказ приходится завоёвывать заново.',
      },
      {
        icon: 'pay',
        title: 'Оплата в соцсетях и мессенджерах — это риск',
        text: 'Переводы без чека — штраф до 100% суммы, а оплата на карты сотрудников может попасть под уголовную ст. 187 УК. Сайт с онлайн-кассой принимает платежи законно.',
      },
    ],
  },
];

const icons: Record<string, string> = {
  old: 'M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v10a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5zM4 10h16M9 3v4M15 3v4M9.5 14l5 3.5M14.5 14l-5 3.5',
  law: 'M12 4l9 16H3zM12 10v4.5M12 17.3v.2',
  sales: 'M4 6l5 5 4-3 7 8M15 16h5v-5',
  online: 'M12 3a9 9 0 1 0 0 18a9 9 0 0 0 0-18zM3 12h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9z',
  repeat: 'M17 2l3 3-3 3M4 11V9a4 4 0 0 1 4-4h12M7 22l-3-3 3-3M20 13v2a4 4 0 0 1-4 4H4',
  pay: 'M12 3l7 3v6c0 4.4-3 7.8-7 9-4-1.2-7-4.6-7-9V6zM9 12l2 2 4-4',
};
---

<section class="fmsix" data-fmsix>
  <div class="fmsix__viewport">
    <header class="fmsix__header">
      <div class="fmsix__tag">Почему сейчас</div>
      <h2 class="fmsix__title">6 причин сделать новый сайт <br />уже в этом месяце</h2>
    </header>

    <div class="fmsix__groups">
      {
        groups.map((g) => (
          <div class="fmsix__group">
            <div class={`fmsix__label fmsix__label--${g.tone}`}>{g.label}</div>
            {g.items.map((it) => (
              <article class="fmsix__card">
                <span class={`fmsix__icon fmsix__icon--${g.tone}`} aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d={icons[it.icon]}></path></svg>
                </span>
                <div>
                  <h3 class="fmsix__card-title">{it.title}</h3>
                  <p class="fmsix__card-text">{it.text}</p>
                </div>
              </article>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .fmsix {
    --fx-dark: #202020;
    --fx-green: #cefe46;
    position: relative;
    width: 100%;
    padding: 15px 0 0;
    background: #fff;
    color: var(--fx-dark);
    font-family: 'Inter Tight', Inter, Arial, sans-serif;
    container-type: inline-size;
  }

  .fmsix,
  .fmsix * { box-sizing: border-box; }

  .fmsix__viewport {
    --u: calc(100cqw / 1200);
    width: 100%;
    padding: calc(80 * var(--u)) 0;
    overflow: hidden;
    background: #dbdbdb;
    border-radius: clamp(42px, 6.25vw, 120px);
  }

  .fmsix__header { width: calc(760 * var(--u)); margin: 0 auto; text-align: center; }

  .fmsix__tag {
    width: max-content;
    margin: 0 auto calc(27 * var(--u));
    padding: calc(7 * var(--u)) calc(10 * var(--u));
    border: 1px solid #ededee;
    border-radius: 100px;
    background: #fff;
    font-size: calc(11 * var(--u));
    line-height: calc(13 * var(--u));
  }

  .fmsix__title {
    margin: 0;
    font-size: calc(33 * var(--u));
    line-height: calc(35 * var(--u));
    font-weight: 600;
    letter-spacing: -1px;
  }

  .fmsix__groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(20 * var(--u));
    width: calc(1080 * var(--u));
    margin: calc(44 * var(--u)) auto 0;
  }

  .fmsix__group { display: flex; flex-direction: column; gap: calc(10 * var(--u)); }

  .fmsix__label {
    align-self: flex-start;
    margin-bottom: calc(6 * var(--u));
    padding: calc(9 * var(--u)) calc(16 * var(--u));
    border-radius: 100px;
    font-size: calc(14 * var(--u));
    line-height: calc(16 * var(--u));
    font-weight: 600;
  }

  .fmsix__label--dark { background: var(--fx-dark); color: #fff; }
  .fmsix__label--green { background: var(--fx-green); color: var(--fx-dark); }

  .fmsix__card {
    display: flex;
    align-items: flex-start;
    gap: calc(16 * var(--u));
    padding: calc(20 * var(--u)) calc(22 * var(--u));
    border-radius: calc(24 * var(--u));
    background: linear-gradient(180deg, #ffffff 0%, #f6f6f6 100%);
  }

  .fmsix__icon {
    display: grid;
    place-items: center;
    width: calc(44 * var(--u));
    height: calc(44 * var(--u));
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .fmsix__icon--dark { background: var(--fx-dark); color: var(--fx-green); }
  .fmsix__icon--green { background: var(--fx-green); color: var(--fx-dark); }

  .fmsix__icon svg {
    width: 50%;
    height: 50%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fmsix__card-title {
    margin: 0;
    font-size: calc(17 * var(--u));
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: -0.4px;
  }

  .fmsix__card-text {
    margin: calc(6 * var(--u)) 0 0;
    color: rgba(0, 0, 0, 0.5);
    font-size: calc(12 * var(--u));
    line-height: calc(16 * var(--u));
    font-weight: 500;
  }

  /* Появление при прокрутке — только если скрипт включил анимацию */
  .fmsix.is-anim .fmsix__card { opacity: 0; }

  .fmsix.is-anim.is-ready .fmsix__card {
    animation: fmsix-in 0.6s cubic-bezier(0.16, 0.82, 0.21, 1) both;
  }

  .fmsix.is-anim.is-ready .fmsix__card:nth-child(3) { animation-delay: 0.08s; }
  .fmsix.is-anim.is-ready .fmsix__card:nth-child(4) { animation-delay: 0.16s; }
  .fmsix.is-anim.is-ready .fmsix__group:nth-child(2) .fmsix__card { animation-delay: 0.12s; }
  .fmsix.is-anim.is-ready .fmsix__group:nth-child(2) .fmsix__card:nth-child(3) { animation-delay: 0.2s; }
  .fmsix.is-anim.is-ready .fmsix__group:nth-child(2) .fmsix__card:nth-child(4) { animation-delay: 0.28s; }

  @keyframes fmsix-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: none; }
  }

  /* Планшет: группы друг под другом, макет 800 */
  @media (max-width: 979px) {
    .fmsix__viewport { --u: calc(100cqw / 800); padding: calc(64 * var(--u)) 0; }
    .fmsix__header { width: calc(640 * var(--u)); }
    .fmsix__groups { grid-template-columns: 1fr; width: calc(640 * var(--u)); gap: calc(30 * var(--u)); }
  }

  @media (max-width: 640px) {
    .fmsix { background: transparent; }
    .fmsix__viewport { padding: 48px 0 40px; border-radius: 36px; }
    .fmsix__header { width: 100%; padding: 0 18px; }
    .fmsix__tag { margin-bottom: 20px; padding: 7px 10px; font-size: 11px; line-height: 13px; }

    .fmsix__title {
      max-width: 460px;
      margin: 0 auto;
      font-size: clamp(25px, 7vw, 33px);
      line-height: 1;
      letter-spacing: -0.8px;
    }

    .fmsix__title br { display: none; }
    .fmsix__groups { width: 100%; margin-top: 28px; padding: 0 18px; gap: 24px; }
    .fmsix__group { gap: 8px; }
    .fmsix__label { margin-bottom: 4px; padding: 8px 14px; font-size: 13px; line-height: 15px; }
    .fmsix__card { gap: 14px; padding: 16px; border-radius: 20px; }
    .fmsix__icon { width: 42px; height: 42px; }
    .fmsix__card-title { font-size: clamp(16px, 4.5vw, 18px); }
    .fmsix__card-text { margin-top: 5px; font-size: 13px; line-height: 17px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fmsix.is-anim .fmsix__card { opacity: 1 !important; animation: none !important; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-fmsix]');
    if (!root || !('IntersectionObserver' in window)) return;

    root.classList.add('is-anim');

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          root.classList.add('is-ready');
          io.disconnect();
        });
      },
      { threshold: 0.12 },
    );

    io.observe(root);
  })();
</script>
