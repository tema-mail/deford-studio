---
/**
 * Попап «Оставьте заявку». Заменяет Zero Block Тильды rec4209528401:
 * собственная вёрстка с размерами оригинала.
 *
 * Отправка пока идёт в формы Тильды — тот же адрес и те же служебные
 * поля, что и раньше, чтобы заявки продолжали приходить на прежнюю почту.
 * При полном отказе от Тильды сюда нужно подставить свой обработчик.
 */
const FORM_ACTION = 'https://forms.tildacdn.com/procces/';

const hiddenFields = [
  { name: 'formservices[]', value: '4aeb316205afb1feb17880ecae0aa068' },
  { name: 'formservices[]', value: 'ec7a97daaec772f089d90b3bf33fa3ad' },
  { name: 'tildaspec-elemid', value: '1653543745902' },
];

const fields = [
  { name: 'name', type: 'text', placeholder: 'Ваше имя', icon: '/img/bi_person-fill.svg' },
  { name: 'phone', type: 'tel', placeholder: 'Ваш телефон', icon: '/img/ci_phone.svg' },
  { name: 'task', type: 'text', placeholder: 'Задача', icon: '/img/bxs_message.svg' },
];
---

<div class="df-popup" data-popup hidden>
  <div class="df-popup__card" role="dialog" aria-modal="true" aria-label="Оставьте заявку">
    <button class="df-popup__close" type="button" aria-label="Закрыть" data-popup-close>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 4l16 16M20 4L4 20"></path>
      </svg>
    </button>

    <h2 class="df-popup__title">Оставьте заявку<span>.</span></h2>

    <p class="df-popup__subtitle">
      Заполните поля ниже и наш менеджер<br />свяжется с Вами в ближайшее время
    </p>

    <form class="df-popup__form" action={FORM_ACTION} method="POST">
      {hiddenFields.map((f) => <input type="hidden" name={f.name} value={f.value} />)}

      {
        fields.map((field) => (
          <label class="df-popup__field">
            <input
              class="df-popup__input"
              type={field.type}
              name={field.name}
              placeholder={field.placeholder}
              autocomplete={field.name === 'phone' ? 'tel' : field.name === 'name' ? 'name' : 'off'}
            />
            <img class="df-popup__icon" src={field.icon} alt="" width="26" height="26" />
          </label>
        ))
      }

      <label class="df-popup__consent">
        <input type="checkbox" name="Checkbox" value="yes" />
        <span>
          Я ознакомлен (-а) с <a href="/policy" target="_blank" rel="noopener noreferrer">Политикой обработки персональных данных</a> и даю <a href="/agreement" target="_blank" rel="noopener noreferrer">согласие</a> на их использование
        </span>
      </label>

      <button class="df-popup__submit" type="submit">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 20l4-1 11-11-3-3L5 16l-1 4Z"></path>
          <path d="M15 5l3 3"></path>
        </svg>
        Оставить заявку
      </button>
    </form>
  </div>
</div>

<style>
  .df-popup {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-y: auto;
  }

  .df-popup[hidden] {
    display: none;
  }

  .df-popup__card {
    position: relative;
    width: 869px;
    max-width: calc(100% - 24px);
    padding: 79px 117px 52px;
    border-radius: 40px;
    background: #fff;
  }

  .df-popup__close {
    position: absolute;
    right: 82px;
    top: 102px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 43px;
    height: 43px;
  }

  .df-popup__close svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: #9aa3ad;
    stroke-width: 1.4;
  }

  .df-popup__title {
    min-height: 94px;
    font-size: 50px;
    font-weight: 500;
    line-height: 78px;
    color: #0c1013;
  }

  .df-popup__title span {
    color: #0f68ff;
  }

  .df-popup__subtitle {
    min-height: 82px;
    max-width: 616px;
    font-size: 22px;
    font-weight: 300;
    line-height: 34px;
    color: #8c8c8c;
  }

  .df-popup__form {
    margin-top: 54px;
  }

  /* Поле: иконка слева, подчёркивание на всю ширину */
  .df-popup__field {
    position: relative;
    display: block;
    width: 584px;
    max-width: 100%;
    height: 60px;
    margin-left: 41px;
  }

  .df-popup__field + .df-popup__field {
    margin-top: 24px;
  }

  .df-popup__input {
    width: 100%;
    height: 100%;
    padding: 26px 0 10px;
    border: 0;
    border-bottom: 1px solid #dbdbdb;
    border-radius: 0;
    background: none;
    font-family: inherit;
    font-size: 16px;
    font-weight: 300;
    color: #000;
  }

  .df-popup__input::placeholder {
    color: #000;
    opacity: 0.5;
  }

  .df-popup__input:focus {
    outline: none;
    border-bottom-color: #0f68ff;
  }

  .df-popup__icon {
    position: absolute;
    left: -38px;
    bottom: 12px;
    width: 26px;
    height: 26px;
    pointer-events: none;
  }

  .df-popup__consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    width: 584px;
    max-width: 100%;
    min-height: 34px;
    margin-top: 24px;
    margin-left: 41px;
    font-size: 10px;
    font-weight: 400;
    line-height: 12px;
    color: #000;
  }

  .df-popup__consent input {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: #0f68ff;
  }

  .df-popup__consent a {
    color: #0f68ff;
  }

  .df-popup__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 344px;
    max-width: 100%;
    height: 78px;
    margin-top: 23px;
    margin-left: 3px;
    border: 1px solid #0f68ff;
    border-radius: 7px;
    background: #fff;
    font-size: 14px;
    font-weight: 500;
    color: #0c1013;
    transition: background-color 0.25s ease;
  }

  .df-popup__submit svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: #0c1013;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  @media (hover: hover) and (pointer: fine) {
    .df-popup__submit:hover {
      background: #f2f6ff;
    }
  }

  /* ===== Мобильные: иконка справа от поля ===== */

  @media (max-width: 640px) {
    .df-popup__card {
      width: 352px;
      padding: 23px 23px 32px;
      border-radius: 25px;
    }

    .df-popup__close {
      right: 25px;
      top: 33px;
      width: 23px;
      height: 23px;
    }

    .df-popup__title {
      min-height: 82px;
      max-width: 292px;
      font-size: 35px;
      line-height: 35px;
    }

    .df-popup__subtitle {
      min-height: 45px;
      max-width: 280px;
      margin-top: 12px;
      font-size: 12px;
      line-height: 19px;
    }

    .df-popup__form {
      margin-top: 11px;
    }

    .df-popup__field {
      width: 100%;
      height: 59px;
      margin-left: 0;
    }

    .df-popup__field + .df-popup__field {
      margin-top: 23px;
    }

    .df-popup__input {
      padding: 26px 38px 10px 0;
      font-size: 12px;
    }

    .df-popup__icon {
      left: auto;
      right: 0;
    }

    .df-popup__input {
      padding-right: 38px;
    }

    .df-popup__consent {
      width: 100%;
      min-height: 29px;
      margin-top: 23px;
      margin-left: 0;
      font-size: 8px;
      line-height: 9.6px;
    }

    .df-popup__submit {
      width: 100%;
      height: 62px;
      margin-top: 43px;
      margin-left: 0;
    }
  }
</style>

<script>
  const popup = document.querySelector<HTMLElement>('[data-popup]');

  if (popup) {
    const card = popup.querySelector<HTMLElement>('.df-popup__card');
    const closeBtn = popup.querySelector<HTMLButtonElement>('[data-popup-close]');

    const setOpen = (open: boolean) => {
      popup.hidden = !open;
      document.body.classList.toggle('df-noscroll', open);

      if (open) {
        popup.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
      }
    };

    /* Попап открывают все ссылки на #zeropopup */
    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement)?.closest?.('a[href*="#zeropopup"]');
      if (!link) return;

      event.preventDefault();
      setOpen(true);
    });

    closeBtn?.addEventListener('click', () => setOpen(false));

    popup.addEventListener('click', (event) => {
      if (!card?.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !popup.hidden) setOpen(false);
    });
  }
</script>
